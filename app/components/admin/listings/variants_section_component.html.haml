%fieldset.card.shadow-sm.border-0
  %legend.card-header.fw-semibold
    %i.bi.bi-grid-3x3-gap.me-2
    Variants
  .card-body.p-4
    - if @listing.variants.any?
      .table-responsive
        %table.table.table-sm.align-middle
          %thead.thead-secondary
            %tr
              %th Combination
              %th.text-end{ style: "width: 120px" } Qty
              %th.text-end{ style: "width: 150px" } Price Override
              %th{ style: "width: 140px" } SKU
              %th{ style: "width: 100px" } Gallery
              %th
          %tbody
            = @form.fields_for :variants do |variant_form|
              :ruby
                row = Admin::Listings::VariantRowComponent.new(
                  variant_form: variant_form,
                  listing: @listing,
                  gallery_representative_id: gallery_representative_id_for(variant_form.object)
                )
              = render row
    - elsif @listing.persisted?
      .text-muted.small
        No variants yet. Save options and values above to generate variants, or
        = link_to admin_listing_variants_path(@listing),
            data: { turbo_method: :post },
            class: "btn btn-sm btn-outline-secondary ms-1" do
          %i.bi.bi-magic.me-1
          Generate from Options
    - else
      .text-muted.small
        Save the listing first to manage variants.
