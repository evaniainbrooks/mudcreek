%tr
  %td
    = @variant_form.hidden_field :_destroy, value: "0"
    .small= @variant.display_name.presence || "—"
  %td.text-end
    = @variant_form.number_field :quantity,
        class: "form-control form-control-sm text-end",
        min: 0, style: "width: 80px; margin-left: auto"
  %td.text-end
    .input-group.input-group-sm{ style: "width: 130px; margin-left: auto" }
      %span.input-group-text= Current.tenant.currency
      = @variant_form.number_field :price_cents,
          class: "form-control text-end",
          placeholder: "—",
          min: 0,
          value: @variant.price_cents
  %td
    = @variant_form.text_field :sku, class: "form-control form-control-sm", placeholder: "—"
  %td
    - if @variant.persisted?
      - if gallery_representative?
        = link_to edit_admin_listing_variant_path(@listing, @variant),
            class: "btn btn-sm #{photo_count > 0 ? 'btn-primary' : 'btn-outline-secondary'}",
            title: "Manage variant gallery" do
          %i.bi.bi-images.me-1
          = photo_count > 0 ? photo_count.to_s : "Gallery"
      - else
        = link_to edit_admin_listing_variant_path(@listing, gallery_representative_variant),
            class: "btn btn-sm btn-outline-secondary",
            title: "Shared gallery" do
          %i.bi.bi-link-45deg.me-1
          Shared
  %td.text-nowrap
    .form-check
      = @variant_form.check_box :_destroy, class: "form-check-input"
      = @variant_form.label :_destroy, "Remove", class: "form-check-label small text-danger"
