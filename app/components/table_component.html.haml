.rounded-3.overflow-hidden.border
  .table-responsive
    %table.table.table-sm.table-hover.table-striped.align-middle.small.mb-0
      %thead.thead-secondary
        %tr
          - @columns.each do |col|
            %th
              - if col.sort_attr && @ransack_query
                = helpers.sort_link(@ransack_query, col.sort_attr, col.header, page: nil)
              - else
                = col.header
      %tbody{id: @tbody_id, data: @tbody_data}
        - if @rows.empty?
          %tr
            %td.text-center.text-muted.py-4{colspan: @columns.size} No records found.
        - else
          - @rows.each do |row|
            %tr{data: { id: row.try(:id) }.merge(@row_data&.call(row) || {}).compact}
              - @columns.each do |col|
                - if col.typed
                  = render(TableCellComponent.new(value: col.block.call(row), html_class: col.html_class))
                - else
                  %td{class: col.html_class}= col.block.call(row)
      - if footer_row
        %tfoot.fw-semibold
          %tr= footer_row.call
