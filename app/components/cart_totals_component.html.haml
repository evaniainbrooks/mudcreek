%tfoot
  %tr.border-top
    %td.ps-3.text-muted Subtotal
    %td
    %td
    %td.text-end.text-muted= helpers.humanized_money_with_symbol(@summary.subtotal)
    %td
  %tr
    %td.ps-3.text-muted
      Tax (#{(SALES_TAX_RATE * 100).to_i}%)
    %td
    %td
    %td.text-end.text-muted= number_to_currency(@summary.tax)
    %td
  - if @delivery_method
    %tr.table-info
      %td.ps-3
        %i.bi.bi-truck.me-1
        = @delivery_method.name
      %td
      %td
      %td.text-end
        = @delivery_method.price_cents.zero? ? "Free" : helpers.humanized_money_with_symbol(@summary.delivery)
      %td
  - if @discount_code
    %tr.table-success
      %td.ps-3
        %i.bi.bi-ticket-perforated.me-1
        = @discount_code.key
        - if @discount_code.percentage?
          = "(#{@discount_code.amount_cents / 100}% off)"
      %td
      %td
      %td.text-end= helpers.humanized_money_with_symbol(-@summary.discount_savings)
      %td
  %tr.border-top.border-2
    %th.ps-3.fs-5 Total
    %th
    %th
    %th.text-end.fs-5= helpers.humanized_money_with_symbol(@summary.total)
    %th
  %tr
    %td{colspan: 5}
      - needs_delivery    = @requires_delivery && !@delivery_method
      - needs_address     = @delivery_method&.address_required? && !@address_saved
      - needs_guest_info  = !@guest_info_saved.nil? && !@guest_info_saved
      - if needs_delivery
        %p.text-muted.small.text-center.mb-1
          %i.bi.bi-truck.me-1
          Select a delivery method to continue
      - elsif needs_address
        %p.text-muted.small.text-center.mb-1
          %i.bi.bi-house-fill.me-1
          Save your delivery address to continue
      - if needs_guest_info
        %p.text-muted.small.text-center.mb-1
          %i.bi.bi-person.me-1
          Provide contact information to continue
      = form_with url: orders_path, method: :post do
        = submit_tag "Place Order",
            class: "btn btn-success w-100 mt-2",
            disabled: needs_delivery || needs_address || needs_guest_info
