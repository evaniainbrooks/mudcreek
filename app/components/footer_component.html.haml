%footer.bg-body-tertiary.border-top.py-5
  .container
    .row.g-0
      .col-lg-4.px-4.py-2.d-flex.flex-column.align-items-center.text-center
        %p.h5.fw-bold.mb-2= tenant.name
        - if tenant.description.present?
          .text-muted.small.mb-3= tenant.description.to_plain_text.truncate(200)
        .d-flex.flex-column.gap-1.align-items-center
          - if tenant.features.auctions?
            = link_to auctions_path, class: "text-decoration-none text-muted small" do
              %i.bi.bi-hammer.me-1
              Auctions
          = link_to listings_path, class: "text-decoration-none text-muted small" do
            %i.bi.bi-tag.me-1
            Listings
          - if Listings::Category.exists?
            = link_to categories_path, class: "text-decoration-none text-muted small" do
              %i.bi.bi-grid.me-1
              Categories
          - footer_navbar_items.each do |item|
            = link_to item.path, class: "text-decoration-none text-muted small" do
              - if item.icon.present?
                %i{ class: "bi #{item.icon} me-1" }
              = item.title
        %small.text-muted.mt-auto.pt-3
          &copy;
          = Date.current.year
          = tenant.name

      .col-lg-4.px-4.py-2.border-start.d-flex.flex-column.align-items-center.text-center
        %p.h5.fw-bold.mb-3 Contact
        .d-flex.flex-column.gap-2.align-items-center
          - if address&.any?
            .d-flex.flex-column.align-items-center.gap-1.text-muted.small
              %i.bi.bi-geo-alt{"style": "font-size: 1.5rem"}
              %address.mb-0.text-center
                - if address.street_address.present?
                  = address.street_address
                  %br/
                - city_line = [ address.city, address.province ].compact_blank.join(", ")
                - city_line += "  #{address.postal_code}" if address.postal_code.present?
                - if city_line.present?
                  = city_line
                  %br/
                - if address.country.present?
                  = country_name(address.country)
          - if tenant.website.present?
            .d-flex.align-items-center.gap-2.text-muted.small
              %i.bi.bi-globe.flex-shrink-0
              - display = tenant.website.delete_prefix("https://").delete_prefix("http://")
              = link_to display, tenant.website, class: "text-decoration-none text-muted", target: "_blank", rel: "noopener"
          - if tenant.email_address.present?
            .d-flex.align-items-center.gap-2.text-muted.small
              %i.bi.bi-envelope.flex-shrink-0
              = mail_to tenant.email_address, tenant.email_address, class: "text-decoration-none text-muted"
          - if tenant.phone_number.present?
            .d-flex.align-items-center.gap-2.text-muted.small
              %i.bi.bi-telephone.flex-shrink-0
              = link_to tenant.phone_number, "tel:#{tenant.phone_number}", class: "text-decoration-none text-muted"

      - if social_media_accounts.any?
        .col-lg-4.px-4.py-2.border-start.d-flex.flex-column.align-items-center.text-center
          %p.h5.fw-bold.mb-3 Follow Us
          .d-flex.flex-wrap.justify-content-center.gap-3
            - social_media_accounts.each do |account|
              = link_to social_media_url(account),
                  class: "text-muted",
                  target: "_blank",
                  rel: "noopener",
                  title: "#{account.platform.humanize}: @#{account.slug}" do
                %i{ class: account.icon, style: "font-size: 2rem" }
          .mt-auto.pt-3.text-center
            %p.fw-semibold.mb-0 Powered by Podium
            %small.text-muted Platform your business.
