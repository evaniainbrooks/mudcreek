!!!
%html{ lang: "en" }
  %head
    %meta{ charset: "utf-8" }
    %meta{ name: "viewport", content: "width=device-width,initial-scale=1" }
    %title= content_for?(:title) ? yield(:title) : "Showroom"
    = csrf_meta_tags
    = csp_meta_tag
    = stylesheet_link_tag :app, "data-turbo-track": "reload"
    %meta{ name: "turbo-refresh-method", content: "morph" }
    :css
      @keyframes showroom-pulse {
        0%, 100% { opacity: 1; transform: scale(1); }
        50% { opacity: 0.35; transform: scale(1.08); }
      }
    = javascript_include_tag "application", "data-turbo-track": "reload", defer: true
  %body{ style: "background: #000; color: #fff; height: 100vh; overflow: hidden; margin: 0" }
    = yield
    :javascript
      setInterval(function() { Turbo.visit(window.location.href, { action: "replace" }); }, 120000);
