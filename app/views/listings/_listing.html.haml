.col
  .card.h-100.shadow-sm.border.border-secondary-subtle
    .position-relative
      - if listing.show_video_as_poster && listing.videos.attached?
        %video.card-img-top.w-100.bg-secondary-subtle{ style: "height: 200px; object-fit: contain",
            muted: true, playsinline: true, preload: "metadata" }
          %source{ src: url_for(listing.videos.first) }
      - elsif listing.images.attached?
        .card-img-top.bg-secondary-subtle{ style: background_image_style(listing.images.first) }
      - elsif listing.videos.attached?
        %video.card-img-top.w-100.bg-secondary-subtle{ style: "height: 200px; object-fit: contain",
            muted: true, playsinline: true, preload: "metadata" }
          %source{ src: url_for(listing.videos.first) }
      - elsif listing.lot&.listing_placeholder&.attached?
        .card-img-top.bg-secondary-subtle{ style: background_image_style(listing.lot.listing_placeholder) }
      - elsif Current.tenant.listing_placeholder.attached?
        .card-img-top.bg-secondary-subtle{ style: background_image_style(Current.tenant.listing_placeholder) }
      - else
        .card-img-top.d-flex.align-items-center.justify-content-center.bg-secondary-subtle{ style: "height: 200px" }
          %i.bi.bi-image.text-secondary{ style: "font-size: 3rem" }
      - if listing.sold?
        .position-absolute.top-0.start-0.p-2
          = listing_state_badge(listing)
      - elsif listing.quantity == 0
        .position-absolute.top-0.start-0.p-2
          %span.badge.text-bg-secondary Out of Stock
      - if listing.negotiable? && !listing.sold?
        .position-absolute.top-0.start-0.p-2
          = listing_pricing_type_badge(listing)
      - if listing.rental?
        .position-absolute.top-0.end-0.p-2
          = listing_type_badge(listing)
      - if listing.lot&.show_attribution?
        .position-absolute.bottom-0.start-0.p-2
          = lot_number_badge(listing.lot)
    .card-body
      %h5.card-title.fw-semibold.mb-1
        = link_to listing.name, listing_path(listing), class: "stretched-link text-decoration-none text-body"
      - if listing.rental?
        - cheapest = listing.rental_rate_plans.min_by(&:price_cents)
        .d-flex.align-items-center.gap-2.mb-0
          - if cheapest
            %p.text-primary.fw-bold.mb-0 From #{humanized_money_with_symbol(cheapest.price)} / #{cheapest.label}
          - else
            %p.text-muted.fw-bold.mb-0 Rental
          = listing_type_badge(listing)
      - else
        - unless listing.sold?
          .d-flex.align-items-center.gap-2.mb-0
            %p.text-primary.fw-bold.mb-0= humanized_money_with_symbol(listing.price)
            - if listing.negotiable?
              = listing_pricing_type_badge(listing)
      %p.card-text.text-muted.small
        = listing.description.to_plain_text.truncate(120)
        - if listing.categories.any?
          %br
          = listing_categories_badges(listing, css: "text-bg-dark")
