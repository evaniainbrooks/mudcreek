:ruby
  description = @listing.description.to_plain_text.truncate(200)
  og_image = @listing.images.attached? ? url_for(@listing.images.first) : nil
  set_meta_tags title: @listing.name,
    description: description,
    og: { title: @listing.name, description: description, image: og_image },
    twitter: { card: (og_image ? "summary_large_image" : "summary"), title: @listing.name, description: description, image: og_image }

  has_images = @listing.images.attached?
  has_videos = @listing.videos.attached?
  media_count = @listing.images.count + @listing.videos.count

= link_to listings_path, class: "btn btn-outline-secondary btn-sm mb-4" do
  %i.bi.bi-arrow-left.me-1
  Back to listings

.row.g-4.g-lg-5.align-items-start
  .col-lg-7
    - if has_images || has_videos
      = render "listings/carousel", listing: @listing, media_count:
    - elsif @listing.lot&.listing_placeholder&.attached?
      = image_tag @listing.lot.listing_placeholder, class: "d-block w-100 rounded-3 object-fit-cover", style: "height: 480px"
    - else
      .rounded-3.bg-light.d-flex.align-items-center.justify-content-center{ style: "height: 480px" }
        %i.bi.bi-image.text-muted{ style: "font-size: 5rem" }
  .col-lg-5
    .position-sticky{ style: "top: 1.5rem" }
      %h1.fw-bold.mb-1= @listing.name
      - if @listing.rental?
        %span.badge.text-bg-info.mb-2 Rental
      - else
        %p.fs-2.text-primary.fw-semibold.mb-2= number_to_currency(@listing.price)
      - unless @listing.sold?
        %p.text-muted.small.mb-4
          - if @listing.quantity == 0
            %span.badge.text-bg-secondary.me-1 Out of Stock
          - else
            %i.bi.bi-box-seam.me-1
            = pluralize(@listing.quantity, "available")
      %hr.mb-4
      - if @listing.rental?
        - if @listing.rental_rate_plans.any?
          %p.fw-semibold.mb-1 Rate Plans
          %table.table.table-sm.mb-3
            %tbody
              - @listing.rental_rate_plans.order(:position).each do |plan|
                %tr
                  %td= plan.label
                  %td.text-end= number_to_currency(plan.price)
        - unless @listing.sold?
          - if Current.user
            %button.btn.btn-primary.w-100{ type: "button", data: { "bs-toggle": "modal", "bs-target": "#rental-modal" } }
              %i.bi.bi-calendar-check.me-2
              Check Availability &amp; Rent
          - else
            = link_to new_session_path, class: "btn btn-outline-primary w-100" do
              Sign in to rent
      - else
        - unless @listing.sold?
          - if Current.user
            - if @cart_item
              = button_to cart_item_path(@cart_item),
                method: :delete,
                class: "btn btn-outline-secondary w-100 mb-3",
                form: { data: { turbo_confirm: "Remove from cart?" } } do
                %i.bi.bi-cart-check.me-2
                In Cart
            - else
              = button_to cart_items_path,
                params: { listing_id: @listing.id },
                class: "btn btn-primary w-100 mb-3" do
                %i.bi.bi-cart-plus.me-2
                Add to Cart
            - if @listing.sale? && @listing.negotiable?
              %button.btn.btn-outline-primary.w-100.mb-4{ type: "button", data: { "bs-toggle": "modal", "bs-target": "#offer-modal" } }
                %i.bi.bi-tag.me-2
                Make an Offer
          - else
            = link_to new_session_path, class: "btn btn-outline-primary w-100 mb-3" do
              %i.bi.bi-cart-plus.me-2
              Sign in to add to cart
            - if @listing.sale? && @listing.negotiable?
              = link_to new_session_path, class: "btn btn-outline-secondary w-100 mb-4" do
                %i.bi.bi-tag.me-2
                Sign in to make an offer
      .listing-description
        = @listing.description
      - if @listing.categories.any?
        .mt-3= listing_categories_badges(@listing, css: "text-bg-dark")

- if @listing.documents.attached?
  %hr.mt-5
  %h2.h5.fw-semibold.mb-3
    %i.bi.bi-folder2-open.me-2
    Documents
  .d-flex.flex-wrap.gap-3
    - @listing.documents.each do |doc|
      = link_to rails_blob_path(doc, disposition: "attachment"), class: "text-decoration-none" do
        .d-flex.flex-column.align-items-center.justify-content-center.border.rounded-3.p-3.bg-body-tertiary{ style: "width: 120px; min-height: 110px" }
          %i.bi.fs-1{ class: [document_icon_class(doc.content_type), "text-secondary"].compact_blank.join(" ") }
          %span.text-center.text-body.small.mt-2.lh-sm{ style: "word-break: break-all; max-width: 96px" }= doc.filename.to_s.truncate(32)

= render("listings/rental_modal", listing: @listing) if @listing.rental? && Current.user && !@cart_item
= render("listings/offer_modal", listing: @listing) if @listing.sale? && @listing.negotiable? && Current.user
