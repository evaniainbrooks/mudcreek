:ruby
  description = @listing.description.to_plain_text.truncate(200)
  og_image = @listing.images.attached? ? url_for(@listing.images.first) : nil
  set_meta_tags title: @listing.name,
    description: description,
    og: { title: @listing.name, description: description, image: og_image },
    twitter: { card: (og_image ? "summary_large_image" : "summary"), title: @listing.name, description: description, image: og_image }

  has_images = @listing.images.attached?
  has_videos = @listing.videos.attached?
  media_count = @listing.images.size + @listing.videos.size

.d-flex.justify-content-between.align-items-center.mb-4
  = link_to listings_path, class: "btn btn-outline-secondary btn-sm", data: { transition: "backward" } do
    %i.bi.bi-arrow-left.me-1
    Back to listings
  .d-flex.gap-2
    - if Current.user&.role&.permissions&.any?
      = link_to admin_listing_path(@listing), class: "btn btn-outline-secondary btn-sm" do
        %i.bi.bi-gear.me-1
        Admin View
    - if @next_listing
      = link_to listing_path(@next_listing), class: "btn btn-outline-secondary btn-sm", data: { transition: "forward" } do
        Next listing
        %i.bi.bi-arrow-right.ms-1
    - if Current.user
      = render "shared/watchlist_button", listing: @listing, watchlist_item: @watchlist_item
    %button.btn.btn-outline-secondary.btn-sm{ type: "button", data: { "bs-toggle": "modal", "bs-target": "#share-modal" } }
      %i.bi.bi-share.me-1
      Share

.page-container.p-4
  .row.g-4.g-lg-5.align-items-start
    .col-lg-7
      - if has_images || has_videos
        = render "listings/carousel", listing: @listing, media_count:
      - elsif @listing.lot&.listing_placeholder&.attached?
        .rounded-3.bg-secondary-subtle{ style: "height: 480px; background-image: url('#{optimized_image_url(@listing.lot.listing_placeholder, preset: :card)}'); background-size: contain; background-position: center; background-repeat: no-repeat" }
      - else
        .rounded-3.bg-light.d-flex.align-items-center.justify-content-center{ style: "height: 480px" }
          %i.bi.bi-image.text-muted{ style: "font-size: 5rem" }
    .col-lg-5
      .position-sticky{ style: "top: 1.5rem" }
        %h1.fw-bold.mb-1= @listing.name
        - if @listing.lot&.show_attribution?
          .mb-2= lot_number_badge(@listing.lot)
        - if @listing.rental?
          %span.badge.text-bg-info.mb-2 Rental
        - else
          %p.fs-2.text-primary.fw-semibold.mb-2= humanized_money_with_symbol(@listing.price)
        - unless @listing.sold?
          %p.text-muted.small.mb-4
            - if @listing.quantity == 0
              %span.badge.text-bg-secondary.me-1 Out of Stock
            - else
              %i.bi.bi-box-seam.me-1
              = pluralize(@listing.quantity, "available")
        %hr.mb-4
        - if @listing.rental?
          - if @listing.rental_rate_plans.any?
            %p.fw-semibold.mb-1 Rate Plans
            %table.table.table-sm.mb-3
              %tbody
                - @listing.rental_rate_plans.order(:position).each do |plan|
                  %tr
                    %td= plan.label
                    %td.text-end= humanized_money_with_symbol(plan.price)
          - unless @listing.sold?
            - if Current.user
              %button.btn.btn-primary.w-100{ type: "button", data: { "bs-toggle": "modal", "bs-target": "#rental-modal" } }
                %i.bi.bi-calendar-check.me-2
                Check Availability &amp; Rent
            - else
              = link_to new_session_path, class: "btn btn-outline-primary w-100" do
                Sign in to rent
        - else
          - unless @listing.sold?
            %div{ id: dom_id(@listing, :cart_action) }
              - if @cart_item
                = button_to cart_item_path(@cart_item),
                  method: :delete,
                  class: "btn btn-outline-secondary w-100 mb-3",
                  form: { data: { turbo_confirm: "Remove from cart?" } } do
                  %i.bi.bi-cart-check.me-2
                  In Cart
              - else
                = form_with url: cart_items_path, method: :post, class: "mb-3" do |f|
                  = f.hidden_field :listing_id, value: @listing.id
                  .d-flex.gap-2
                    - if @listing.quantity > 1
                      = f.number_field :quantity, value: 1, min: 1, max: @listing.quantity, class: "form-control", style: "width: 80px"
                    = f.button class: "btn btn-primary flex-grow-1" do
                      %i.bi.bi-cart-plus.me-2
                      Add to Cart
            - if Current.user && @listing.sale? && @listing.negotiable?
              %button.btn.btn-outline-primary.w-100.mb-4{ type: "button", data: { "bs-toggle": "modal", "bs-target": "#offer-modal" } }
                %i.bi.bi-tag.me-2
                Make an Offer
            - elsif !Current.user && @listing.sale? && @listing.negotiable?
              = link_to new_session_path, class: "btn btn-outline-secondary w-100 mb-4" do
                %i.bi.bi-tag.me-2
                Sign in to make an offer
        .listing-description
          = @listing.description
        - if @listing.categories.any?
          .mt-3= listing_categories_badges(@listing, css: "text-bg-dark")

  = render("listings/properties", listing: @listing)
  = render("listings/documents", listing: @listing)

= render("listings/rental_modal", listing: @listing, booking_events: @booking_events) if @listing.rental? && Current.user
= render("listings/offer_modal", listing: @listing) if @listing.sale? && @listing.negotiable? && Current.user
= render "shared/share_modal", url: listing_url(@listing), title: @listing.name
