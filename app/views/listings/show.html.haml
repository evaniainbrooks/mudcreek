- set_listing_meta_tags(@listing)
.d-flex.flex-nowrap.align-items-center.gap-2.mb-4
  = link_to listings_path, class: "btn btn-outline-secondary btn-sm me-auto", data: { transition: "backward" } do
    %i.bi.bi-arrow-left.me-1
    Back to listings
  - if Current.user&.role&.permissions&.any?
    = link_to admin_listing_path(@listing), class: "btn btn-outline-secondary btn-sm" do
      %i.bi.bi-gear.me-1
      Admin View
  - if @next_listing
    = link_to listing_path(@next_listing),
        class: "btn btn-outline-secondary btn-sm", data: { transition: "forward" } do
      Next listing
      %i.bi.bi-arrow-right.ms-1
  - if Current.user && Current.tenant.features.watchlist?
    = render "shared/watchlist_button", listing: @listing, watchlist_item: @watchlist_item
  %button.btn.btn-outline-secondary.btn-sm{type: "button",
      data: { "bs-toggle": "modal", "bs-target": "#share-modal" }}
    %i.bi.bi-share
    %span.d-none.d-sm-inline.ms-1 Share

.page-container.p-4
  .row.g-4.g-lg-5.align-items-start
    .col-lg-7
      .position-relative
        - if @listing.has_images? || @listing.has_videos?
          = render "listings/carousel", listing: @listing, media_count: @listing.media_count
        - elsif @listing.lot&.listing_placeholder&.attached?
          .rounded-3.bg-secondary-subtle{ style: background_image_style(@listing.lot.listing_placeholder, height: 480) }
        - elsif Current.tenant.listing_placeholder.attached?
          .rounded-3.bg-secondary-subtle{ style: background_image_style(Current.tenant.listing_placeholder, height: 480) }
        - else
          .rounded-3.bg-light.d-flex.align-items-center.justify-content-center{ style: "height: 480px" }
            %i.bi.bi-image.text-muted{ style: "font-size: 5rem" }
        - if @listing.lot&.show_attribution?
          .position-absolute.bottom-0.start-0.p-2
            = lot_number_badge(@listing.lot)
    .col-lg-5
      .position-sticky{ style: "top: 1.5rem" }
        %h1.fw-bold.mb-1= @listing.name
        - if @listing.rental?
          %span.badge.text-bg-info.mb-2 Rental
        - else
          %p.fs-2.text-primary.fw-semibold.mb-2= humanized_money_with_symbol(@listing.price)
        - unless @listing.sold?
          %p.text-muted.small.mb-4
            - if !@listing.unlimited_quantity? && @listing.quantity == 0
              %span.badge.text-bg-secondary.me-1 Out of Stock
            - elsif !@listing.unlimited_quantity?
              %i.bi.bi-box-seam.me-1
              = "#{@listing.quantity} available"
        %hr.mb-4
        - if @listing.rental?
          - if @listing.rental_rate_plans.any?
            %p.fw-semibold.mb-1 Rate Plans
            %table.table.table-sm.mb-3
              %tbody
                - @listing.rental_rate_plans.order(:position).each do |plan|
                  %tr
                    %td= plan.label
                    %td.text-end= humanized_money_with_symbol(plan.price)
          - unless @listing.sold?
            - if Current.user
              %button.btn.btn-primary.w-100{type: "button",
                  data: { "bs-toggle": "modal", "bs-target": "#rental-modal" }}
                %i.bi.bi-calendar-check.me-2
                Check Availability &amp; Rent
            - else
              = link_to new_session_path, class: "btn btn-outline-primary w-100" do
                Sign in to rent
        - else
          - unless @listing.sold?
            %div{ id: dom_id(@listing, :cart_action) }
              - if @cart_item
                = button_to cart_item_path(@cart_item),
                  method: :delete,
                  class: "btn btn-outline-secondary w-100 mb-3",
                  form: { data: { turbo_confirm: "Remove from cart?" } } do
                  %i.bi.bi-cart-check.me-2
                  In Cart
              - else
                = form_with url: cart_items_path, method: :post, class: "mb-3" do |f|
                  = f.hidden_field :listing_id, value: @listing.id
                  - if Current.tenant.features.listing_variants? && @listing.has_variants?
                    - @listing.options.order(:position).each do |option|
                      .mb-2
                        = label_tag "option_values[#{option.id}]", option.name,
                            class: "form-label fw-semibold small"
                        = select_tag "option_values[#{option.id}]",
                            options_for_select(option.option_values.order(:position).map { |v| [v.value, v.id] }),
                            class: "form-select form-select-sm"
                  .d-flex.gap-2
                    - if !@listing.unlimited_quantity? && @listing.quantity > 1 && !(@listing.has_variants? && Current.tenant.features.listing_variants?)
                      = f.number_field :quantity, value: 1, min: 1,
                          max: @listing.quantity, class: "form-control", style: "width: 80px"
                    = f.button class: "btn btn-primary flex-grow-1" do
                      %i.bi.bi-cart-plus.me-2
                      Add to Cart
            - if @listing.sale? && @listing.negotiable?
              %button.btn.btn-outline-primary.w-100.mb-4{type: "button",
                  data: { "bs-toggle": "modal", "bs-target": "#offer-modal" }}
                %i.bi.bi-tag.me-2
                Make an Offer
        .listing-description
          = @listing.description
        - if @listing.categories.any?
          .mt-3= listing_categories_badges(@listing, css: "text-bg-dark")
        - if (addr = @listing.effective_address)&.any?
          .mt-3
            %button.btn.btn-link.p-0.text-muted.text-decoration-underline{ type: "button", data: { "bs-toggle": "modal", "bs-target": "#map-modal" } }
              %i.bi.bi-geo-alt.me-1
              = addr.to_fs(:short)
        - if (lot = @listing.lot)&.show_attribution?
          - other_count = lot.listings.where(published: true).where.not(id: @listing.id).count
          %hr.mt-4.mb-3
          = link_to listings_path(lot_id: lot.hashid),
              class: "d-flex align-items-center gap-3 text-decoration-none text-body p-2 rounded-3 lot-attribution-btn" do
            .rounded-circle.bg-secondary-subtle.d-flex.align-items-center.justify-content-center.flex-shrink-0{ style: "width: 48px; height: 48px" }
              %i.bi.bi-person-fill.text-secondary{ style: "font-size: 1.5rem" }
            .flex-grow-1
              .fw-semibold= lot.name
              .text-muted.small= lot.owner.name
            .d-flex.align-items-center.gap-1.flex-shrink-0
              - if other_count > 0
                %span.small.text-muted See #{other_count} other #{"item".pluralize(other_count)} from this seller
              %i.bi.bi-chevron-right.text-muted

  = render("listings/properties", listing: @listing)
  = render("listings/documents", listing: @listing)

- if (addr = @listing.effective_address)&.any?
  = render "shared/map_modal", address: addr
= render("listings/rental_modal",
    listing: @listing, booking_events: @booking_events) if @listing.rental? && Current.user
= render("listings/offer_modal", listing: @listing) if @listing.sale? && @listing.negotiable?
= render "shared/share_modal", url: listing_url(@listing), title: @listing.name
