.position-relative{ data: { controller: "image-zoom listing-carousel" } }
  - if listing.sold?
    .position-absolute.top-0.start-0.p-3{ style: "z-index: 10" }
      = listing_state_badge(listing, extra_css: "fs-6")
  - if listing.negotiable? && !listing.sold? && !listing.auction_listing
    .position-absolute.top-0.start-0.p-3{ style: "z-index: 10" }
      = listing_pricing_type_badge(listing, extra_css: "fs-6")
  %div{ id: local_assigns.fetch(:carousel_id, "listing-carousel"), class: "carousel slide", data: { bs_ride: "false", "listing-carousel-target": "carousel" } }
    - carousel_id = local_assigns.fetch(:carousel_id, "listing-carousel")
    .carousel-inner{ data: { action: "mousemove->image-zoom#track" } }
      :ruby
        slide = 0
        photos = listing.gallery&.photos || []
        videos = listing.gallery&.videos || []
        images_first = !listing.show_video_as_poster
      - (images_first ? photos : videos).each do |item|
        .carousel-item{ class: slide.zero? ? "active" : "" }
          - if images_first
            = optimized_image_tag item, preset: :carousel_slide,
                class: "d-block w-100 rounded-3 object-fit-contain bg-secondary-subtle", style: "height: 480px"
          - else
            %video.d-block.w-100.rounded-3.bg-secondary-subtle{controls: true,
                style: "height: 480px; object-fit: contain"}
              %source{ src: url_for(item) }
        - slide += 1
      - (images_first ? videos : photos).each do |item|
        .carousel-item{ class: slide.zero? ? "active" : "" }
          - if images_first
            %video.d-block.w-100.rounded-3.bg-secondary-subtle{controls: true,
                style: "height: 480px; object-fit: contain"}
              %source{ src: url_for(item) }
          - else
            = optimized_image_tag item, preset: :carousel_slide,
                class: "d-block w-100 rounded-3 object-fit-contain bg-secondary-subtle", style: "height: 480px"
        - slide += 1
    - if media_count > 1
      %button.carousel-control-prev{ type: "button", data: { bs_target: "##{carousel_id}", bs_slide: "prev" } }
        %span.carousel-control-prev-icon{ aria: { hidden: "true" } }
        %span.visually-hidden Previous
      %button.carousel-control-next{ type: "button", data: { bs_target: "##{carousel_id}", bs_slide: "next" } }
        %span.carousel-control-next-icon{ aria: { hidden: "true" } }
        %span.visually-hidden Next
  .position-absolute.bottom-0.end-0.p-2{ style: "z-index: 10", data: { "listing-carousel-target": "zoomControls" } }
    .d-flex.align-items-center.gap-1
      %span.badge.text-bg-dark.font-monospace.invisible{ data: { image_zoom_target: "level" } } 100%
      %button.btn.btn-sm.btn-dark.opacity-75{type: "button", title: "Zoom out",
          data: { action: "image-zoom#zoomOut" }}
        %i.bi.bi-zoom-out
      %button.btn.btn-sm.btn-dark.opacity-75{ type: "button", title: "Reset", data: { action: "image-zoom#reset" } }
        %i.bi.bi-arrow-counterclockwise
      %button.btn.btn-sm.btn-dark.opacity-75{ type: "button", title: "Zoom in", data: { action: "image-zoom#zoomIn" } }
        %i.bi.bi-zoom-in

- if media_count > 1
  .d-flex.flex-wrap.gap-2.mt-3
    :ruby
      thumb_index = 0
      thumb_photos = listing.gallery&.photos || []
      thumb_videos = listing.gallery&.videos || []
      thumb_images_first = !listing.show_video_as_poster
    - (thumb_images_first ? thumb_photos : thumb_videos).each do |item|
      - if thumb_images_first
        = optimized_image_tag item,
          preset: :carousel_thumb,
          class: "rounded-2 object-fit-cover flex-shrink-0",
          style: "width: 76px; height: 76px; cursor: pointer; outline: 2px solid transparent",
          data: { bs_target: "##{carousel_id}", bs_slide_to: thumb_index }
      - else
        .rounded-2.bg-dark.d-flex.align-items-center.justify-content-center.flex-shrink-0{
          style: "width: 76px; height: 76px; cursor: pointer",
          data: { bs_target: "##{carousel_id}", bs_slide_to: thumb_index }}
          %i.bi.bi-play-circle-fill.text-white.fs-3
      - thumb_index += 1
    - (thumb_images_first ? thumb_videos : thumb_photos).each do |item|
      - if thumb_images_first
        .rounded-2.bg-dark.d-flex.align-items-center.justify-content-center.flex-shrink-0{
          style: "width: 76px; height: 76px; cursor: pointer",
          data: { bs_target: "##{carousel_id}", bs_slide_to: thumb_index }}
          %i.bi.bi-play-circle-fill.text-white.fs-3
      - else
        = optimized_image_tag item,
          preset: :carousel_thumb,
          class: "rounded-2 object-fit-cover flex-shrink-0",
          style: "width: 76px; height: 76px; cursor: pointer; outline: 2px solid transparent",
          data: { bs_target: "##{carousel_id}", bs_slide_to: thumb_index }
      - thumb_index += 1
