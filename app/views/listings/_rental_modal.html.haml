#rental-modal.modal.fade{ tabindex: "-1" }
  .modal-dialog
    .modal-content{ data: { controller: "rental-modal", "rental-modal-rate-plans-value": listing.rental_rate_plans_to_json } }
      .modal-header
        %h5.modal-title
          %i.bi.bi-calendar-check.me-2
          Rent This Equipment
        %button.btn-close{ type: "button", data: { "bs-dismiss": "modal" } }
      = form_with url: cart_items_path, data: { turbo: false } do |f|
        = f.hidden_field :listing_id, value: listing.id
        .modal-body
          .row.g-3.mb-3
            .col-md-6
              = f.label :rental_start_at, "Start", class: "form-label"
              = f.datetime_local_field :rental_start_at, class: "form-control",
                  required: true,
                  data: { "rental-modal-target": "startAt", action: "change->rental-modal#calculate" }
            .col-md-6
              = f.label :rental_end_at, "End", class: "form-label"
              = f.datetime_local_field :rental_end_at, class: "form-control",
                  required: true,
                  data: { "rental-modal-target": "endAt", action: "change->rental-modal#calculate" }
          #rental-price-breakdown{ data: { "rental-modal-target": "breakdown" } }
        .modal-footer
          %button.btn.btn-outline-secondary{ type: "button", data: { "bs-dismiss": "modal" } } Cancel
          = f.submit "Add to Cart", class: "btn btn-primary",
              disabled: true,
              data: { "rental-modal-target": "submit" }
