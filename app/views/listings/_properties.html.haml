- if listing.properties.any?
  %hr.mt-5
  %h2.h5.fw-semibold.mb-3
    %i.bi.bi-list-check.me-2
    Specifications
  .d-flex.flex-wrap{ style: "gap: 2rem 3rem" }
    - listing.properties.order(:position).each do |p|
      .text-center{ style: "min-width: 80px; max-width: 140px" }
        - if p.icon.present?
          %i.bi.d-block.mb-1{ class: p.icon, style: "font-size: 2rem" }
        %div.fw-semibold.text-nowrap= p.name
        %div.small.text-muted= p.value
