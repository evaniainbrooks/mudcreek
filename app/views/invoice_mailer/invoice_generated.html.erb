<p>Hi <%= @user.first_name %>,</p>

<p>
  Your auction results for <strong><%= @auction.name %></strong> are ready.
  You won the following items:
</p>

<table style="width: 100%; border-collapse: collapse;">
  <thead>
    <tr>
      <th style="text-align: left; padding: 6px 0; border-bottom: 1px solid #dee2e6;">Item</th>
      <th style="text-align: right; padding: 6px 0; border-bottom: 1px solid #dee2e6;">Amount</th>
    </tr>
  </thead>
  <tbody>
    <% @invoice.invoice_items.each do |item| %>
      <tr>
        <td style="padding: 6px 0;"><%= item.name %></td>
        <td style="text-align: right; padding: 6px 0;"><%= humanized_money_with_symbol(item.amount) %></td>
      </tr>
    <% end %>
  </tbody>
  <tfoot>
    <tr>
      <td style="padding: 8px 0; border-top: 1px solid #dee2e6;"><strong>Total</strong></td>
      <td style="text-align: right; padding: 8px 0; border-top: 1px solid #dee2e6;"><strong><%= humanized_money_with_symbol(@invoice.total) %></strong></td>
    </tr>
  </tfoot>
</table>

<p style="margin-top: 24px;">
  <%= link_to "View Invoice & Pay", invoice_url(@invoice) %>
</p>
