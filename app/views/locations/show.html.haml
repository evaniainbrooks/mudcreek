- content_for :title, @location.name

:ruby
  styles  = location_showroom_styles(@location)
  qr_url  = qr_redirect_url(@location.qr_code, tenant_key: Current.tenant.key)
  qr      = RQRCode::QRCode.new(qr_url)

%div{data: { controller: "clock" },
     style: "position: fixed; inset: 0; #{styles[:bg]}"}

  - if @location.background.attached? && @location.background.video?
    %video{src: url_for(@location.background),
            autoplay: true, loop: true, muted: true, playsinline: true,
            style: "position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover"}

  %div{ style: "position: absolute; inset: 0; background: rgba(0,0,0,#{@location.background_tint_opacity})" }
  %div{ style: "position: relative; display: flex; flex-direction: column; height: 100%" }

    %div{ style: styles[:top_bar] }
      %div
        - if @location.logo.attached?
          = image_tag @location.logo, style: "max-height: 80px; max-width: 240px; object-fit: contain; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.8))"
      %div{ style: "text-align: center; display: flex; gap: 1.5rem; text-shadow: 0 2px 8px rgba(0,0,0,0.9)" }
        %span{ data: { clock_target: "date" }, style: styles[:clock] }
        %span{ data: { clock_target: "time" }, style: styles[:clock] }
      %div

    %div{ style: styles[:center] }
      %h1{ style: styles[:title] }= @location.name

      %div{ style: "display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 3rem; width: 100%; margin-bottom: -2rem" }
        - if @location.message.present?
          %div{ style: styles[:msg] }
            = @location.message
        - else
          %div

        %div{ style: styles[:qr_box] }
          = raw qr.as_svg(offset: 0, color: "000000", shape_rendering: "crispEdges", module_size: 7)

        - if @today_events.any?
          %div{ style: styles[:events] }
            %div{ style: "font-size: clamp(0.7rem, 1.2vw, 1rem); font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: rgba(255,255,255,0.5); margin-bottom: 0.75rem" } Schedule
            - @today_events.each do |event|
              %div{ style: "margin-bottom: 0.75rem" }
                %div{ style: "font-weight: 600; font-size: clamp(1rem, 1.75vw, 1.5rem)" }= event.summary
                %div{ style: "color: rgba(255,255,255,0.7)" }= event.dtstart.strftime("%-I:%M %p")
                - if event.description.present?
                  %div{ style: "color: rgba(255,255,255,0.55); font-size: 0.9em; margin-top: 0.15rem" }= event.description
        - else
          %div

      %p{ style: styles[:prompt] }
        Please scan the QR code to sign in
