- content_for :title, @location.name

:ruby
  kiosk         = @location.kiosk
  styles        = location_showroom_styles(@location)
  qr_url        = qr_redirect_url(@location.qr_code, tenant_key: Current.tenant.key)
  qr            = RQRCode::QRCode.new(qr_url)
  schedule_style = "font-size: clamp(0.7rem, 1.2vw, 1rem); font-weight: 700; " \
                   "letter-spacing: 0.12em; text-transform: uppercase; " \
                   "color: rgba(255,255,255,0.5); margin-bottom: 0.75rem"

%div{data: { controller: "clock" },
     style: "position: fixed; inset: 0; #{styles[:bg]}"}

  - if kiosk&.backgrounds&.attached?
    %div{id: "location-slideshow",
         data: { controller: "slideshow",
                 "slideshow-timeout-value": kiosk.slide_timeout * 1000,
                 "turbo-permanent": true },
         style: "position: absolute; inset: 0"}
      - kiosk.backgrounds.each_with_index do |bg, i|
        - slide_style = "position: absolute; inset: 0; transition: opacity 1s ease-in-out; opacity: #{i == 0 ? 1 : 0}"
        - if bg.video?
          %video{src: url_for(bg),
                  loop: true, muted: true, playsinline: true,
                  data: { "slideshow-target": "slide" },
                  style: "#{slide_style}; width: 100%; height: 100%; object-fit: cover"}
        - else
          - bg_style = "#{slide_style}; background-image: url(#{url_for(bg)}); background-size: cover; background-position: center"
          %div{data: { "slideshow-target": "slide" }, style: bg_style}

  %div{ style: "position: absolute; inset: 0; background: rgba(0,0,0,#{kiosk&.background_tint_opacity || 0.5})" }
  %div{ style: "position: relative; display: flex; flex-direction: column; height: 100%" }

    %div{ style: styles[:top_bar] }
      %div
        - if kiosk&.logo&.attached?
          = image_tag kiosk.logo, style: "max-height: 120px; max-width: 360px; object-fit: contain; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.8))"
      %div{ style: "text-align: center; display: flex; gap: 1.5rem; text-shadow: 0 2px 8px rgba(0,0,0,0.9)" }
        %span{ data: { clock_target: "date" }, style: styles[:clock] }
        %span{ data: { clock_target: "time" }, style: styles[:clock] }
      %div

    %div{ style: styles[:center] }
      %h1{ style: styles[:title] }= @location.name

      %div{ style: "display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 3rem; width: 100%" }
        - if kiosk&.message&.present?
          %div{ style: styles[:msg] }
            = kiosk.message
        - else
          %div

        %div{ style: styles[:qr_box] }
          = raw qr.as_svg(offset: 0, color: "000000", shape_rendering: "crispEdges", module_size: 7)

        - if @today_events.any?
          %div{ style: styles[:events], data: { controller: "schedule" } }
            %div{ style: schedule_style } Schedule
            / NOW indicator — JS moves this to the correct position between events
            %div{data: { schedule_target: "now" },
                  style: "display: none; align-items: center; gap: 0.5rem; margin: 0.25rem 0 0.75rem; color: #ff6060"}
              %div{ style: "flex: 1; height: 2px; background: #ff6060; border-radius: 1px" }
              %span{ style: "font-size: 0.7em; font-weight: 800; letter-spacing: 0.15em; white-space: nowrap" } NOW
              %div{ style: "flex: 1; height: 2px; background: #ff6060; border-radius: 1px" }
            - @today_events.each do |event|
              - event_minutes = event.dtstart.hour * 60 + event.dtstart.min rescue 0
              %div{style: "display: flex; align-items: baseline; gap: 0.6em; margin-bottom: 0.3rem; white-space: nowrap; overflow: hidden",
                    data: { schedule_target: "event", event_minutes: event_minutes }}
                %span{ style: "color: rgba(255,255,255,0.65); font-size: 0.85em; flex-shrink: 0" }= event.dtstart.strftime("%-I:%M %p")
                %span{ style: "font-weight: 600; font-size: 1.15em; overflow: hidden; text-overflow: ellipsis" }= event.summary
        - else
          %div

    %p{ style: styles[:prompt] }
      Please scan the QR code to sign in
