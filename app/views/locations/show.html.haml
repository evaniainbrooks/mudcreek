- qr = RQRCode::QRCode.new(location_checkin_url(@location, tenant_key: Current.tenant.key))
- bg_style = (@location.background.attached? && !@location.background.video?) ? "background-image: url(#{url_for(@location.background)}); background-size: cover; background-position: center;" : "background: #000;"
- accent = Current.tenant.primary_color.presence || "#4f8ef7"

%div{ data: { controller: "clock" },
      style: "position: fixed; inset: 0; #{bg_style}" }

  - if @location.background.attached? && @location.background.video?
    %video{ src: url_for(@location.background),
            autoplay: true, loop: true, muted: true, playsinline: true,
            style: "position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover" }

  %div{ style: "position: absolute; inset: 0; background: rgba(0,0,0,0.5)" }
  %div{ style: "position: relative; display: flex; flex-direction: column; height: 100%" }

    %div{ style: "padding: 1.5rem 2rem; display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; font-size: clamp(1.5rem, 3vw, 2.5rem); color: rgba(255,255,255,0.6)" }
      %div
        - if @location.logo.attached?
          = image_tag @location.logo, style: "max-height: 80px; max-width: 240px; object-fit: contain; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.8))"
      %div{ style: "text-align: center; display: flex; gap: 1.5rem; text-shadow: 0 2px 8px rgba(0,0,0,0.9)" }
        %span{ data: { clock_target: "date" } }
        %span{ data: { clock_target: "time" } }
      %div

    %div{ style: "flex: 1; display: flex; flex-direction: column; align-items: center; justify-content: center; gap: 2rem; text-align: center; padding: 0 1rem; margin-top: -3rem" }
      %h1{ style: "font-size: clamp(2rem, 5vw, 4rem); font-weight: bold; margin: 0; text-shadow: 0 2px 16px rgba(0,0,0,0.9)" }= @location.name

      %div{ style: "display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 3rem; width: 100%; margin-bottom: -2rem" }
        - if @location.message.present?
          %div{ style: "background: rgba(0,0,0,0.55); backdrop-filter: blur(2px); border-radius: 1rem; padding: 1.25rem 1.5rem; font-size: clamp(1rem, 2vw, 1.75rem); color: #fff; text-align: left; justify-self: end; max-width: 30vw" }
            = @location.message
        - else
          %div

        %div{ style: "background: #fff; padding: 1rem; border-radius: 0.5rem; display: inline-block; line-height: 0; box-shadow: 0 4px 32px rgba(0,0,0,0.8), 0 0 0 4px #{accent}" }
          = raw qr.as_svg(offset: 0, color: "000000", shape_rendering: "crispEdges", module_size: 7)

        - if @today_events.any?
          %div{ style: "background: rgba(0,0,0,0.55); backdrop-filter: blur(2px); border-radius: 1rem; padding: 1.25rem 1.5rem; font-size: clamp(0.85rem, 1.5vw, 1.25rem); color: #fff; text-align: left; justify-self: start; max-width: 30vw" }
            - @today_events.each do |event|
              %div{ style: "margin-bottom: 0.75rem" }
                %div{ style: "font-weight: 600; font-size: clamp(1rem, 1.75vw, 1.5rem)" }= event.summary
                %div{ style: "color: rgba(255,255,255,0.7)" }= event.dtstart.strftime("%-I:%M %p")
                - if event.description.present?
                  %div{ style: "color: rgba(255,255,255,0.55); font-size: 0.9em; margin-top: 0.15rem" }= event.description
        - else
          %div{ style: "font-size: 0.7rem; color: rgba(255,255,255,0.45); text-align: left; justify-self: start; max-width: 30vw; line-height: 1.8; font-family: monospace" }
            %div= "attached: #{@location.calendar_file.attached?}"
            %div= "today: #{Time.zone.today}"
            - if @location.calendar_file.attached?
              - begin
                - require "icalendar"
                - _cals = Icalendar::Calendar.parse(@location.calendar_file.download)
                - _evts = _cals.flat_map(&:events)
                %div= "total_events: #{_evts.size}"
                - _sample = _evts.first
                - if _sample
                  %div= "sample_dtstart: #{_sample.dtstart}"
                  %div= "sample_rrule: #{_sample.rrule.first&.to_ical}"
                  %div= "today_wday: #{Time.zone.today.wday} (0=Sun)"
                  %div= "sample_rrule_freq: #{_sample.rrule.first&.frequency}"
                  %div= "sample_rrule_byday: #{_sample.rrule.first&.by_day.inspect}"
              - rescue => _e
                %div= "parse_error: #{_e.message}"

      %p{ style: "font-size: clamp(1.25rem, 2.5vw, 2rem); color: #fff; font-weight: 500; letter-spacing: 0.02em; margin: 0; text-shadow: 0 2px 10px rgba(0,0,0,0.9)" }
        Please scan the QR code to sign in
