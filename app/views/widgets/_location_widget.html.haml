- location = widget.location
%section
  .d-flex.align-items-start.gap-4
    - if location.logo.attached?
      = optimized_image_tag location.logo, preset: :logo,
          class: "rounded flex-shrink-0", style: "width: 80px; height: 80px; object-fit: contain"
    .flex-grow-1
      %h2.h4.fw-semibold.mb-1= location.name
      - if (addr = location.address)&.any?
        %p.text-muted.mb-0= addr.to_fs(:short)
      - if location.message.present?
        .mt-3= location.message
