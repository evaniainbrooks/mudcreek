- if admin_catalog_nav?
  %li.nav-item.dropdown
    %a.nav-link.dropdown-toggle{href: "#", role: "button", "data-bs-toggle": "dropdown", "aria-expanded": "false"}
      %i.bi.bi-tag-fill.me-1
      Catalog
    %ul.dropdown-menu.dropdown-menu-end
      - if policy(Auction).index?
        %li
          = link_to admin_auctions_path, class: "dropdown-item" do
            %i.bi.bi-hammer.me-1
            Auctions
      - if policy(Listings::Category).index?
        %li
          = link_to admin_listings_categories_path, class: "dropdown-item" do
            %i.bi.bi-tags-fill.me-1
            Categories
      - if policy(Gallery).index?
        %li
          = link_to admin_galleries_path, class: "dropdown-item" do
            %i.bi.bi-images.me-1
            Galleries
      - if policy(Listing).index?
        %li
          = link_to admin_listings_path, class: "dropdown-item" do
            %i.bi.bi-tag-fill.me-1
            Listings
      - if Current.tenant.features.locations? && policy(Location).index?
        %li
          = link_to admin_locations_path, class: "dropdown-item" do
            %i.bi.bi-geo-alt-fill.me-1
            Locations
      - if policy(Lot).index?
        %li
          = link_to admin_lots_path, class: "dropdown-item" do
            %i.bi.bi-map-fill.me-1
            Lots
      - if policy(Listings::PropertySet).index?
        %li
          = link_to admin_listings_property_sets_path, class: "dropdown-item" do
            %i.bi.bi-list-columns.me-1
            Property Sets
      - if policy(QrCode).index?
        %li
          = link_to admin_qr_codes_path, class: "dropdown-item" do
            %i.bi.bi-qr-code.me-1
            QR Codes
      - if policy(AuctionRegistration).index?
        %li
          = link_to admin_auction_registrations_path, class: "dropdown-item" do
            %i.bi.bi-person-check.me-1
            Registrations
- if admin_sales_nav?
