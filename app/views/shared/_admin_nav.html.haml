- admin_nav_sections.each do |section|
  %li.nav-item.dropdown
    %a.nav-link.dropdown-toggle{href: "#", role: "button", "data-bs-toggle": "dropdown", "aria-expanded": "false"}
      %i.bi{class: "#{section[:icon]} me-1"}
      = section[:title]
    %ul.dropdown-menu.dropdown-menu-end
      - section[:links].each do |item|
        %li
          = link_to item[:path], class: "dropdown-item" do
            %i.bi{class: "#{item[:icon]} me-1"}
            = item[:label]
