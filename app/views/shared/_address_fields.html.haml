- col = local_assigns.fetch(:col, "col-sm-6")
.mb-3
  = af.label :street_address, "Street Address", class: "form-label"
  = af.text_field :street_address, class: "form-control", placeholder: "Street address"
.row.g-3.mb-3
  %div{ class: col }
    = af.label :city, "City", class: "form-label"
    = af.text_field :city, class: "form-control"
  %div{ class: col }
    = af.label :province, "Province / State", class: "form-label"
    = af.text_field :province, class: "form-control"
.row.g-3.mb-0
  %div{ class: col }
    = af.label :postal_code, "Postal / ZIP Code", class: "form-label"
    = af.text_field :postal_code, class: "form-control"
  %div{ class: col }
    = af.label :country, "Country", class: "form-label"
    = af.select :country, all_countries, { include_blank: "— Select country —" }, class: "form-select"
