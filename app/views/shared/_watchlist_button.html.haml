%span{ id: "watchlist_button_listing_#{listing.id}", style: "display: contents" }
  - if watchlist_item
    = button_to watchlist_item_path(watchlist_item), method: :delete,
        class: "btn btn-warning btn-sm",
        data: { bs_toggle: "offcanvas", bs_target: "#watchlist-offcanvas" } do
      %i.bi.bi-bookmark-fill
      %span.d-none.d-sm-inline.ms-1 Watching
  - else
    = button_to watchlist_items_path, method: :post,
        params: { listing_id: listing.id },
        class: "btn btn-outline-secondary btn-sm",
        data: { bs_toggle: "offcanvas", bs_target: "#watchlist-offcanvas" } do
      %i.bi.bi-bookmark
      %span.d-none.d-sm-inline.ms-1 Watch
