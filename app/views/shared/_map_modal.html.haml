#map-modal.modal.fade{ tabindex: "-1", aria: { labelledby: "map-modal-label", hidden: "true" } }
  .modal-dialog.modal-lg
    .modal-content
      .modal-header
        %h5.modal-title#map-modal-label
          %i.bi.bi-geo-alt.me-2
          = address.to_fs(:short)
        %button.btn-close{ type: "button", data: { "bs-dismiss": "modal" }, aria: { label: "Close" } }
      .modal-body.p-0
        %iframe{
          src: google_maps_embed_url(address),
          width: "100%",
          height: "400",
          style: "border: 0",
          allowfullscreen: true,
          loading: "lazy",
          referrerpolicy: "no-referrer-when-downgrade"
        }
