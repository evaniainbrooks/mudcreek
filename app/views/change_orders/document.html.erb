<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Change Order <%= @change_order.number %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 14px; color: #212529; padding: 40px; }
    .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px; }
    .company-name { font-size: 22px; font-weight: 700; }
    .doc-title { text-align: right; }
    .doc-title h1 { font-size: 28px; font-weight: 300; color: #6c757d; }
    .doc-title .number { font-size: 14px; color: #6c757d; }
    .parties { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-bottom: 32px; }
    .section-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #6c757d; margin-bottom: 6px; }
    .address-block p { line-height: 1.6; }
    .meta-row { display: flex; gap: 32px; margin-bottom: 32px; padding-bottom: 16px; border-bottom: 2px solid #212529; }
    .meta-item .label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #6c757d; }
    .meta-item .value { font-weight: 600; }
    .amount-box { background: #f8f9fa; border-left: 4px solid #212529; padding: 16px 20px; margin-bottom: 24px; display: flex; justify-content: space-between; align-items: center; }
    .amount-box .label { font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; color: #6c757d; }
    .amount-box .value { font-size: 22px; font-weight: 700; }
    .signature-block { margin-top: 48px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
    .sig-line { border-top: 1px solid #212529; padding-top: 6px; font-size: 11px; color: #6c757d; }
  </style>
</head>
<body>
  <div class="header">
    <div>
      <div class="company-name"><%= Current.tenant&.name %></div>
    </div>
    <div class="doc-title">
      <h1>Change Order</h1>
      <div class="number"><%= @change_order.number %></div>
    </div>
  </div>

  <div class="parties">
    <div class="address-block">
      <div class="section-label">Prepared by</div>
      <p>
        <%= Current.tenant&.name %><br>
        <% if Current.tenant&.address %>
          <%= Current.tenant.address.street_address %><br>
          <%= [ Current.tenant.address.city, Current.tenant.address.province, Current.tenant.address.postal_code ].compact.join(", ") %>
        <% end %>
        <% if Current.tenant&.phone_number.present? %>
          <br><%= Current.tenant.phone_number %>
        <% end %>
        <% if Current.tenant&.email_address.present? %>
          <br><%= Current.tenant.email_address %>
        <% end %>
      </p>
    </div>
    <div class="address-block">
      <div class="section-label">Prepared for</div>
      <p>
        <%= @work_order.client_display_name %><br>
        <% if @work_order.client_contact_email.present? %>
          <%= @work_order.client_contact_email %><br>
        <% end %>
        <% if @work_order.client_phone.present? %>
          <%= @work_order.client_phone %>
        <% end %>
      </p>
    </div>
  </div>

  <div class="meta-row">
    <div class="meta-item">
      <div class="label">Date</div>
      <div class="value"><%= Date.today.to_fs(:long) %></div>
    </div>
    <div class="meta-item">
      <div class="label">Change Order</div>
      <div class="value"><%= @change_order.number %></div>
    </div>
    <div class="meta-item">
      <div class="label">Work Order</div>
      <div class="value"><%= @work_order.number %></div>
    </div>
  </div>

  <h2 style="font-size:16px; font-weight:600; margin-bottom:16px;"><%= @work_order.title %></h2>

  <div style="margin-bottom:24px;">
    <div class="section-label" style="margin-bottom:8px;">Description of Change</div>
    <p style="line-height:1.6;"><%= @change_order.description %></p>
  </div>

  <div class="amount-box">
    <span class="label">Change Order Amount</span>
    <span class="value"><%= humanized_money_with_symbol(@change_order.amount) %></span>
  </div>

  <div class="signature-block">
    <div>
      <div style="height:48px;"></div>
      <div class="sig-line">Client Signature &amp; Date</div>
    </div>
    <div>
      <div style="height:48px;"></div>
      <div class="sig-line">Authorized Signature &amp; Date</div>
    </div>
  </div>
</body>
</html>
