<!DOCTYPE html>
<html>
<head>
  <meta charset="utf-8">
  <title>Estimate <%= @work_order.number %></title>
  <style>
    * { box-sizing: border-box; margin: 0; padding: 0; }
    body { font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif; font-size: 14px; color: #212529; padding: 40px; }
    .header { display: flex; justify-content: space-between; align-items: flex-start; margin-bottom: 40px; }
    .company-name { font-size: 22px; font-weight: 700; }
    .doc-title { text-align: right; }
    .doc-title h1 { font-size: 28px; font-weight: 300; color: #6c757d; }
    .doc-title .number { font-size: 14px; color: #6c757d; }
    .parties { display: grid; grid-template-columns: 1fr 1fr; gap: 32px; margin-bottom: 32px; }
    .section-label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #6c757d; margin-bottom: 6px; }
    .address-block p { line-height: 1.6; }
    .meta-row { display: flex; gap: 32px; margin-bottom: 32px; padding-bottom: 16px; border-bottom: 2px solid #212529; }
    .meta-item { }
    .meta-item .label { font-size: 11px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.08em; color: #6c757d; }
    .meta-item .value { font-weight: 600; }
    table { width: 100%; border-collapse: collapse; margin-bottom: 24px; }
    thead th { padding: 8px 12px; background: #f8f9fa; font-size: 12px; font-weight: 600; text-transform: uppercase; letter-spacing: 0.05em; border-bottom: 1px solid #dee2e6; }
    tbody td { padding: 10px 12px; border-bottom: 1px solid #f0f0f0; vertical-align: top; }
    tfoot td { padding: 10px 12px; font-weight: 700; border-top: 2px solid #212529; }
    .text-right { text-align: right; }
    .text-center { text-align: center; }
    .totals { display: flex; justify-content: flex-end; margin-bottom: 32px; }
    .totals table { width: 280px; }
    .terms { margin-top: 32px; padding-top: 16px; border-top: 1px solid #dee2e6; font-size: 12px; color: #6c757d; }
    .terms h3 { font-size: 13px; font-weight: 600; color: #212529; margin-bottom: 8px; }
    .signature-block { margin-top: 48px; display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
    .sig-line { border-top: 1px solid #212529; padding-top: 6px; font-size: 11px; color: #6c757d; }
  </style>
</head>
<body>
  <div class="header">
    <div>
      <div class="company-name"><%= Current.tenant&.name %></div>
    </div>
    <div class="doc-title">
      <h1>Estimate</h1>
      <div class="number"><%= @work_order.number %></div>
    </div>
  </div>

  <div class="parties">
    <div class="address-block">
      <div class="section-label">Prepared by</div>
      <p>
        <%= Current.tenant&.name %><br>
        <% if Current.tenant&.address %>
          <%= Current.tenant.address.street_address %><br>
          <%= [Current.tenant.address.city, Current.tenant.address.province, Current.tenant.address.postal_code].compact.join(", ") %>
        <% end %>
        <% if Current.tenant&.phone_number.present? %>
          <br><%= Current.tenant.phone_number %>
        <% end %>
        <% if Current.tenant&.email_address.present? %>
          <br><%= Current.tenant.email_address %>
        <% end %>
      </p>
    </div>
    <div class="address-block">
      <div class="section-label">Prepared for</div>
      <p>
        <%= @work_order.client_display_name %><br>
        <% if @work_order.client_contact_email.present? %>
          <%= @work_order.client_contact_email %><br>
        <% end %>
        <% if @work_order.client_phone.present? %>
          <%= @work_order.client_phone %>
        <% end %>
      </p>
    </div>
  </div>

  <% if @work_order.address %>
    <div class="address-block" style="margin-bottom:24px;">
      <div class="section-label">Property / Job Site</div>
      <p>
        <%= @work_order.address.street_address %><br>
        <%= [@work_order.address.city, @work_order.address.province, @work_order.address.postal_code].compact.join(", ") %>
      </p>
    </div>
  <% end %>

  <div class="meta-row">
    <div class="meta-item">
      <div class="label">Date</div>
      <div class="value"><%= Date.today.to_fs(:long) %></div>
    </div>
    <div class="meta-item">
      <div class="label">Reference</div>
      <div class="value"><%= @work_order.number %></div>
    </div>
  </div>

  <h2 style="font-size:16px; font-weight:600; margin-bottom:16px;"><%= @work_order.title %></h2>

  <% if @work_order.description.present? %>
    <p style="margin-bottom:16px; color:#6c757d;"><%= @work_order.description %></p>
  <% end %>

  <table>
    <thead>
      <tr>
        <th>Description</th>
        <th class="text-center" style="width:80px;">Qty</th>
        <th class="text-right" style="width:120px;">Unit Price</th>
        <th class="text-right" style="width:120px;">Amount</th>
      </tr>
    </thead>
    <tbody>
      <% @work_order.work_order_items.each do |item| %>
        <tr>
          <td>
            <%= item.name %>
            <% if item.description.present? %>
              <div style="font-size:12px; color:#6c757d; margin-top:2px;"><%= item.description %></div>
            <% end %>
          </td>
          <td class="text-center"><%= item.quantity %></td>
          <td class="text-right"><%= humanized_money_with_symbol(item.unit_price) %></td>
          <td class="text-right"><%= humanized_money_with_symbol(item.line_total) %></td>
        </tr>
      <% end %>
    </tbody>
    <tfoot>
      <tr>
        <td colspan="3">Total</td>
        <td class="text-right"><%= humanized_money_with_symbol(@work_order.total) %></td>
      </tr>
    </tfoot>
  </table>

  <% if @work_order.work_order_milestones.any? %>
    <h3 style="font-size:14px; font-weight:600; margin-bottom:12px;">Payment Schedule</h3>
    <table>
      <thead>
        <tr>
          <th>Milestone</th>
          <th class="text-right" style="width:80px;">%</th>
          <th class="text-right" style="width:120px;">Amount</th>
        </tr>
      </thead>
      <tbody>
        <% @work_order.work_order_milestones.each do |m| %>
          <tr>
            <td><%= m.name %></td>
            <td class="text-right"><%= m.percentage %>%</td>
            <td class="text-right"><%= humanized_money_with_symbol(m.prospective_amount(@work_order)) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>

  <div class="terms">
    <h3>Terms &amp; Conditions</h3>
    <% if Current.tenant&.default_terms_and_conditions&.attached? %>
      <p>Please refer to the attached terms and conditions document.</p>
    <% else %>
      <p>This estimate is valid for 30 days from the date above. Work commences upon receipt of signed contract and deposit. Final invoice is due upon completion. All prices are in <%= @work_order.currency %>.</p>
    <% end %>
  </div>

  <div class="signature-block">
    <div>
      <div style="height:48px;"></div>
      <div class="sig-line">Client Signature &amp; Date</div>
    </div>
    <div>
      <div style="height:48px;"></div>
      <div class="sig-line">Authorized Signature &amp; Date</div>
    </div>
  </div>
</body>
</html>
