- set_meta_tags title: "My Profile"

%h1.fw-bold.mb-4 My Profile

%ul.nav.nav-tabs.mb-4
  %li.nav-item
    %a.nav-link.active{ href: "#profile", data: { "bs-toggle": "tab" } }
      %i.bi.bi-person-fill.me-2
      Profile
  %li.nav-item
    %a.nav-link{ href: "#orders", data: { "bs-toggle": "tab" } }
      %i.bi.bi-bag.me-2
      Orders
      - if @orders.present?
        %span.badge.text-bg-secondary.ms-1= @orders.size
  %li.nav-item
    %a.nav-link{ href: "#invoices", data: { "bs-toggle": "tab" } }
      %i.bi.bi-receipt.me-2
      Invoices
      - if @invoices.present?
        %span.badge.text-bg-secondary.ms-1= @invoices.size
  %li.nav-item
    %a.nav-link{ href: "#auctions", data: { "bs-toggle": "tab" } }
      %i.bi.bi-hammer.me-2
      Auctions
      - if @pagy_registrations.count > 0
        %span.badge.text-bg-secondary.ms-1= @pagy_registrations.count
  %li.nav-item
    %a.nav-link{ href: "#listings", data: { "bs-toggle": "tab" } }
      %i.bi.bi-tag.me-2
      Listings
      - if @pagy_listings.count > 0
        %span.badge.text-bg-secondary.ms-1= @pagy_listings.count

.tab-content
  .tab-pane.fade.show.active#profile
    = form_with model: @user, url: profile_path, method: :patch do |f|
      - if @user.errors.any?
        .alert.alert-danger
          %ul.mb-0
            - @user.errors.full_messages.each do |msg|
              %li= msg
      .row.g-4
        .col-12.col-lg-6
          .card.shadow-sm.border-0
            .card-body.p-4
              %h2.card-title.h5.mb-4
                %i.bi.bi-person-fill.me-2
                Personal Information
              .mb-3
                = f.label :first_name, "First name", class: "form-label"
                = f.text_field :first_name, required: true, autocomplete: "given-name", class: "form-control"
              .mb-3
                = f.label :last_name, "Last name", class: "form-label"
                = f.text_field :last_name, required: true, autocomplete: "family-name", class: "form-control"
              .mb-3
                = f.label :email_address, "Email address", class: "form-label"
                = f.email_field :email_address, disabled: true, autocomplete: "username", class: "form-control"
                %p.form-text Email address cannot be changed here.
        .col-12.col-lg-6
          .card.shadow-sm.border-0
            .card-body.p-4
              %h2.card-title.h5.mb-4
                %i.bi.bi-house-fill.me-2
                Delivery Address
              = f.fields_for :address do |addr|
                - current_country = ISO3166::Country[addr.object.country]
                - initial_subdivisions = current_country&.subdivisions&.values&.map(&:name)&.compact&.sort || []
                %div{ data: { controller: "address" } }
                  .mb-3
                    = addr.label :street_address, "Street address", class: "form-label"
                    = addr.text_field :street_address, autocomplete: "street-address", placeholder: "123 Main St", class: "form-control"
                  .mb-3
                    = addr.label :city, "City", class: "form-label"
                    = addr.text_field :city, autocomplete: "address-level2", class: "form-control"
                  .mb-3
                    = addr.label :country, "Country", class: "form-label"
                    = addr.select :country, all_countries,
                        { include_blank: "Select country…" },
                        class: "form-select",
                        data: { address_target: "country", action: "change->address#countryChanged" }
                  .mb-3{hidden: initial_subdivisions.empty?, data: { address_target: "subdivisionWrapper" }}
                    = addr.label :province, "Province / State", class: "form-label"
                    = addr.select :province, initial_subdivisions,
                        { include_blank: "Select…", selected: addr.object.province },
                        class: "form-select",
                        data: { address_target: "subdivision" }
                  .mb-3
                    = addr.label :postal_code, "Postal code", class: "form-label"
                    = addr.text_field :postal_code, autocomplete: "postal-code", placeholder: "A1A 1A1", class: "form-control"
      .d-flex.justify-content-end.mt-4
        = f.submit "Save changes", class: "btn btn-primary px-4"

  .tab-pane.fade#invoices
    - if @invoices.blank?
      = render EmptyStateComponent.new(icon: "receipt",
          message: "You have no invoices yet.",
          link_text: "Browse Auctions",
          link_url: auctions_path)
    - else
      .card.shadow-sm.border-0
        .card-body.p-0
          .table-responsive
            %table.table.align-middle.mb-0
              %thead
                %tr
                  %th.ps-3 Invoice
                  %th Auction
                  %th Date
                  %th Status
                  %th.text-end Total
                  %th
              %tbody
                - @invoices.each do |invoice|
                  %tr
                    %td.ps-3
                      = link_to invoice.number, invoice_path(invoice), class: "fw-semibold text-decoration-none"
                    %td.text-muted= invoice.auction&.name || invoice.offer&.listing&.name
                    %td.text-muted= invoice.created_at.to_fs(:long)
                    %td
                      - if invoice.paid?
                        %span.badge.text-bg-success Paid
                      - else
                        %span.badge.text-bg-warning.text-dark Unpaid
                    %td.text-end= humanized_money_with_symbol(invoice.total)
                    %td.pe-3
                      - unless invoice.paid?
                        = button_to pay_invoice_path(invoice),
                            method: :post,
                            class: "btn btn-sm btn-primary",
                            form: { data: { turbo_confirm: "Paying this invoice will clear your current cart. Continue?" } } do
                          %i.bi.bi-credit-card.me-1
                          Pay

  .tab-pane.fade#orders
    - if @orders.blank?
      = render EmptyStateComponent.new(icon: "bag-x",
          message: "You haven't placed any orders yet.",
          link_text: "Browse Listings",
          link_url: listings_path)
    - else
      .card.shadow-sm.border-0
        .card-body.p-0
          .table-responsive
            %table.table.align-middle.mb-0
              %thead
                %tr
                  %th.ps-3 Order
                  %th Date
                  %th Status
                  %th.text-end.pe-3 Total
              %tbody
                - @orders.each do |order|
                  %tr
                    %td.ps-3
                      = link_to order.number, order_path(order), class: "fw-semibold text-decoration-none"
                      %small.text-muted.ms-2= pluralize(order.order_items.size, "item")
                    %td.text-muted= order.created_at.to_fs(:long)
                    %td
                      = order_status_badge(order)
                    %td.text-end.pe-3= humanized_money_with_symbol(order.total)

  .tab-pane.fade#auctions
    - if @bid_registrations.empty?
      = render EmptyStateComponent.new(icon: "hammer",
          message: "You haven't placed any bids yet.",
          link_text: "Browse Auctions",
          link_url: auctions_path)
    - else
      %div{ data: { controller: "infinite-scroll" } }
        .card.shadow-sm.border-0
          .card-body.p-0
            .table-responsive
              %table.table.align-middle.mb-0
                %thead
                  %tr
                    %th.ps-3 Auction
                    %th Ends
                    %th
                %tbody#bid-registrations
                  = render partial: "profiles/bid_registration", collection: @bid_registrations, as: :registration
        = render "profiles/bid_registrations_sentinel", pagy: @pagy_registrations

  .tab-pane.fade#listings
    - if @purchased_listings.empty?
      = render EmptyStateComponent.new(icon: "tag",
          message: "You haven't purchased any listings yet.",
          link_text: "Browse Listings",
          link_url: listings_path)
    - else
      %div{ data: { controller: "infinite-scroll" } }
        .card.shadow-sm.border-0
          .card-body.p-0
            .table-responsive
              %table.table.align-middle.mb-0
                %thead
                  %tr
                    %th.ps-3 Listing
                    %th Price
                %tbody#purchased-listings
                  = render partial: "profiles/purchased_listing", collection: @purchased_listings, as: :listing
        = render "profiles/purchased_listings_sentinel", pagy: @pagy_listings
