- content_for :title, "Check In – #{@location.name}"

:ruby
  kiosk = @location.kiosk
  first_bg = kiosk&.backgrounds&.attachments&.first
  has_image_bg = first_bg && !first_bg.blob.video?

.checkin-page
  - if has_image_bg
    .checkin-backdrop{ style: "background-image: url(#{url_for(first_bg)})" }
  .checkin-overlay

  .checkin-content
    .checkin-card
      - if kiosk&.logo&.attached?
        = image_tag kiosk.logo, class: "checkin-logo", alt: @location.name
      %h1.checkin-location= @location.name

      - if @check_in.persisted? || @guest_checked_in
        .checkin-success
          %i.bi.bi-check-circle-fill.checkin-success-icon
          %h2.checkin-success-heading Checked in!
          %p.checkin-welcome
            - if Current.user
              Welcome, #{Current.user.first_name}!
            - elsif @guest_checked_in
              Welcome, #{@guest_checked_in}!

        - if @today_schedule_events.any?
          %p.checkin-event-prompt What are you here for?
          .checkin-events
            - @today_schedule_events.each do |event|
              :ruby
                t_start = event.all_day? ? nil : (event.dtstart.strftime("%-I:%M %p") rescue nil)
                t_end   = event.all_day? ? nil : (event.dtend&.strftime("%-I:%M %p") rescue nil)
              = button_to location_checkin_path(@location), method: :patch,
                  params: { schedule_event_id: event.id },
                  class: "checkin-event-btn", data: { turbo: false } do
                .checkin-event-btn-name= event.summary
                - if t_start
                  .checkin-event-btn-time= t_end ? "#{t_start} – #{t_end}" : t_start
          - next_url = @guest_checked_in ? guest_prompt_location_checkin_path(@location) : exit_url
          = link_to next_url, class: "checkin-skip-link mt-3 d-block" do
            Skip
        - else
          - if @guest_checked_in
            = link_to guest_prompt_location_checkin_path(@location), class: "btn btn-lg w-100 checkin-close-btn mt-2" do
              Next
          - else
            = link_to exit_url, class: "btn btn-lg w-100 checkin-close-btn mt-2", allow_other_host: true do
              Done
      - else
        - if @check_in.errors.any?
          .alert.alert-danger.text-start.mb-3= @check_in.errors.full_messages.to_sentence
        = render "form", location: @location, check_in: @check_in, guest_names: @guest_names.to_a
