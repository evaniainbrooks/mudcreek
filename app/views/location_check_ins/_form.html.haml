%p.checkin-hint Check in as a guest, or sign in for a faster experience.

= form_with model: check_in, url: location_checkin_path(location), method: :post do |f|
  .mb-3
    = f.text_field :guest_name, class: "form-control form-control-lg checkin-input",
        required: true, autofocus: true, placeholder: "Your name",
        autocomplete: "name", inputmode: "text"
  = f.submit "Check In", class: "btn btn-lg w-100 checkin-submit-btn"

= link_to new_session_path, class: "checkin-signin-link mt-3 d-block" do
  %i.bi.bi-person-fill.me-1
  Sign in instead
