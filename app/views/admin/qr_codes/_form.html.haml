= form_with model: [:admin, qr_code], class: "needs-validation" do |f|
  - if qr_code.errors.any?
    .alert.alert-danger.mb-4
      %h5.alert-heading
        %i.bi.bi-exclamation-triangle-fill.me-2
        = pluralize(qr_code.errors.count, "error")
        prohibited this QR code from being saved:
      %ul.mb-0
        - qr_code.errors.full_messages.each do |message|
          %li= message

  - if location_qr_code
    .alert.alert-info.d-flex.align-items-center.gap-2.mb-4
      %i.bi.bi-geo-alt-fill
      This QR code is managed by a location. Only the Admin section can be edited.
      = link_to "View Location", admin_location_path(qr_code.location), class: "ms-auto btn btn-sm btn-outline-primary"

  .row.g-4
    .col-lg-8
      - unless location_qr_code
        %fieldset.card.shadow-sm.border-0.mb-4
          %legend.card-header.fw-semibold
            %i.bi.bi-info-circle.me-1
            Details
          .card-body.p-4
            .mb-3
              = f.label :name, class: "form-label required"
              = f.text_field :name, class: "form-control #{'is-invalid' if qr_code.errors[:name].any?}", required: true
              - if qr_code.errors[:name].any?
                .invalid-feedback= qr_code.errors[:name].to_sentence
            .mb-3
              = f.label :slug, class: "form-label required"
              = f.text_field :slug,
                  class: "form-control #{'is-invalid' if qr_code.errors[:slug].any?}",
                  placeholder: "auto-derived from name on create"
              - if qr_code.errors[:slug].any?
                .invalid-feedback= qr_code.errors[:slug].to_sentence
              %small.text-muted Lowercase letters, numbers, and hyphens only. Used in the public redirect URL.
            .mb-3
              = f.label :destination_url, "Destination URL", class: "form-label required"
              = f.url_field :destination_url,
                  class: "form-control #{'is-invalid' if qr_code.errors[:destination_url].any?}",
                  required: true,
                  placeholder: "https://example.com"
              - if qr_code.errors[:destination_url].any?
                .invalid-feedback= qr_code.errors[:destination_url].to_sentence
            .mb-3
              = f.label :inactive_url, "Fallback URL (optional)", class: "form-label"
              = f.url_field :inactive_url,
                  class: "form-control #{'is-invalid' if qr_code.errors[:inactive_url].any?}",
                  placeholder: "https://example.com"
              - if qr_code.errors[:inactive_url].any?
                .invalid-feedback= qr_code.errors[:inactive_url].to_sentence
              %small.text-muted When inactive or expired, redirect here instead of the homepage.

      %fieldset.card.shadow-sm.border-0
        %legend.card-header.fw-semibold
          %i.bi.bi-person-lock.me-1
          Admin
        .card-body.p-4
          .mb-3
            = f.label :notify_user_id, "Scan notification", class: "form-label"
            = f.select :notify_user_id,
                options_from_collection_for_select(users, :id, :name, qr_code.notify_user_id),
                { include_blank: "— none —" },
                class: "form-select"
            .form-text An email will be sent to this user each time the QR code is scanned.
          .mb-0
            = f.label :notes, class: "form-label"
            = f.text_area :notes,
                class: "form-control #{'is-invalid' if qr_code.errors[:notes].any?}",
                rows: 3
            - if qr_code.errors[:notes].any?
              .invalid-feedback= qr_code.errors[:notes].to_sentence

    - unless location_qr_code
      .col-lg-4
        %fieldset.card.shadow-sm.border-0
          %legend.card-header.fw-semibold
            %i.bi.bi-toggles.me-1
            Settings
          .card-body.p-4
            .mb-3.form-check
              = f.check_box :active, class: "form-check-input"
              = f.label :active, "Active", class: "form-check-label"
            .mb-0
              = f.label :expires_at, "Expiry date (optional)", class: "form-label"
              = f.datetime_local_field :expires_at,
                  class: "form-control #{'is-invalid' if qr_code.errors[:expires_at].any?}"
              - if qr_code.errors[:expires_at].any?
                .invalid-feedback= qr_code.errors[:expires_at].to_sentence
              %small.text-muted Leave blank for no expiry.

  .d-flex.gap-2.mt-4
    = f.submit class: "btn btn-primary"
    = link_to "Cancel", admin_qr_codes_path, class: "btn btn-outline-secondary"
