.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-qr-code.me-2
    QR Codes
  = link_to new_admin_qr_code_path, class: "btn btn-primary" do
    %i.bi.bi-plus-lg.me-1
    New QR Code

.page-container.p-4
  = render_qr_codes_table(qr_codes: @qr_codes)
  - if @pagy.next
    .d-flex.justify-content-end.mt-3
      = link_to admin_qr_codes_path(page: @pagy.next), class: "btn btn-outline-secondary btn-sm" do
        Next
        %i.bi.bi-chevron-right
