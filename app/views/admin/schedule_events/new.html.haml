.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-calendar-plus.me-2
    New Event
  %small.text-muted #{@location.name} / #{@schedule.name.presence || 'Schedule'}

.page-container.p-4
  .card.shadow-sm.border-0
    .card-body.p-4
      - if @event.errors.any?
        .alert.alert-danger.mb-4
          %ul.mb-0
            - @event.errors.full_messages.each do |msg|
              %li= msg

      = form_with model: [:admin, @location, @schedule, @event] do |f|
        .row.g-3
          .col-12
            = f.label :summary, class: "form-label required"
            = f.text_field :summary, class: "form-control #{'is-invalid' if @event.errors[:summary].any?}", required: true
            - if @event.errors[:summary].any?
              .invalid-feedback= @event.errors[:summary].to_sentence

          .col-12
            .form-check
              = f.check_box :all_day, class: "form-check-input", id: "event_all_day",
                  data: { action: "change->schedule-event#toggleAllDay" }
              = f.label :all_day, "All day", class: "form-check-label", for: "event_all_day"

          .col-md-6
            = f.label :starts_at, "Starts at", class: "form-label"
            = f.datetime_local_field :starts_at, class: "form-control"

          .col-md-6
            = f.label :ends_at, "Ends at", class: "form-label"
            = f.datetime_local_field :ends_at, class: "form-control"

          .col-12
            = f.label :rrule, "Recurrence rule (RRULE)", class: "form-label"
            = f.text_field :rrule, class: "form-control", placeholder: "e.g. FREQ=WEEKLY;BYDAY=MO,WE,FR"
            .form-text
              RFC 5545 RRULE string. Leave blank for a one-time event.

        .d-flex.gap-2.mt-4
          = f.submit "Add Event", class: "btn btn-primary"
          = link_to "Cancel", admin_location_schedule_path(@location, @schedule), class: "btn btn-outline-secondary"
