.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-megaphone.me-2
    Announcements
  %small.text-muted= @location.name

.page-container.p-4
  - if @announcements.empty?
    = render EmptyStateComponent.new(icon: "megaphone", message: "No announcements sent yet.")
  - else
    .card.shadow-sm.border-0
      %table.table.table-hover.mb-0
        %thead
          %tr
            %th Subject
            %th Sent at
            %th Recipients
            %th
        %tbody
          - @announcements.each do |announcement|
            %tr
              %td= link_to announcement.subject, admin_location_location_announcement_path(@location, announcement)
              %td
                - if announcement.sent_at
                  = announcement.sent_at.strftime("%b %-d, %Y")
                - else
                  %span.text-muted.small Pending
              %td= announcement.recipient_count || "—"
              %td.text-end
                = link_to admin_location_location_announcement_path(@location, announcement), class: "btn btn-outline-secondary btn-sm" do
                  View

  .mt-3
    = link_to admin_location_path(@location), class: "btn btn-outline-secondary" do
      %i.bi.bi-arrow-left.me-1
      Back to Location
