.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-tag-fill.me-2
    = @listing.name
  .d-flex.align-items-center.gap-2
    - public_path = @listing.auction_listing ? auction_auction_listing_path(@listing.auction_listing.auction, @listing.auction_listing) : listing_path(@listing)
    = link_to public_path, class: "btn btn-outline-secondary me-2", target: "_blank" do
      %i.bi.bi-box-arrow-up-right.me-1
      Public View
    = button_to admin_listing_path(@listing), method: :delete, class: "btn btn-outline-danger",
      form: { data: { turbo_confirm: "Are you sure you want to delete this listing?" } } do
      %i.bi.bi-trash.me-1
      Delete

%ul.nav.nav-tabs.mb-4#listing-tabs{ role: "tablist" }
  %li.nav-item{ role: "presentation" }
    %button.nav-link.active{id: "details-tab",
      data: { bs_toggle: "tab", bs_target: "#details-pane" },
      type: "button",
      role: "tab",
      aria: { controls: "details-pane", selected: "true" }}
      %i.bi.bi-info-circle.me-1
      Details
  %li.nav-item{ role: "presentation" }
    %button.nav-link{id: "edit-tab",
      data: { bs_toggle: "tab", bs_target: "#edit-pane" },
      type: "button",
      role: "tab",
      aria: { controls: "edit-pane", selected: "false" }}
      %i.bi.bi-pencil.me-1
      Edit
  - if @listing.sale? && !@listing.auction_listing
    %li.nav-item{ role: "presentation" }
      %button.nav-link{id: "offers-tab",
        data: { bs_toggle: "tab", bs_target: "#offers-pane" },
        type: "button",
        role: "tab",
        aria: { controls: "offers-pane", selected: "false" }}
        %i.bi.bi-tag.me-1
        Offers
        - if @offers.any?
          %span.badge.text-bg-secondary.ms-1= @offers.size
  - if @listing.rental?
    %li.nav-item{ role: "presentation" }
      %button.nav-link{id: "rate-plans-tab",
        data: { bs_toggle: "tab", bs_target: "#rate-plans-pane" },
        type: "button",
        role: "tab",
        aria: { controls: "rate-plans-pane", selected: "false" }}
        %i.bi.bi-currency-dollar.me-1
        Rate Plans
    %li.nav-item{ role: "presentation" }
      %button.nav-link{id: "schedule-tab",
        data: { bs_toggle: "tab", bs_target: "#schedule-pane" },
        type: "button",
        role: "tab",
        aria: { controls: "schedule-pane", selected: "false" }}
        %i.bi.bi-calendar3.me-1
        Schedule
  - if @bids
    %li.nav-item{ role: "presentation" }
      %button.nav-link{id: "bids-tab",
        data: { bs_toggle: "tab", bs_target: "#bids-pane" },
        type: "button",
        role: "tab",
        aria: { controls: "bids-pane", selected: "false" }}
        %i.bi.bi-hammer.me-1
        Bids
        - if @bids.any?
          %span.badge.text-bg-secondary.ms-1= @bids.size

.tab-content#listing-tabs-content
  #details-pane.tab-pane.fade.show.active{ role: "tabpanel", aria: { labelledby: "details-tab" } }
    .card.shadow-sm.border-0
      .card-body
        %dl.row.mb-0
          %dt.col-sm-3 Name
          %dd.col-sm-9= @listing.name

          %dt.col-sm-3 Type
          %dd.col-sm-9= listing_type_badge(@listing)

          - if @listing.sale?
            %dt.col-sm-3 Price
            %dd.col-sm-9= humanized_money_with_symbol(@listing.price, no_cents_if_whole: false)

            %dt.col-sm-3 Pricing
            %dd.col-sm-9= listing_pricing_type_badge(@listing)

          %dt.col-sm-3 State
          %dd.col-sm-9= listing_state_badge(@listing)

          %dt.col-sm-3 Owner
          %dd.col-sm-9= mail_to @listing.owner.email_address

          %dt.col-sm-3 Lot
          %dd.col-sm-9
            - if @listing.lot
              = link_to @listing.lot.name, admin_lots_path
            - else
              %span.text-muted —

          %dt.col-sm-3 Categories
          %dd.col-sm-9
            - if @listing.categories.any?
              = listing_categories_badges(@listing)
            - else
              %span.text-muted —

          %dt.col-sm-3 Description
          %dd.col-sm-9= @listing.description

          %dt.col-sm-3 Created At
          %dd.col-sm-9= @listing.created_at.to_fs(:long)

          %dt.col-sm-3 Updated At
          %dd.col-sm-9= @listing.updated_at.to_fs(:long)

  #edit-pane.tab-pane.fade{ role: "tabpanel", aria: { labelledby: "edit-tab" } }
    .pt-3
      = render "admin/listings/form", listing: @listing, categories: @categories, lots: @lots

  - if @listing.sale? && !@listing.auction_listing
    #offers-pane.tab-pane.fade{ role: "tabpanel", aria: { labelledby: "offers-tab" } }
      - if @offers.empty?
        .text-muted.py-3 No offers yet.
      - else
        = render_listing_offers_table(@offers)

  - if @listing.rental?
    #rate-plans-pane.tab-pane.fade{ role: "tabpanel", aria: { labelledby: "rate-plans-tab" } }
      = render "admin/listings/rental_rate_plans/section", listing: @listing

    #schedule-pane.tab-pane.fade{ role: "tabpanel", aria: { labelledby: "schedule-tab" } }
      - booking_events = @rental_bookings.map { |b| { title: b.cart_item.user.email_address, start: b.start_at.iso8601, end: b.end_at.iso8601 } }
      #booking-calendar{ data: { controller: "booking-calendar", "booking-calendar-events-value": booking_events.to_json } }

  - if @bids
    #bids-pane.tab-pane.fade{ role: "tabpanel", aria: { labelledby: "bids-tab" } }
      - if @bids.empty?
        .text-muted.py-3 No bids placed yet.
      - else
        .table-responsive
          %table.table.align-middle.mb-0
            %thead.thead-secondary
              %tr
                %th Bidder
                %th.text-end Amount
                %th State
                %th Placed At
                %th
            %tbody
              - @bids.each do |bid|
                %tr
                  = render TableCellComponent.new(value: bid.auction_registration.user)
                  %td.text-end= humanized_money_with_symbol(bid.amount, no_cents_if_whole: false)
                  %td= bid.state.humanize
                  %td.text-muted.small= bid.created_at.to_fs(:short)
                  %td.text-end
                    - if bid.placed?
                      = button_to "Cancel", admin_bid_path(bid), method: :patch, params: { state: "cancelled" },
                          class: "btn btn-sm btn-outline-danger",
                          form: { data: { turbo_confirm: "Cancel this bid?" } }
                    - elsif bid.cancelled?
                      = button_to "Restore", admin_bid_path(bid), method: :patch, params: { state: "placed" },
                          class: "btn btn-sm btn-outline-secondary",
                          form: { data: { turbo_confirm: "Restore this bid?" } }

.mt-3
  - if (auction = @listing.auction_listing&.auction)
    = link_to admin_auction_path(auction), class: "btn btn-outline-secondary" do
      %i.bi.bi-arrow-left.me-1
      Back to Auction
  - else
    = link_to admin_listings_path, class: "btn btn-outline-secondary" do
      %i.bi.bi-arrow-left.me-1
      Back to Listings
