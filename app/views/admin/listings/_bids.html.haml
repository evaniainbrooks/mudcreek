- if bids
  #bids-pane.tab-pane.fade{ role: "tabpanel", aria: { labelledby: "bids-tab" } }
    - if bids.empty?
      .text-muted.py-3 No bids placed yet.
    - else
      .table-responsive
        %table.table.align-middle.mb-0
          %thead.thead-secondary
            %tr
              %th Bidder
              %th.text-end Amount
              %th State
              %th Placed At
              %th
          %tbody
            - bids.each do |bid|
              %tr
                = render TableCellComponent.new(value: bid.auction_registration.user)
                %td.text-end= humanized_money_with_symbol(bid.amount)
                %td= bid.state.humanize
                %td.text-muted.small= bid.created_at.to_fs(:short)
                %td.text-end
                  - if bid.placed?
                    = button_to "Cancel", admin_bid_path(bid), method: :patch, params: { state: "cancelled" },
                        class: "btn btn-sm btn-outline-danger",
                        form: { data: { turbo_confirm: "Cancel this bid?" } }
                  - elsif bid.cancelled?
                    = button_to "Restore", admin_bid_path(bid), method: :patch, params: { state: "placed" },
                        class: "btn btn-sm btn-outline-secondary",
                        form: { data: { turbo_confirm: "Restore this bid?" } }
