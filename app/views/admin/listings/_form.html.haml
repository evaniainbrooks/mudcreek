= form_with model: [:admin, listing], class: "needs-validation", data: { controller: "listing-type" } do |f|
  - if listing.errors.any?
    .alert.alert-danger.mb-4
      %h5.alert-heading
        %i.bi.bi-exclamation-triangle-fill.me-2
        = pluralize(listing.errors.count, "error")
        prohibited this listing from being saved:
      %ul.mb-0
        - listing.errors.full_messages.each do |message|
          %li= message

  .row.g-4
    .col-lg-6
      = render "admin/listings/general_fields", f: f, listing: listing, lots: lots
      = render "admin/listings/location_fields", f: f, listing: listing
      = render "admin/listings/configuration_fields", f: f, listing: listing,
    categories: categories, delivery_method_sets: delivery_method_sets,
    subscription_plans: subscription_plans

    .col-lg-6
      = render "admin/listings/pricing_fields", f: f, listing: listing

      .mb-4{ data: { "listing-type-target": "ratePlansSection" }, hidden: listing.sale? }
        = render "admin/listings/rental_rate_plans/section", listing: listing, form: f

      .mb-4
        = render "admin/listings/properties/section", listing: listing, form: f, property_sets: property_sets

      - if Current.tenant.features.listing_variants?
        .mb-4
          = render "admin/listings/options/section", listing: listing, form: f
        .mb-4
          = render "admin/listings/variants/section", listing: listing, form: f

      = render "admin/listings/media_fields", f: f, listing: listing

  .d-flex.gap-2.mt-4
    = f.submit class: "btn btn-primary"
    = link_to "Cancel", listing.persisted? ? admin_listing_path(listing) : admin_listings_path, class: "btn btn-outline-secondary"
