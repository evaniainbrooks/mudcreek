%fieldset.card.shadow-sm.border-0{ data: { controller: "listing-property" } }
  %legend.card-header.fw-semibold
    %i.bi.bi-list-check.me-2
    Properties
  .card-body.p-4
    .d-flex.gap-2.mb-1
      %small.text-muted.flex-grow-1 Name
      %small.text-muted.flex-grow-1 Value
    .properties-container{ data: { listing_property_target: "propertiesContainer" } }
      = form.fields_for :properties do |f|
        = render "admin/listings/properties/fields", property_form: f
    .mt-2
      %button.btn.btn-sm.btn-outline-secondary{ type: "button",
          data: { action: "listing-property#addRow" } }
        %i.bi.bi-plus-lg.me-1
        Add Property
    %template{ data: { listing_property_target: "rowTemplate" } }
      = form.fields_for :properties, Listings::Property.new, child_index: "new_property" do |f|
        = render "admin/listings/properties/fields", property_form: f
