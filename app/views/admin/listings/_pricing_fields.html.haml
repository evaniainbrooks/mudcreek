%fieldset.card.shadow-sm.border-0.mb-4{ data: { "listing-type-target": "priceField" }, hidden: listing.rental? }
  %legend.card-header.fw-semibold
    %i.bi.bi-currency-dollar.me-1
    Pricing
  .card-body.p-4
    .mb-3
      = f.label :price, class: "form-label #{'required' unless listing.rental?}"
      .input-group
        %span.input-group-text $
        = f.text_field :price,
          class: "form-control #{'is-invalid' if listing.errors[:price_cents].any?}",
          required: !listing.rental?,
          value: listing.price&.to_f,
          data: { required: "true" }
      - if listing.errors[:price_cents].any?
        .invalid-feedback.d-block= listing.errors[:price_cents].to_sentence
    .mb-3
      = f.label :pricing_type, "Pricing Type", class: "form-label"
      = f.select :pricing_type, Listing.pricing_types.keys.map { |k| [k.humanize, k] },
          {},
          { class: "form-select #{'is-invalid' if listing.errors[:pricing_type].any?}",
            data: { "listing-type-target": "pricingTypeField" } }
      - if listing.errors[:pricing_type].any?
        .invalid-feedback= listing.errors[:pricing_type].to_sentence
    .mb-3
      = f.label :acquisition_price, "Acquisition Price", class: "form-label"
      .input-group
        %span.input-group-text $
        = f.text_field :acquisition_price, value: listing.acquisition_price&.to_f, placeholder: "Optional",
            class: "form-control #{'is-invalid' if listing.errors[:acquisition_price_cents].any?}"
      - if listing.errors[:acquisition_price_cents].any?
        .invalid-feedback.d-block= listing.errors[:acquisition_price_cents].to_sentence
    .mb-3
      = f.label :quantity, class: "form-label #{'required' unless listing.rental?}"
      = f.number_field :quantity,
        class: "form-control #{'is-invalid' if listing.errors[:quantity].any?}",
        min: 0,
        required: !listing.rental?,
        data: { required: "true" }
      - if listing.errors[:quantity].any?
        .invalid-feedback= listing.errors[:quantity].to_sentence
    .mb-0
      = f.label :sku, "SKU", class: "form-label"
      = f.text_field :sku, class: "form-control", placeholder: "Optional"
