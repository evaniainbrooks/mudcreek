%fieldset.card.shadow-sm.border-0
  %legend.card-header.fw-semibold
    %i.bi.bi-toggles.me-1
    Configuration
  .card-body.p-4
    .mb-3.form-check
      = f.check_box :published, class: "form-check-input"
      = f.label :published, class: "form-check-label"
    .mb-3.form-check
      = f.check_box :tax_exempt, class: "form-check-input"
      = f.label :tax_exempt, "Tax Exempt", class: "form-check-label"
    .mb-3
      = f.label :category_ids, "Categories", class: "form-label"
      = f.collection_select :category_ids,
        categories,
        :id,
        :name,
        {},
        { multiple: true, class: "form-select", size: [categories.size, 6].min }
    .mb-3
      = f.label :delivery_method_set_id, "Delivery Method Set", class: "form-label"
      = f.collection_select :delivery_method_set_id, delivery_method_sets, :id, :name,
          { include_blank: "— No delivery required —" },
          { class: "form-select" }

%fieldset.card.shadow-sm.border-0.mt-3{ data: { controller: "listing-fulfillment" } }
  %legend.card-header.fw-semibold
    %i.bi.bi-award.me-1
    Fulfillment
  .card-body.p-4
    .mb-3
      %label.form-label Grants on purchase
      .d-flex.flex-column.gap-2
        .form-check
          %input.form-check-input{type: "radio", name: "fulfillment_type", id: "ft_none",
              value: "none",
              checked: f.object.schedule_event_credits.blank? && f.object.subscription_plan_id.blank?,
              data: { action: "change->listing-fulfillment#update" }}
          %label.form-check-label{ for: "ft_none" } Nothing (standard product)
        .form-check
          %input.form-check-input{type: "radio", name: "fulfillment_type", id: "ft_credits",
              value: "credits",
              checked: f.object.schedule_event_credits.present?,
              data: { action: "change->listing-fulfillment#update" }}
          %label.form-check-label{ for: "ft_credits" } Schedule event credits (punch pass)
        .form-check
          %input.form-check-input{type: "radio", name: "fulfillment_type", id: "ft_subscription",
              value: "subscription",
              checked: f.object.subscription_plan_id.present?,
              data: { action: "change->listing-fulfillment#update" }}
          %label.form-check-label{ for: "ft_subscription" } Membership subscription

    .mb-0{data: { listing_fulfillment_target: "creditsRow" },
           style: f.object.schedule_event_credits.present? ? "" : "display:none"}
      = f.label :schedule_event_credits, "Number of credits", class: "form-label"
      = f.number_field :schedule_event_credits, class: "form-control", min: 1, style: "max-width: 140px"
      .form-text Added to buyer's schedule event pass on purchase.

    .mb-0{data: { listing_fulfillment_target: "subscriptionRow" },
           style: f.object.subscription_plan_id.present? ? "" : "display:none"}
      = f.label :subscription_plan_id, "Subscription plan", class: "form-label"
      = f.collection_select :subscription_plan_id, subscription_plans, :id, :name,
          { include_blank: "— Select a plan —" },
          { class: "form-select" }
      .form-text A subscription is created for the buyer on purchase.
