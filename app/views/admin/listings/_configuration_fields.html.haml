%fieldset.card.shadow-sm.border-0
  %legend.card-header.fw-semibold
    %i.bi.bi-toggles.me-1
    Configuration
  .card-body.p-4
    .mb-3.form-check
      = f.check_box :published, class: "form-check-input"
      = f.label :published, class: "form-check-label"
    .mb-3.form-check
      = f.check_box :tax_exempt, class: "form-check-input"
      = f.label :tax_exempt, "Tax Exempt", class: "form-check-label"
    .mb-3
      = f.label :category_ids, "Categories", class: "form-label"
      = f.collection_select :category_ids,
        categories,
        :id,
        :name,
        {},
        { multiple: true, class: "form-select", size: [categories.size, 6].min }
    .mb-0
      = f.label :delivery_method_set_id, "Delivery Method Set", class: "form-label"
      = f.collection_select :delivery_method_set_id, delivery_method_sets, :id, :name,
          { include_blank: "— No delivery required —" },
          { class: "form-select" }
