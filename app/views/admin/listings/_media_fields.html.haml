%fieldset.card.shadow-sm.border-0{ data: { controller: "direct-upload" } }
  %legend.card-header.fw-semibold
    %i.bi.bi-image.me-1
    Media
  .card-body.p-4
    .mb-3.form-check
      = f.check_box :show_video_as_poster, class: "form-check-input"
      = f.label :show_video_as_poster, "Show video as poster (prefer video over image on cards)", class: "form-check-label"
    = f.fields_for :gallery do |gf|
      .mb-3
        = gf.label :photos, class: "form-label"
        = gf.file_field :photos,
          multiple: true,
          direct_upload: true,
          class: "form-control #{'is-invalid' if listing.gallery&.errors[:photos].any?}",
          accept: "image/*"
        - if listing.gallery&.errors[:photos].any?
          .invalid-feedback= listing.gallery.errors[:photos].to_sentence
        = render Admin::AttachmentsListComponent.new(
          attachments: listing.gallery&.photos_attachments || [],
          delete_path: listing.gallery&.persisted? ? ->(a) { admin_listing_gallery_attachment_path(listing, a) } : nil)
      .mb-3
        = gf.label :videos, class: "form-label"
        = gf.file_field :videos,
          multiple: true,
          direct_upload: true,
          class: "form-control #{'is-invalid' if listing.gallery&.errors[:videos].any?}",
          accept: "video/*"
        - if listing.gallery&.errors[:videos].any?
          .invalid-feedback= listing.gallery.errors[:videos].to_sentence
        = render Admin::AttachmentsListComponent.new(
          attachments: listing.gallery&.videos_attachments || [],
          delete_path: listing.gallery&.persisted? ? ->(a) { admin_listing_gallery_attachment_path(listing, a) } : nil)
      .mb-0
        = gf.label :documents, class: "form-label"
        = gf.file_field :documents,
          multiple: true,
          direct_upload: true,
          class: "form-control #{'is-invalid' if listing.gallery&.errors[:documents].any?}",
          accept: ".pdf,.doc,.docx,.xlsx"
        - if listing.gallery&.errors[:documents].any?
          .invalid-feedback= listing.gallery.errors[:documents].to_sentence
        = render Admin::AttachmentsListComponent.new(
          attachments: listing.gallery&.documents_attachments || [],
          delete_path: listing.gallery&.persisted? ? ->(a) { admin_listing_gallery_attachment_path(listing, a) } : nil)
    .mt-3{ data: { "direct-upload-target": "progressContainer" }, hidden: true }
