%tr
  %td
    = variant_form.hidden_field :_destroy, value: "0"
    .small= variant_form.object.display_name.presence || "—"
  %td.text-end
    = variant_form.number_field :quantity,
        class: "form-control form-control-sm text-end",
        min: 0, style: "width: 80px; margin-left: auto"
  %td.text-end
    .input-group.input-group-sm{ style: "width: 130px; margin-left: auto" }
      %span.input-group-text= Current.tenant.currency
      = variant_form.number_field :price_cents,
          class: "form-control text-end",
          placeholder: "—",
          min: 0,
          value: variant_form.object.price_cents
  %td
    = variant_form.text_field :sku, class: "form-control form-control-sm", placeholder: "—"
  %td
    - if variant_form.object.persisted?
      - count = variant_form.object.gallery&.photos&.size || 0
      = link_to edit_admin_listing_variant_path(listing, variant_form.object),
          class: "btn btn-sm #{count > 0 ? 'btn-primary' : 'btn-outline-secondary'}",
          title: "Manage variant gallery" do
        %i.bi.bi-images.me-1
        = count > 0 ? count.to_s : "Gallery"
  %td.text-nowrap
    .form-check
      = variant_form.check_box :_destroy, class: "form-check-input"
      = variant_form.label :_destroy, "Remove", class: "form-check-label small text-danger"
