%fieldset.card.shadow-sm.border-0
  %legend.card-header.fw-semibold Rate Plans
  .card-body.p-4
    %ul.list-group#rental-rate-plans{ class: listing.rental_rate_plans.any? ? "mb-3" : "" }
      - listing.rental_rate_plans.order(:position).each do |rate_plan|
        = render "admin/listings/rental_rate_plans/rate_plan", rate_plan: rate_plan
    - if local_assigns.key?(:form)
      = render "admin/listings/rental_rate_plans/form", listing: listing, rate_plan: Listings::RentalRatePlan.new, form: form
