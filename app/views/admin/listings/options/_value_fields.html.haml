.d-flex.align-items-center.gap-2.mb-1
  = value_form.hidden_field :position if value_form.object.persisted?
  = value_form.text_field :value,
      class: "form-control form-control-sm flex-grow-1",
      placeholder: "e.g. Small"
  - if value_form.object.persisted?
    .form-check.mb-0
      = value_form.check_box :_destroy, class: "form-check-input"
      = value_form.label :_destroy, "Remove", class: "form-check-label small text-danger"
