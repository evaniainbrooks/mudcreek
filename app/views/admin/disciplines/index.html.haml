.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-award.me-2
    Disciplines
  = link_to new_admin_discipline_path, class: "btn btn-primary" do
    %i.bi.bi-plus-lg.me-1
    New Discipline

.page-container
  - if @disciplines.any?
    .card.shadow-sm.border-0
      .card-body.p-0
        %table.table.table-hover.mb-0
          %thead
            %tr
              %th Name
              %th Ranks
              %th
          %tbody
            - @disciplines.each do |discipline|
              %tr
                %td= link_to discipline.name, admin_discipline_path(discipline)
                %td= discipline.ranks.size
                %td.text-end
                  = link_to "Edit", edit_admin_discipline_path(discipline), class: "btn btn-sm btn-outline-secondary me-1"
                  = button_to "Delete", admin_discipline_path(discipline), method: :delete,
                      class: "btn btn-sm btn-outline-danger",
                      form: { data: { turbo_confirm: "Delete #{discipline.name}? This will remove all associated ranks and promotions." } }
  - else
    .text-muted.text-center.py-4 No disciplines yet.
