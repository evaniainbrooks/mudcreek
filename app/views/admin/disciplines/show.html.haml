.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-award.me-2
    = @discipline.name

.page-container.p-4
  .card.shadow-sm.border-0.mb-4
    .card-header.fw-semibold Add Rank
    .card-body
      = form_with model: [ :admin, @discipline, Rank.new ] do |f|
        - if @rank&.errors&.any?
          .alert.alert-danger.mb-3
            = @rank.errors.full_messages.to_sentence
        .row.g-3
          .col-sm-4
            = f.label :name, class: "form-label form-label-sm required"
            = f.text_field :name, required: true, class: "form-control form-control-sm", placeholder: "e.g. White, Blue, Purple"
          .col-sm-2
            = f.label :position, class: "form-label form-label-sm required"
            = f.number_field :position, required: true, class: "form-control form-control-sm", min: 1, placeholder: "1"
          .col-sm-auto.d-flex.align-items-end
            = f.submit "Add", class: "btn btn-primary btn-sm"

  :ruby
    t = TableComponent.new(rows: @ranks)
    t.with_column("Position") { |r| r.position }
    t.with_column("Name") { |r| r.name }
    t.with_column("", html_class: "text-end") do |r|
      safe_join([
        link_to("Edit", edit_admin_discipline_rank_path(@discipline, r), class: "btn btn-sm btn-outline-secondary me-1"),
        button_to("Delete", admin_discipline_rank_path(@discipline, r), method: :delete,
          class: "btn btn-sm btn-outline-danger",
          form: { data: { turbo_confirm: "Delete #{r.name}?" } })
      ])
    end
  = render t

  .mt-3
    = link_to admin_disciplines_path, class: "btn btn-outline-secondary" do
      %i.bi.bi-arrow-left.me-1
      Back to Disciplines
