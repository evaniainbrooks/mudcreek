= form_with model: [:admin, page], class: "needs-validation" do |f|
  - if page.errors.any?
    .alert.alert-danger.mb-4
      %h5.alert-heading
        %i.bi.bi-exclamation-triangle-fill.me-2
        = pluralize(page.errors.count, "error")
        prohibited this page from being saved:
      %ul.mb-0
        - page.errors.full_messages.each do |message|
          %li= message

  .row.g-4
    .col-lg-8
      %fieldset.card.shadow-sm.border-0.mb-4
        %legend.card-header.fw-semibold
          %i.bi.bi-info-circle.me-1
          Content
        .card-body.p-4
          .mb-3
            = f.label :title, class: "form-label required"
            = f.text_field :title, class: "form-control #{'is-invalid' if page.errors[:title].any?}", required: true
            - if page.errors[:title].any?
              .invalid-feedback= page.errors[:title].to_sentence
          .mb-3
            = f.label :slug, class: "form-label required"
            = f.text_field :slug,
                class: "form-control #{'is-invalid' if page.errors[:slug].any?}",
                placeholder: "auto-derived from title on create"
            - if page.errors[:slug].any?
              .invalid-feedback= page.errors[:slug].to_sentence
            %small.text-muted Lowercase letters, numbers, and hyphens only (e.g. about-us)
          .mb-3
            = f.label :icon, class: "form-label"
            = f.text_field :icon,
                class: "form-control #{'is-invalid' if page.errors[:icon].any?}",
                placeholder: "e.g. bi-info-circle"
            - if page.icon.present?
              %small.text-muted
                Preview:
                %i{ class: "bi #{page.icon} ms-1" }
            - else
              %small.text-muted Bootstrap Icons class name (optional, e.g. bi-info-circle)
            - if page.errors[:icon].any?
              .invalid-feedback= page.errors[:icon].to_sentence
          .mb-0
            = f.label :body, class: "form-label"
            = f.rich_text_area :body, class: "form-control #{'is-invalid' if page.errors[:body].any?}"
            - if page.errors[:body].any?
              .invalid-feedback.d-block= page.errors[:body].to_sentence

    .col-lg-4
      %fieldset.card.shadow-sm.border-0
        %legend.card-header.fw-semibold
          %i.bi.bi-toggles.me-1
          Settings
        .card-body.p-4
          .mb-3.form-check
            = f.check_box :published, class: "form-check-input"
            = f.label :published, class: "form-check-label"
          .mb-3.form-check
            = f.check_box :show_in_nav, class: "form-check-input"
            = f.label :show_in_nav, "Show in navbar", class: "form-check-label"
          .mb-3.form-check
            = f.check_box :show_in_footer, class: "form-check-input"
            = f.label :show_in_footer, "Show in footer", class: "form-check-label"
          .mb-0
            = f.label :position, class: "form-label"
            = f.number_field :position, class: "form-control #{'is-invalid' if page.errors[:position].any?}", min: 0
            - if page.errors[:position].any?
              .invalid-feedback= page.errors[:position].to_sentence

    %fieldset.card.shadow-sm.border-0.mt-4
      %legend.card-header.fw-semibold
        %i.bi.bi-search.me-1
        SEO / Metadata
      .card-body.p-4
        .mb-3
          = f.label :meta_title, "Meta Title", class: "form-label"
          = f.text_field :meta_title, class: "form-control", placeholder: page.title.presence || "Defaults to page title"
          %small.text-muted Overrides the browser tab title and search engine title. Leave blank to use the page title.
        .mb-0
          = f.label :meta_description, "Meta Description", class: "form-label"
          = f.text_area :meta_description, class: "form-control", rows: 3,
              placeholder: "Brief description for search engines and social sharing (recommended: 150–160 characters)"
          - if page.meta_description.present?
            %small.text-muted #{page.meta_description.length} characters

    %fieldset.card.shadow-sm.border-0.mt-4
      %legend.card-header.fw-semibold
        %i.bi.bi-images.me-1
        Images
      .card-body.p-4
        .mb-3
          = f.label :hero_image, "Hero image", class: "form-label"
          = f.file_field :hero_image, direct_upload: true, class: "form-control", accept: "image/*"
          - if page.hero_image.attached?
            .mt-2.d-flex.align-items-center.gap-2
              = image_tag page.hero_image.variant(resize_to_fill: [240, 80]),
                  class: "rounded", style: "object-fit: cover"
              = link_to admin_page_path(page, remove_hero_image: "1"),
                  class: "btn btn-sm btn-outline-danger",
                  data: { turbo_method: :patch, turbo_confirm: "Remove hero image?" } do
                %i.bi.bi-x-lg.me-1
                Remove
        .mb-3
          = f.label :left_column_image, "Left column image", class: "form-label"
          = f.file_field :left_column_image, direct_upload: true, class: "form-control", accept: "image/*"
          - if page.left_column_image.attached?
            .mt-2.d-flex.align-items-center.gap-2
              = image_tag page.left_column_image.variant(resize_to_fill: [120, 80]),
                  class: "rounded", style: "object-fit: cover"
              = link_to admin_page_path(page, remove_left_column_image: "1"),
                  class: "btn btn-sm btn-outline-danger",
                  data: { turbo_method: :patch, turbo_confirm: "Remove left column image?" } do
                %i.bi.bi-x-lg.me-1
                Remove
        .mb-0
          = f.label :right_column_image, "Right column image", class: "form-label"
          = f.file_field :right_column_image, direct_upload: true, class: "form-control", accept: "image/*"
          - if page.right_column_image.attached?
            .mt-2.d-flex.align-items-center.gap-2
              = image_tag page.right_column_image.variant(resize_to_fill: [120, 80]),
                  class: "rounded", style: "object-fit: cover"
              = link_to admin_page_path(page, remove_right_column_image: "1"),
                  class: "btn btn-sm btn-outline-danger",
                  data: { turbo_method: :patch, turbo_confirm: "Remove right column image?" } do
                %i.bi.bi-x-lg.me-1
                Remove

  .d-flex.gap-2.mt-4
    = f.submit class: "btn btn-primary"
    = link_to "Cancel", admin_pages_path, class: "btn btn-outline-secondary"
