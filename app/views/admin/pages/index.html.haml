.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-file-earmark-text.me-2
    Pages
  = link_to new_admin_page_path, class: "btn btn-primary" do
    %i.bi.bi-plus-lg.me-1
    New Page

.page-container.p-4
  - if @pages.empty?
    = render EmptyStateComponent.new(icon: "file-earmark-text", message: "No pages yet.")
  - else
    = render_pages_table(@pages)
