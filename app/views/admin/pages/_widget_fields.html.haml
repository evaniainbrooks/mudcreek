%fieldset.card.shadow-sm.border-0{ data: { controller: "page-widgets" } }
  %legend.card-header.fw-semibold
    %i.bi.bi-puzzle.me-1
    Widgets
  .card-body.p-4
    %p.text-muted.small.mb-3 Widgets appear below the page body in the order listed.
    .mb-3{ data: { page_widgets_target: "container" } }
      = f.fields_for :widgets do |wf|
        = render "admin/pages/widget_row", widget_form: wf, **widget_collections
    %button.btn.btn-sm.btn-outline-secondary{type: "button",
        data: { action: "page-widgets#addWidget" }}
      %i.bi.bi-plus-lg.me-1
      Add Widget
  %template{ data: { page_widgets_target: "rowTemplate" } }
    = f.fields_for :widgets, Widget.new, child_index: "new_widget" do |wf|
      = render "admin/pages/widget_row", widget_form: wf, **widget_collections
