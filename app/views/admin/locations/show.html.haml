
.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-geo-alt.me-2
    = @location.name
  .d-flex.gap-2
    - if @location.published?
      = link_to location_path(@location), class: "btn btn-outline-secondary btn-sm", target: "_blank" do
        %i.bi.bi-box-arrow-up-right.me-1
        Public View
    = link_to edit_admin_location_path(@location), class: "btn btn-outline-secondary btn-sm" do
      %i.bi.bi-pencil.me-1
      Edit
    = button_to admin_location_path(@location), method: :delete, class: "btn btn-outline-danger btn-sm",
        form: { data: { turbo_confirm: "Delete \"#{@location.name}\"?" } } do
      %i.bi.bi-trash.me-1
      Delete

.page-container.p-4
  .row.g-4.mb-4

    .col-md-3
      .card.shadow-sm.border-0.h-100
        .card-body
          %h6.card-title.text-muted.text-uppercase.small.mb-1 Total Check-ins
          %p.display-6.fw-bold.mb-0= @total_check_ins

    .col-md-3
      .card.shadow-sm.border-0.h-100
        .card-body
          %h6.card-title.text-muted.text-uppercase.small.mb-1 Today
          %p.display-6.fw-bold.mb-0= @today_check_ins

    .col-md-3
      .card.shadow-sm.border-0.h-100
        .card-body
          %h6.card-title.text-muted.text-uppercase.small.mb-1 This Week
          %p.display-6.fw-bold.mb-0= @week_check_ins

    .col-md-3
      .card.shadow-sm.border-0.h-100
        .card-body
          %h6.card-title.text-muted.text-uppercase.small.mb-1 This Month
          %p.display-6.fw-bold.mb-0= @month_check_ins

  .row.g-4

    .col-lg-4
      .card.shadow-sm.border-0.mb-4
        .card-header.fw-semibold
          %i.bi.bi-info-circle.me-1
          Details
        .card-body
          %dl.row.mb-0
            %dt.col-sm-5 Name
            %dd.col-sm-7= @location.name
            %dt.col-sm-5 Address
            %dd.col-sm-7
              - if @location.address&.any?
                %button.btn.btn-link.p-0.text-start.text-decoration-underline{ type: "button", data: { "bs-toggle": "modal", "bs-target": "#map-modal" } }
                  = @location.address.to_fs(:long)
              - else
                %span.text-muted —
            %dt.col-sm-5 Logo
            %dd.col-sm-7
              - if @location.logo.attached?
                = image_tag @location.logo.variant(resize_to_fill: [80, 80]), class: "rounded", style: "object-fit: cover"
              - else
                %span.text-muted —
            %dt.col-sm-5 Background
            %dd.col-sm-7
              - if @location.background.attached?
                - if @location.background.video?
                  %video{src: url_for(@location.background), width: 80, height: 80,
                      style: "object-fit: cover; border-radius: 0.25rem", muted: true}
                - else
                  = image_tag @location.background.variant(resize_to_fill: [80, 80]), class: "rounded", style: "object-fit: cover"
              - else
                %span.text-muted —
            - if @location.message.present?
              %dt.col-sm-5 Message
              %dd.col-sm-7= @location.message


      .card.shadow-sm.border-0
        .card-header.fw-semibold.d-flex.justify-content-between.align-items-center
          %span
            %i.bi.bi-qr-code.me-1
            Check-in QR Code
          - if @qr_code
            = link_to admin_qr_code_path(@qr_code), class: "btn btn-outline-secondary btn-sm" do
              %i.bi.bi-arrow-up-right.me-1
              View
        - if @qr_code
          .card-body.text-center
            - qr = RQRCode::QRCode.new(qr_redirect_url(@qr_code))
            = raw qr.as_svg(offset: 0, color: "000000", shape_rendering: "crispEdges", module_size: 6)
            %p.mt-2.mb-1
              %small.text-muted.text-break= qr_redirect_url(@qr_code)
            .d-flex.justify-content-center.gap-3.text-muted.small
              %span= "#{@qr_code.scan_count} scans"
              - if @qr_code.last_scanned_at
                %span Last scanned #{time_ago_in_words(@qr_code.last_scanned_at)} ago
        - else
          .card-body.text-muted No QR code — resave this location to generate one.

    .col-lg-8
      .card.shadow-sm.border-0
        .card-header.fw-semibold
          %i.bi.bi-people.me-1
          Check-ins by User
        - if @user_stats.any?
          .card-body.p-0
            %table.table.table-sm.mb-0
              %thead.table-light
                %tr
                  %th User
                  %th.text-center Total
                  %th Last Check-in
              %tbody
                - @user_stats.each do |stat|
                  %tr
                    %td
                      - if stat[:user]
                        = link_to stat[:user].name, admin_user_path(stat[:user]), class: "text-decoration-none"
                        %small.text-muted.d-block= stat[:user].email_address
                      - elsif stat[:guest]
                        %span.text-muted Guest check-ins
                      - else
                        %span.text-muted Deleted user
                    %td.text-center= stat[:count]
                    %td= stat[:last_at]&.strftime("%b %-d, %Y %H:%M") || "—"
        - else
          .card-body.text-muted No check-ins yet.

  - if @recent_check_ins.any?
    .card.shadow-sm.border-0.mt-4
      .card-header.fw-semibold
        %i.bi.bi-clock-history.me-1
        Recent Check-ins
      .card-body.p-0
        %table.table.table-sm.mb-0
          %thead.table-light
            %tr
              %th Time
              %th User
          %tbody
            - @recent_check_ins.each do |ci|
              %tr
                %td= ci.created_at.strftime("%b %-d, %Y %H:%M")
                %td
                  - if ci.user
                    = link_to ci.user.name, admin_user_path(ci.user), class: "text-decoration-none"
                  - elsif ci.guest_name.present?
                    = ci.guest_name
                    %small.text-muted.ms-1 (guest)
                  - else
                    %span.text-muted Unknown

  .mt-3
    = link_to admin_locations_path, class: "btn btn-outline-secondary" do
      %i.bi.bi-arrow-left.me-1
      Back to Locations

- if @location.address&.any?
  = render "shared/map_modal", address: @location.address
