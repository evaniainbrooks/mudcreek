
.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-geo-alt.me-2
    = @location.name
  .d-flex.gap-2
    - if @location.published?
      = link_to location_kiosk_path(@location), class: "btn btn-outline-secondary btn-sm", target: "_blank" do
        %i.bi.bi-box-arrow-up-right.me-1
        Public View
    = button_to admin_location_path(@location), method: :delete, class: "btn btn-outline-danger btn-sm",
        form: { data: { turbo_confirm: "Delete \"#{@location.name}\"?" } } do
      %i.bi.bi-trash.me-1
      Delete

.page-container
  %ul.nav.nav-tabs.px-4.pt-3{ role: "tablist" }
    %li.nav-item{ role: "presentation" }
      %button.nav-link.active{id: "details-tab", type: "button", role: "tab",
          data: { bs_toggle: "tab", bs_target: "#details-pane" },
          aria: { controls: "details-pane", selected: "true" }}
        %i.bi.bi-info-circle.me-1
        Details
    %li.nav-item{ role: "presentation" }
      %button.nav-link{id: "edit-tab", type: "button", role: "tab",
          data: { bs_toggle: "tab", bs_target: "#edit-pane" },
          aria: { controls: "edit-pane", selected: "false" }}
        %i.bi.bi-pencil.me-1
        Edit
    %li.nav-item{ role: "presentation" }
      %button.nav-link{id: "kiosk-tab", type: "button", role: "tab",
          data: { bs_toggle: "tab", bs_target: "#kiosk-pane" },
          aria: { controls: "kiosk-pane", selected: "false" }}
        %i.bi.bi-display.me-1
        Kiosk
    %li.nav-item{ role: "presentation" }
      %button.nav-link{id: "schedules-tab", type: "button", role: "tab",
          data: { bs_toggle: "tab", bs_target: "#schedules-pane" },
          aria: { controls: "schedules-pane", selected: "false" }}
        %i.bi.bi-calendar3.me-1
        Schedules
        %span.badge.text-bg-secondary.ms-1= @schedules.count

  .p-4
    .tab-content
      #details-pane.tab-pane.fade.show.active{ role: "tabpanel", aria: { labelledby: "details-tab" } }
        .row.g-4.mb-4
          .col-12
            .card.shadow-sm.border-0
              .card-header.fw-semibold
                %i.bi.bi-info-circle.me-1
                Details
              .card-body
                .row
                  .col-md-6
                    %dl.row.mb-0
                      %dt.col-5 Name
                      %dd.col-7= @location.name
                      %dt.col-5 Address
                      %dd.col-7
                        - if @location.address&.any?
                          %button.btn.btn-link.p-0.text-start.text-decoration-underline{type: "button",
                              data: { "bs-toggle": "modal", "bs-target": "#map-modal" }}
                            = @location.address.to_fs(:long)
                        - else
                          %span.text-muted —
                  .col-md-6
                    %dl.row.mb-0
                      %dt.col-5 Published
                      %dd.col-7
                        - if @location.published?
                          %span.badge.text-bg-success Published
                        - else
                          %span.badge.text-bg-secondary Unpublished
                      - if @location.directions.present?
                        %dt.col-5 Directions
                        %dd.col-7= @location.directions

        = render "stats_row",
            total: @total_check_ins,
            today: @today_check_ins,
            week:  @week_check_ins,
            month: @month_check_ins

        .row.g-4
          .col-lg-6
            = render "check_ins_by_user", user_stats: @user_stats
          .col-lg-6
            = render "recent_check_ins", recent_check_ins: @recent_check_ins

        = render "members_and_announcements",
            location: @location,
            members: @members,
            non_members: @non_members,
            announcements: @announcements

      #edit-pane.tab-pane.fade{ role: "tabpanel", aria: { labelledby: "edit-tab" } }
        = render "form", location: @location

      #kiosk-pane.tab-pane.fade{ role: "tabpanel", aria: { labelledby: "kiosk-tab" } }
        = render "kiosk_form", location: @location, kiosk: @kiosk, qr_code: @qr_code, drop_in_listings: @drop_in_listings

      #schedules-pane.tab-pane.fade{ role: "tabpanel", aria: { labelledby: "schedules-tab" } }
        .d-flex.justify-content-between.align-items-center.mb-3
          %h6.fw-semibold.mb-0 Schedules
          = link_to new_admin_location_schedule_path(@location), class: "btn btn-primary btn-sm" do
            %i.bi.bi-plus-lg.me-1
            New Schedule

        :ruby
          table = TableComponent.new(rows: @schedules)
          table.with_column("Name") do |s|
            link_to(s.name.presence || content_tag(:span, "Untitled", class: "text-muted"), admin_location_schedule_path(@location, s))
          end
          table.with_column("Source")            { |s| s.source_url.presence || content_tag(:span, "Uploaded file", class: "text-muted fst-italic") }
          table.with_value_column("Last synced") { |s| s.last_synced_at }
          table.with_column("Events")            { |s| s.schedule_events.count }
          table.with_column("", html_class: "text-end") do |s|
            button_to admin_location_schedule_path(@location, s), method: :delete, class: "btn btn-outline-danger btn-sm",
              form: { data: { turbo_confirm: "Delete \"#{s.name}\"?" } } do
              content_tag(:i, "", class: "bi bi-trash")
            end
          end
        = render table

.mt-3
  = link_to admin_locations_path, class: "btn btn-outline-secondary" do
    %i.bi.bi-arrow-left.me-1
    Back to Locations

- if @location.address&.any?
  = render "shared/map_modal", address: @location.address
