.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-geo-alt.me-2
    Locations
  = link_to new_admin_location_path, class: "btn btn-primary" do
    %i.bi.bi-plus-lg.me-1
    New Location

.page-container.p-4
  - if @locations.any?
    = render_locations_table(locations: @locations)
  - else
    .text-muted.py-3.text-center No locations yet.

  - if @pagy.next
    .d-flex.justify-content-end.mt-3
      = link_to admin_locations_path(page: @pagy.next), class: "btn btn-outline-secondary btn-sm" do
        Next
        %i.bi.bi-chevron-right
