= form_with model: [:admin, location], class: "needs-validation" do |f|
  - if location.errors.any?
    .alert.alert-danger.mb-4
      %h5.alert-heading
        %i.bi.bi-exclamation-triangle-fill.me-2
        = pluralize(location.errors.count, "error")
        prohibited this location from being saved:
      %ul.mb-0
        - location.errors.full_messages.each do |message|
          %li= message

  .row.g-4
    .col-lg-6
      %fieldset.card.shadow-sm.border-0.mb-4
        %legend.card-header.fw-semibold
          %i.bi.bi-info-circle.me-1
          Details
        .card-body.p-4
          .mb-3
            .form-check
              = f.check_box :published, class: "form-check-input"
              = f.label :published, class: "form-check-label"
          .mb-3
            .form-check
              = f.check_box :default, class: "form-check-input"
              = f.label :default, "Default location", class: "form-check-label"
              .form-text Checking this will unset any other default location.
          .mb-3
            = f.label :name, class: "form-label required"
            = f.text_field :name, class: "form-control #{'is-invalid' if location.errors[:name].any?}", required: true
            - if location.errors[:name].any?
              .invalid-feedback= location.errors[:name].to_sentence
          .mb-0
            = f.label :tax_rate_percent, "Sales Tax Rate", class: "form-label"
            .input-group
              = f.number_field :tax_rate_percent, step: "0.0001", min: "0", max: "99.9999",
                  class: "form-control #{'is-invalid' if location.errors[:tax_rate].any?}"
              %span.input-group-text %
            .form-text
              Default: #{(SALES_TAX_RATE * 100).to_f}%
            - if location.errors[:tax_rate].any?
              .text-danger.small= location.errors[:tax_rate].to_sentence

      %fieldset.card.shadow-sm.border-0
        %legend.card-header.fw-semibold
          %i.bi.bi-signpost-2.me-1
          Directions
        .card-body.p-4
          = f.text_area :directions, class: "form-control", rows: 4
          .form-text Displayed on the location widget in place of the message.

    .col-lg-6
      = f.fields_for :address do |a|
        %fieldset.card.shadow-sm.border-0
          %legend.card-header.fw-semibold
            %i.bi.bi-house.me-1
            Address
          .card-body.p-4
            = render "shared/address_fields", af: a

  .d-flex.gap-2.mt-4
    = f.submit class: "btn btn-primary"
    = link_to "Cancel", location.persisted? ? admin_location_path(location) : admin_locations_path, class: "btn btn-outline-secondary"
