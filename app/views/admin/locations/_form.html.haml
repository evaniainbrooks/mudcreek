= form_with model: [:admin, location], class: "needs-validation" do |f|
  - if location.errors.any?
    .alert.alert-danger.mb-4
      %h5.alert-heading
        %i.bi.bi-exclamation-triangle-fill.me-2
        = pluralize(location.errors.count, "error")
        prohibited this location from being saved:
      %ul.mb-0
        - location.errors.full_messages.each do |message|
          %li= message

  .row.g-4
    .col-lg-6
      %fieldset.card.shadow-sm.border-0.mb-4
        %legend.card-header.fw-semibold
          %i.bi.bi-info-circle.me-1
          Details
        .card-body.p-4
          .mb-3
            .form-check
              = f.check_box :published, class: "form-check-input"
              = f.label :published, class: "form-check-label"
          .mb-0
            = f.label :name, class: "form-label required"
            = f.text_field :name, class: "form-control #{'is-invalid' if location.errors[:name].any?}", required: true
            - if location.errors[:name].any?
              .invalid-feedback= location.errors[:name].to_sentence

      %fieldset.card.shadow-sm.border-0.mb-4
        %legend.card-header.fw-semibold
          %i.bi.bi-calendar-event.me-1
          Calendar
        .card-body.p-4
          .mb-3
            = f.label :checkin_exit_url, "Close Button URL", class: "form-label"
            = f.url_field :checkin_exit_url, class: "form-control", placeholder: "https://... (defaults to /)"
            .form-text
              Where the "Close" button on the check-in screen links to.
          .mb-0
            = f.label :ical_url, "iCal / ICS Feed URL", class: "form-label"
            = f.url_field :ical_url, class: "form-control", placeholder: "https://..."
            .form-text
              Paste a public .ics URL. Events for the current day will appear on the showroom screen.
              - if location.calendar_file.attached?
                %span.ms-1.text-success
                  %i.bi.bi-check-circle-fill.me-1
                  Calendar synced.

      %fieldset.card.shadow-sm.border-0
        %legend.card-header.fw-semibold
          %i.bi.bi-chat-text.me-1
          Message
        .card-body.p-4
          = f.rich_text_area :message, class: "form-control"

    .col-lg-6
      %fieldset.card.shadow-sm.border-0.mb-4{ data: { controller: "direct-upload" } }
        %legend.card-header.fw-semibold
          %i.bi.bi-image.me-1
          Media
        .card-body.p-4
          .mb-3
            = f.label :logo, class: "form-label"
            = f.file_field :logo, direct_upload: true, class: "form-control", accept: "image/*"
            - if location.logo.attached?
              .mt-2.d-flex.align-items-center.gap-2
                = image_tag location.logo.variant(resize_to_fill: [120, 80]), class: "rounded", style: "object-fit: cover"
                - if location.persisted?
                  = link_to admin_location_path(location, remove_logo: "1"),
                      class: "btn btn-sm btn-outline-danger",
                      data: { turbo_method: :patch, turbo_confirm: "Remove logo?" } do
                    %i.bi.bi-x-lg.me-1
                    Remove
          .mb-0
            = f.label :background, "Background (image or video)", class: "form-label"
            = f.file_field :background, direct_upload: true, class: "form-control", accept: "image/*,video/*"
            - if location.background.attached?
              .mt-2.d-flex.align-items-center.gap-2
                - if location.background.video?
                  %video{src: url_for(location.background), width: 120, height: 80,
                      style: "object-fit: cover; border-radius: 0.25rem", muted: true}
                - else
                  = image_tag location.background.variant(resize_to_fill: [120, 80]), class: "rounded", style: "object-fit: cover"
                - if location.persisted?
                  = link_to admin_location_path(location, remove_background: "1"),
                      class: "btn btn-sm btn-outline-danger",
                      data: { turbo_method: :patch, turbo_confirm: "Remove background?" } do
                    %i.bi.bi-x-lg.me-1
                    Remove
          .mt-3{ data: { "direct-upload-target": "progressContainer" }, hidden: true }
          .mt-3
            = f.label :background_tint_opacity, "Background tint opacity (0–1)", class: "form-label"
            = f.number_field :background_tint_opacity, class: "form-control", min: 0, max: 1, step: 0.05
            .form-text Controls how dark the overlay on the background is. 0 = no tint, 1 = fully black.

      = f.fields_for :address do |a|
        %fieldset.card.shadow-sm.border-0
          %legend.card-header.fw-semibold
            %i.bi.bi-house.me-1
            Address
          .card-body.p-4
            = render "shared/address_fields", af: a

  .d-flex.gap-2.mt-4
    = f.submit class: "btn btn-primary"
    = link_to "Cancel", admin_locations_path, class: "btn btn-outline-secondary"
