%tr{data: { id: order.id }}
  %td= link_to order.number, admin_order_path(order), class: "fw-semibold"
  = render TableCellComponent.new(value: order.user)
  %td= order.order_items.size
  %td= order_status_badge(order)
  = render TableCellComponent.new(value: order.total)
  = render TableCellComponent.new(value: order.created_at)
