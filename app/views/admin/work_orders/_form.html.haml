= form_with model: [:admin, work_order], html: { class: "needs-validation" } do |f|
  .row.g-4
    .col-lg-8
      .card.shadow-sm.border-0.mb-4
        .card-header.fw-semibold Job Details
        .card-body
          .mb-3
            = f.label :title, class: "form-label"
            = f.text_field :title, class: "form-control", required: true
          .mb-3
            = f.label :location_id, "Depot / Business Location", class: "form-label"
            = f.collection_select :location_id, Location.ordered, :id, :name, { prompt: "Select a location" }, class: "form-select", required: true
            .form-text Used to determine the applicable tax rate for this work order.
          .mb-3
            = f.label :description, class: "form-label"
            = f.text_area :description, class: "form-control", rows: 3
          .mb-0
            = f.label :admin_notes, "Internal Notes", class: "form-label"
            = f.text_area :admin_notes, class: "form-control", rows: 2

      .card.shadow-sm.border-0.mb-4
        .card-header.fw-semibold Property Address
        .card-body
          = f.fields_for :address, work_order.address || work_order.build_address do |a|
            .row.g-2
              .col-12.mb-2
                = a.label :street_address, class: "form-label form-label-sm"
                = a.text_field :street_address, class: "form-control form-control-sm"
              .col-md-4.mb-2
                = a.label :city, class: "form-label form-label-sm"
                = a.text_field :city, class: "form-control form-control-sm"
              .col-md-3.mb-2
                = a.label :province, "Province / State", class: "form-label form-label-sm"
                = a.text_field :province, class: "form-control form-control-sm"
              .col-md-2.mb-2
                = a.label :postal_code, class: "form-label form-label-sm"
                = a.text_field :postal_code, class: "form-control form-control-sm"
              .col-md-3
                = a.label :country, class: "form-label form-label-sm"
                = a.text_field :country, class: "form-control form-control-sm"

      .card.shadow-sm.border-0.mb-4
        .card-header.fw-semibold Line Items
        .card-body
          .table-responsive
            %table.table.table-sm.align-middle
              %thead
                %tr
                  %th Description
                  %th.text-center{ style: "width:80px" } Qty
                  %th.text-end{ style: "width:150px" } Unit Price
                  %th{ style: "width:80px" }
              %tbody
                = f.fields_for :work_order_items, work_order.work_order_items.to_a + [WorkOrderItem.new] do |item_f|
                  = render "item_fields", f: item_f

      .card.shadow-sm.border-0
        .card-header.fw-semibold Payment Milestones
        .card-body
          %p.text-muted.small.mb-3
            Configure when invoices are generated. Percentages must total 100%.
            Trigger state determines which state transition creates the invoice.
          = f.fields_for :work_order_milestones, work_order.work_order_milestones.to_a + [WorkOrderMilestone.new] do |ms_f|
            = render "milestone_fields", f: ms_f

    .col-lg-4
      .card.shadow-sm.border-0.mb-4
        .card-header.fw-semibold Client
        .card-body
          .mb-3
            = f.label :user_id, "Linked Account (optional)", class: "form-label"
            = f.number_field :user_id, class: "form-control", placeholder: "User ID (optional)"
          %hr
          %p.text-muted.small.mb-2 Or enter guest contact details:
          .mb-3
            = f.label :client_name, class: "form-label"
            = f.text_field :client_name, class: "form-control"
          .mb-3
            = f.label :client_email, class: "form-label"
            = f.email_field :client_email, class: "form-control"
          .mb-0
            = f.label :client_phone, class: "form-label"
            = f.telephone_field :client_phone, class: "form-control"

  .mt-4.d-flex.gap-2
    = f.submit class: "btn btn-primary"
    = link_to "Cancel", admin_work_orders_path, class: "btn btn-outline-secondary"
