- f = local_assigns.fetch(:f, nil)
- if f
  %tr
    %td= f.text_field :name, class: "form-control form-control-sm", placeholder: "Description"
    %td= f.number_field :quantity, class: "form-control form-control-sm text-center", min: 1, value: f.object.quantity || 1
    %td
      .input-group.input-group-sm
        %span.input-group-text $
        = f.text_field :unit_price, class: "form-control form-control-sm text-end", placeholder: "0.00", value: f.object.unit_price&.to_f
    %td
      - unless f.object.new_record?
        .form-check
          = f.check_box :_destroy, class: "form-check-input"
          = f.label :_destroy, "Remove", class: "form-check-label"
- else
  = form_with url: admin_work_order_work_order_item_path(work_order, item), method: :patch do |pf|
    %tr
      %td= pf.text_field :name, value: item.name, class: "form-control form-control-sm", placeholder: "Description"
      %td= pf.number_field :quantity, value: item.quantity, class: "form-control form-control-sm text-center", min: 1
      %td
        .input-group.input-group-sm
          %span.input-group-text $
          = pf.text_field :unit_price, value: item.unit_price&.to_f, class: "form-control form-control-sm text-end", placeholder: "0.00"
      %td
        = link_to admin_work_order_work_order_item_path(work_order, item), data: { turbo_method: :delete }, class: "btn btn-sm btn-outline-danger" do
          %i.bi.bi-trash
