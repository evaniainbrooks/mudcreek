.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-robot.me-2
    AI Import

= turbo_stream_from "listing_inference_batch_#{@batch.id}"

= render "progress", batch: @batch

- if @batch.done?
  .d-flex.gap-2.mt-3
    = link_to admin_listings_path(q: { lot_id_eq: @batch.lot_id }), class: "btn btn-primary" do
      %i.bi.bi-list-ul.me-1
      View Created Listings
    = link_to new_admin_listing_inference_batch_path, class: "btn btn-outline-secondary" do
      %i.bi.bi-robot.me-1
      New AI Import
