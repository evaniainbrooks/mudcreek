.d-flex.align-items-center.gap-3.mb-4.flex-wrap
  %h1.h3.mb-0
    %i.bi.bi-receipt.me-2
    Invoice
  %span.badge.text-bg-secondary.fs-6= @invoice.number
  = invoice_status_badge(@invoice)

.page-container.p-4
  .row.g-4
    .col-12.col-lg-8
      .card.shadow-sm.border-0.mb-4
        .card-header.fw-semibold Buyer
        .card-body
          %dl.row.mb-0
            %dt.col-sm-3 Name
            %dd.col-sm-9= link_to @invoice.user.name, admin_user_path(@invoice.user)
            %dt.col-sm-3 Email
            %dd.col-sm-9= mail_to @invoice.user.email_address

      .card.shadow-sm.border-0.mb-4
        .card-header.fw-semibold Source
        .card-body
          %dl.row.mb-0
            - if @invoice.auction
              %dt.col-sm-3 Type
              %dd.col-sm-9 Auction
              %dt.col-sm-3 Name
              %dd.col-sm-9= link_to @invoice.auction.name, admin_auction_path(@invoice.auction)
            - elsif @invoice.offer
              %dt.col-sm-3 Type
              %dd.col-sm-9 Offer
              %dt.col-sm-3 Listing
              %dd.col-sm-9= link_to @invoice.offer.listing.name, admin_listing_path(@invoice.offer.listing)
              %dt.col-sm-3 Offer amount
              %dd.col-sm-9= humanized_money_with_symbol(@invoice.offer.amount)

      .card.shadow-sm.border-0
        .card-header.fw-semibold Items
        .card-body.p-0
          .table-responsive
            %table.table.align-middle.mb-0
              %thead
                %tr
                  %th.ps-3 Item
                  %th.text-end.pe-3 Amount
              %tbody
                - @invoice.invoice_items.each do |item|
                  %tr
                    %td.ps-3.fw-semibold= item.name
                    %td.text-end.pe-3= humanized_money_with_symbol(item.amount)

    .col-12.col-lg-4
      .card.shadow-sm.border-0.mb-4
        .card-header.fw-semibold Summary
        .card-body
          %table.table.table-sm.mb-0
            %tbody
              %tr.border-top.border-2.fw-bold
                %td Total
                %td.text-end= humanized_money_with_symbol(@invoice.total)

      .card.shadow-sm.border-0.mb-4
        .card-header.fw-semibold Details
        .card-body
          %dl.row.mb-0
            %dt.col-6 Issued
            %dd.col-6.text-end= @invoice.created_at.to_fs(:long)
            %dt.col-6 Updated
            %dd.col-6.text-end= @invoice.updated_at.to_fs(:long)

      .card.shadow-sm.border-0.mb-4
        .card-header.fw-semibold Status
        .card-body
          = form_with model: @invoice, url: admin_invoice_path(@invoice), method: :patch do |f|
            .d-flex.gap-2
              = f.select :status, Invoice.statuses.keys.map { |s| [s.capitalize, s] },
                  { selected: @invoice.status },
                  class: "form-select form-select-sm"
              = f.submit "Save", class: "btn btn-primary btn-sm"

      - if policy(@invoice).update?
        .card.shadow-sm.border-0.mb-4
          .card-header.fw-semibold Admin Notes
          .card-body
            = form_with model: @invoice, url: admin_invoice_path(@invoice), method: :patch do |f|
              = f.text_area :admin_notes, class: "form-control form-control-sm mb-2", rows: 4, placeholder: "Internal notes…"
              = f.submit "Save notes", class: "btn btn-primary btn-sm w-100"

        .card.shadow-sm.border-0
          .card-header.fw-semibold Receipt
          .card-body
            - if @invoice.receipt.attached?
              .mb-3
                - blob = @invoice.receipt.blob
                - if blob.content_type.start_with?("image/")
                  = image_tag rails_blob_path(@invoice.receipt, disposition: "inline"),
                      class: "img-fluid rounded mb-2", style: "max-height: 200px"
                  %br
                - = link_to blob.filename.to_s, rails_blob_path(@invoice.receipt, disposition: "attachment"),
                    class: "text-decoration-none small"
                  %i.bi.bi-download.ms-1
              = form_with model: @invoice, url: admin_invoice_path(@invoice), method: :patch do |f|
                = f.hidden_field :remove_receipt, value: "1"
                %button.btn.btn-sm.btn-outline-danger.w-100{ type: "submit",
                    data: { turbo_confirm: "Remove the receipt attachment?" } }
                  %i.bi.bi-trash.me-1
                  Remove receipt
            = form_with model: @invoice, url: admin_invoice_path(@invoice), method: :patch,
                html: { multipart: true, class: "mt-3" } do |f|
              = f.label :receipt, @invoice.receipt.attached? ? "Replace receipt" : "Attach receipt",
                  class: "form-label form-label-sm"
              = f.file_field :receipt, class: "form-control form-control-sm mb-2",
                  accept: "image/*,application/pdf"
              = f.submit "Upload", class: "btn btn-primary btn-sm w-100"

  .mt-3
    = link_to admin_invoices_path, class: "btn btn-outline-secondary" do
      %i.bi.bi-arrow-left.me-1
      Back to Invoices
