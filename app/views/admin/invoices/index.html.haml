.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-receipt.me-2
    Invoices

.page-container.p-4
  .card.shadow-sm.border-0.mb-4
    .card-header.fw-semibold Filter Records
    .card-body
      = search_form_for @q, url: admin_invoices_path, html: { class: "row g-2 align-items-end" } do |f|
        .col-md-4
          = f.label :user_email_address_cont, "User Email", class: "form-label form-label-sm"
          = f.search_field :user_email_address_cont,
              class: "form-control form-control-sm", placeholder: "Search by email..."
        .col-md-4
          = f.label :auction_name_cont, "Auction", class: "form-label form-label-sm"
          = f.search_field :auction_name_cont,
              class: "form-control form-control-sm", placeholder: "Search by auction name..."
        .col-md-2
          = f.label :status_eq, "Status", class: "form-label form-label-sm"
          = f.select :status_eq, Invoice.statuses.keys.map { |s| [s.capitalize, s] },
              { include_blank: "Any" }, class: "form-select form-select-sm"
        .col-auto
          %button.btn.btn-outline-primary.btn-sm{ type: "submit" }
            %i.bi.bi-search.me-1
            Search
        .col-auto
          = link_to "Clear", admin_invoices_path, class: "btn btn-outline-secondary btn-sm"

  = render FilterInfoComponent.new(count: @filter_count, total: @filter_total,
      label: "invoices", clear_url: admin_invoices_path)

  %div{data: { controller: "infinite-scroll" }}
    = render_invoices_table(invoices: @invoices, q: @q)
    = render "admin/invoices/sentinel", pagy: @pagy, q: params[:q]
