.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-calendar3.me-2
    = @schedule.name.presence || "Schedule"
  %small.text-muted= @location.name

.page-container
  %ul.nav.nav-tabs.px-4.pt-3{ role: "tablist" }
    %li.nav-item{ role: "presentation" }
      %button.nav-link{ id: "events-tab", type: "button", role: "tab",
          class: @schedule.errors.any? ? "" : "active",
          data: { bs_toggle: "tab", bs_target: "#events-pane" },
          aria: { controls: "events-pane", selected: !@schedule.errors.any? } }
        %i.bi.bi-calendar-event.me-1
        Events
        %span.badge.bg-secondary.ms-1= @events.count
    %li.nav-item{ role: "presentation" }
      %button.nav-link{ id: "calendar-tab", type: "button", role: "tab",
          data: { bs_toggle: "tab", bs_target: "#calendar-pane" },
          aria: { controls: "calendar-pane", selected: false } }
        %i.bi.bi-calendar3.me-1
        Calendar
    %li.nav-item{ role: "presentation" }
      %button.nav-link{ id: "edit-tab", type: "button", role: "tab",
          class: @schedule.errors.any? ? "active" : "",
          data: { bs_toggle: "tab", bs_target: "#edit-pane" },
          aria: { controls: "edit-pane", selected: @schedule.errors.any? } }
        %i.bi.bi-pencil.me-1
        Edit

  .p-4
    .tab-content
      #events-pane.tab-pane.fade{ class: (@schedule.errors.any? ? "" : "show active"), role: "tabpanel", aria: { labelledby: "events-tab" } }
        .card.shadow-sm.border-0
          .card-header.fw-semibold.d-flex.justify-content-between.align-items-center
            %span
              %i.bi.bi-calendar-event.me-1
              Events
            = link_to new_admin_location_schedule_schedule_event_path(@location, @schedule), class: "btn btn-primary btn-sm" do
              %i.bi.bi-plus-lg.me-1
              New Event
          .card-body.border-bottom.pb-3
            = form_with url: admin_location_schedule_path(@location, @schedule), method: :get, data: { turbo_frame: "_top" } do |f|
              .d-flex.flex-wrap.gap-2.align-items-end
                .flex-grow-1{ style: "min-width: 180px" }
                  = f.label :q, "Search", class: "form-label form-label-sm mb-1"
                  .input-group.input-group-sm
                    %span.input-group-text
                      %i.bi.bi-search
                    = f.text_field :q, value: @q, class: "form-control form-control-sm", placeholder: "Filter by name…"
                    - if @q.present?
                      = link_to admin_location_schedule_path(@location, @schedule, sort: @sort, direction: @direction, day: @day),
                          class: "btn btn-outline-secondary btn-sm" do
                        %i.bi.bi-x
                .flex-shrink-0
                  = f.label :day, "Day", class: "form-label form-label-sm mb-1"
                  = f.select :day,
                      [["Any day", ""], ["Sun", "SU"], ["Mon", "MO"], ["Tue", "TU"], ["Wed", "WE"], ["Thu", "TH"], ["Fri", "FR"], ["Sat", "SA"]],
                      { selected: @day },
                      class: "form-select form-select-sm"
                = f.hidden_field :sort, value: @sort
                = f.hidden_field :direction, value: @direction
                = f.submit "Filter", class: "btn btn-primary btn-sm align-self-end"

          - if @events.any?
            - evt_table = TableComponent.new(rows: @events)
            - evt_table.with_column(schedule_sort_link("summary", "Summary", @location, @schedule, sort: @sort, direction: @direction, q: @q, day: @day)) do |e|
              = link_to(e.summary.presence || content_tag(:em, "No title", class: "text-muted"),
                  edit_admin_location_schedule_schedule_event_path(@location, @schedule, e))
            - evt_table.with_column(schedule_sort_link("starts_at", "Starts", @location, @schedule,
                sort: @sort, direction: @direction, q: @q, day: @day)) do |e|
              - next unless e.starts_at
              = e.all_day? ? e.starts_at.utc.to_date.strftime("%b %-d, %Y") : e.starts_at.in_time_zone.strftime("%b %-d, %Y %-I:%M %p")
            - evt_table.with_column("Ends") do |e|
              - next unless e.ends_at
              = e.all_day? ? e.ends_at.utc.to_date.strftime("%b %-d, %Y") : e.ends_at.in_time_zone.strftime("%b %-d, %Y %-I:%M %p")
            - evt_table.with_column("All Day", html_class: "text-center") do |e|
              = content_tag(:i, "", class: "bi bi-check-lg text-success") if e.all_day?
            - evt_table.with_column("Recurrence") do |e|
              = content_tag(:code, e.rrule, class: "small") if e.rrule.present?
            - evt_table.with_column("Bookable", html_class: "text-center") do |e|
              = content_tag(:i, "", class: "bi bi-check-lg text-success") if e.bookable?
            - evt_table.with_column("", html_class: "text-end") do |e|
              = button_to admin_location_schedule_schedule_event_path(@location, @schedule, e),
                  method: :delete, class: "btn btn-outline-danger btn-sm",
                  form: { data: { turbo_confirm: "Delete this event?" } } do
                = content_tag(:i, "", class: "bi bi-trash")
            = render evt_table
          - else
            .card-body
              %p.text-muted.mb-0 No events in this schedule.

      #calendar-pane.tab-pane.fade{ role: "tabpanel", aria: { labelledby: "calendar-tab" } }
        = render LocationScheduleComponent.new(location: @location, calendar_service: ScheduleEventsCalendarService.new(@schedule), view: @calendar_view)

      #edit-pane.tab-pane.fade{ class: (@schedule.errors.any? ? "show active" : ""), role: "tabpanel", aria: { labelledby: "edit-tab" } }
        .card.shadow-sm.border-0
          .card-body.p-4
            = render "form"

        %dl.row.text-muted.small.mt-3
          %dt.col-sm-3 Last synced
          %dd.col-sm-9
            - if @schedule.last_synced_at
              = @schedule.last_synced_at.strftime("%B %-d, %Y at %l:%M %p")
            - else
              Never

.mt-3
  = link_to admin_location_path(@location, anchor: "schedules-pane"), class: "btn btn-outline-secondary" do
    %i.bi.bi-arrow-left.me-1
    Back to Location
