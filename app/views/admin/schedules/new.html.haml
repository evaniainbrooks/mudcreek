.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-calendar-plus.me-2
    New Schedule
  %small.text-muted= @location.name

.page-container.p-4
  = form_with model: [:admin, @location, @schedule] do |f|
    - if @schedule.errors.any?
      .alert.alert-danger.mb-4
        %ul.mb-0
          - @schedule.errors.full_messages.each do |msg|
            %li= msg

    %fieldset.card.shadow-sm.border-0.mb-4
      %legend.card-header.fw-semibold
        %i.bi.bi-calendar3.me-1
        Schedule Details
      .card-body.p-4
        .mb-3
          = f.label :name, class: "form-label"
          = f.text_field :name, class: "form-control #{'is-invalid' if @schedule.errors[:name].any?}",
              placeholder: "e.g. Spring Classes"
          .form-text Leave blank to use the calendar's own name.
        .mb-3
          = f.label :source_url, "iCal / ICS Feed URL", class: "form-label"
          = f.url_field :source_url, class: "form-control #{'is-invalid' if @schedule.errors[:source_url].any?}",
              placeholder: "https://..."
          .form-text Optional. Paste a public .ics URL to import events automatically.
        .mb-0
          .form-check
            = f.check_box :shared, class: "form-check-input"
            = f.label :shared, class: "form-check-label"
          .form-text Allow this schedule to be visible outside the admin.

    .d-flex.gap-2
      = f.submit "Create Schedule", class: "btn btn-primary"
      = link_to "Cancel", admin_location_path(@location, anchor: "schedules-pane"), class: "btn btn-outline-secondary"
