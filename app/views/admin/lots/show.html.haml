.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-box-seam.me-2
    = @lot.name
  = button_to admin_lot_path(@lot), method: :delete, class: "btn btn-outline-danger btn-sm",
      form: { data: { turbo_confirm: "Delete lot \"#{@lot.name}\"? Listings will be unassigned." } } do
    %i.bi.bi-trash.me-1
    Delete

.page-container
  %ul.nav.nav-tabs.px-4.pt-3{ role: "tablist" }
    %li.nav-item{ role: "presentation" }
      %button.nav-link.active{id: "details-tab", type: "button", role: "tab",
        data: { bs_toggle: "tab", bs_target: "#details-pane" },
        aria: { controls: "details-pane", selected: "true" }}
        %i.bi.bi-info-circle.me-1
        Details
    %li.nav-item{ role: "presentation" }
      %button.nav-link{id: "edit-tab", type: "button", role: "tab",
        data: { bs_toggle: "tab", bs_target: "#edit-pane" },
        aria: { controls: "edit-pane", selected: "false" }}
        %i.bi.bi-pencil.me-1
        Edit
    %li.nav-item{ role: "presentation" }
      %button.nav-link{id: "listings-tab", type: "button", role: "tab",
        data: { bs_toggle: "tab", bs_target: "#listings-pane" },
        aria: { controls: "listings-pane", selected: "false" }}
        %i.bi.bi-tag.me-1
        Listings
        %span.badge.text-bg-secondary.ms-1= @listings.size
    %li.nav-item{ role: "presentation" }
      %button.nav-link{id: "settlement-tab", type: "button", role: "tab",
        data: { bs_toggle: "tab", bs_target: "#settlement-pane" },
        aria: { controls: "settlement-pane", selected: "false" }}
        %i.bi.bi-receipt.me-1
        Settlement

  .p-4
    .tab-content
      #details-pane.tab-pane.fade.show.active{ role: "tabpanel", aria: { labelledby: "details-tab" } }
        .card.shadow-sm.border-0.mb-4
          .card-header.fw-semibold Basic Info
          .card-body
            %dl.row.mb-0
              %dt.col-sm-3 Name
              %dd.col-sm-9= @lot.name

              %dt.col-sm-3 Number
              %dd.col-sm-9= lot_number_badge(@lot)

              %dt.col-sm-3 Owner
              %dd.col-sm-9= mail_to @lot.owner.email_address

              %dt.col-sm-3 State
              %dd.col-sm-9
                %span.badge{ class: lot_state_badge_class(@lot) }= @lot.state.to_s.humanize

              %dt.col-sm-3 Admin Notes
              %dd.col-sm-9= @lot.admin_notes.presence || "—"

        .card.shadow-sm.border-0.mb-4
          .card-header.fw-semibold Financial
          .card-body
            %dl.row.mb-0
              %dt.col-sm-3 Commission Rate
              %dd.col-sm-9= @lot.commission_rate ? "#{@lot.commission_rate}%" : "—"

              %dt.col-sm-3 Seller Fee
              %dd.col-sm-9= @lot.seller_fee ? humanized_money_with_symbol(@lot.seller_fee) : "—"

              %dt.col-sm-3 Payout Amount
              %dd.col-sm-9= @lot.payout_amount_cents ? humanized_money_with_symbol(@lot.payout_amount) : "—"

        - if @lot.address&.any?
          .card.shadow-sm.border-0
            .card-header.fw-semibold Location
            .card-body
              %address.mb-0
                - if @lot.address.street_address.present?
                  = @lot.address.street_address
                  %br/
                - city_line = [ @lot.address.city, @lot.address.province ].compact_blank.join(", ")
                - city_line += "  #{@lot.address.postal_code}" if @lot.address.postal_code.present?
                - if city_line.present?
                  = city_line
                  %br/
                - if @lot.address.country.present?
                  = @lot.address.country

      #edit-pane.tab-pane.fade{ role: "tabpanel", aria: { labelledby: "edit-tab" } }
        = render "edit_pane", lot: @lot, users: @users
      #listings-pane.tab-pane.fade{ role: "tabpanel", aria: { labelledby: "listings-tab" } }
        - if @listings.empty?
          .py-3.text-muted No listings assigned to this lot.
        - else
          = render_listings_table(listings: @listings, q: nil)

      #settlement-pane.tab-pane.fade{ role: "tabpanel", aria: { labelledby: "settlement-tab" } }
        - if @settlement.nil?
          .py-3.text-muted.alert.alert-info No settlement has been created for this lot yet.
        - else
          .card.shadow-sm.border-0.mb-4
            .card-header.fw-semibold Line Items
            .card-body.p-0
              %table.table.table-sm.mb-0
                %thead.thead-secondary
                  %tr
                    %th Description
                    %th Type
                    %th.text-end Amount
                %tbody
                  - @settlement_line_items.each do |item|
                    - deduction = %w[seller_commission seller_fee].include?(item.line_item_type)
                    %tr
                      %td= item.description
                      %td
                        - badge_class = deduction ? "text-bg-danger" : "text-bg-success"
                        %span.badge{ class: badge_class }= item.line_item_type.humanize
                      %td.text-end{ class: deduction ? "text-danger" : "" }
                        = deduction ? "−" : ""
                        = humanized_money_with_symbol(item.amount)
                %tfoot
                  %tr.fw-bold
                    %td{ colspan: 2 } Net Payout
                    %td.text-end= humanized_money_with_symbol(@settlement.net_payout)
          - if @lot.paid?
            .alert.alert-success
              %strong Paid
              — #{humanized_money_with_symbol(@lot.payout_amount)} sent on #{@lot.paid_at.to_fs(:long)}
          - elsif @settlement.net_payout_cents > 0
            = button_to "Mark as Paid", pay_admin_lot_settlement_path(@lot),
                method: :post,
                class: "btn btn-success",
                form: { data: { turbo_confirm: "Record a payout of #{humanized_money_with_symbol(@settlement.net_payout)} to #{@lot.owner.email_address}?" } }

    .mt-3
      = link_to admin_lots_path, class: "btn btn-outline-secondary" do
        %i.bi.bi-arrow-left.me-1
        Back to Lots
