= form_with model: [:admin, lot], url: admin_lot_path(lot), method: :patch do |f|
  - if lot.errors.any?
    .alert.alert-danger.mb-4
      = lot.errors.full_messages.to_sentence

  %fieldset.card.shadow-sm.border-0.mb-4
    %legend.card-header.fw-semibold Basic Info
    .card-body.p-4
      .row.g-3
        .col-sm-6
          = f.label :name, class: "form-label required"
          = f.text_field :name, class: "form-control #{'is-invalid' if lot.errors[:name].any?}", required: true
          - if lot.errors[:name].any?
            .invalid-feedback= lot.errors[:name].to_sentence
        .col-sm-3
          = f.label :number, class: "form-label"
          = f.text_field :number,
              class: "form-control #{'is-invalid' if lot.errors[:number].any?}",
              placeholder: "e.g. 001"
        .col-sm-3
          = f.label :state, class: "form-label"
          = f.select :state, Lot.states.keys.map { |s| [s.humanize, s] }, {}, class: "form-select"
        .col-sm-6
          = f.label :owner_id, "Owner", class: "form-label"
          = f.select :owner_id, users.map { [it.email_address, it.id] },
              { prompt: "Select owner" },
              class: "form-select #{'is-invalid' if lot.errors[:owner_id].any?}"
          - if lot.errors[:owner_id].any?
            .invalid-feedback= lot.errors[:owner_id].to_sentence
        .col-12
          = f.label :admin_notes, class: "form-label"
          = f.text_area :admin_notes, class: "form-control", rows: 3
        .col-12
          .form-check
            = f.check_box :show_attribution, class: "form-check-input"
            = f.label :show_attribution, "Show attribution badge on listings", class: "form-check-label"

  %fieldset.card.shadow-sm.border-0.mb-4
    %legend.card-header.fw-semibold Financial
    .card-body.p-4
      .row.g-3
        .col-sm-4
          = f.label :commission_rate, "Commission Rate (%)", class: "form-label"
          .input-group
            = f.number_field :commission_rate,
                class: "form-control #{'is-invalid' if lot.errors[:commission_rate].any?}",
                min: 0, max: 100, step: 1, placeholder: "e.g. 15"
            %span.input-group-text %
          - if lot.errors[:commission_rate].any?
            .invalid-feedback= lot.errors[:commission_rate].to_sentence
        .col-sm-4
          = f.label :seller_fee, class: "form-label"
          .input-group
            %span.input-group-text $
            = f.number_field :seller_fee,
                value: lot.seller_fee&.to_f,
                class: "form-control #{'is-invalid' if lot.errors[:seller_fee].any?}",
                min: 0, step: "0.01", placeholder: "0.00"
          - if lot.errors[:seller_fee].any?
            .invalid-feedback= lot.errors[:seller_fee].to_sentence

  %fieldset.card.shadow-sm.border-0.mb-4
    %legend.card-header.fw-semibold Location
    .card-body.p-4
      = f.fields_for :address do |af|
        = render "shared/address_fields", af: af

  %fieldset.card.shadow-sm.border-0.mb-4
    %legend.card-header.fw-semibold Placeholder Image
    .card-body.p-4
      - if lot.listing_placeholder.attached?
        .d-flex.align-items-center.gap-3.mb-3
          = image_tag lot.listing_placeholder.variant(resize_to_fill: [160, 100]),
              class: "rounded", style: "object-fit: cover"
          = button_to admin_lot_listing_placeholder_path(lot),
              method: :delete,
              class: "btn btn-outline-danger btn-sm",
              form: { data: { turbo_confirm: "Remove placeholder image?" } } do
            %i.bi.bi-x-lg.me-1
            Remove
      - else
        = f.label :listing_placeholder, class: "form-label"
        = f.file_field :listing_placeholder, accept: "image/*", class: "form-control"

  .d-flex.gap-2
    = f.submit "Save Changes", class: "btn btn-primary"
    = link_to "Cancel", admin_lot_path(lot), class: "btn btn-outline-secondary"
