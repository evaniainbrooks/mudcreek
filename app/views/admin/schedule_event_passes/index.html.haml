.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-ticket-perforated.me-2
    Schedule Event Passes
  = link_to new_admin_schedule_event_pass_path, class: "btn btn-primary" do
    %i.bi.bi-plus-lg.me-1
    Issue Pass

.page-container.p-4
  .card.shadow-sm.border-0
    - if @passes.any?
      = schedule_event_passes_table(@passes, user: @user)
    - else
      .card-body
        %p.text-muted.mb-0 No passes issued yet.
