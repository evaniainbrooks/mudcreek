.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-envelope-check.me-2
    Sender Domain

= turbo_stream_from "postmark_domain_#{Current.tenant.id}"

.page-container.p-4
  - if Rails.application.credentials.dig(:postmark, :account_token).blank?
    .alert.alert-danger
      %i.bi.bi-exclamation-triangle-fill.me-1
      Postmark credentials are not configured. Add
      %code postmark.account_token
      to your Rails credentials.
  - elsif Current.tenant.custom_domain.blank?
    .alert.alert-warning
      %i.bi.bi-exclamation-triangle.me-1
      No custom domain configured. Set one under
      = link_to "Tenant Settings", admin_tenant_path
      first.
  - elsif @postmark_domain.nil?
    .alert.alert-info.d-flex.align-items-center.gap-3
      .flex-grow-1
        %i.bi.bi-cloud-slash.me-1
        This domain has not been registered with Postmark yet.
      = button_to "Register Domain", admin_postmark_domains_path, method: :post, class: "btn btn-sm btn-primary flex-shrink-0"
  - else
    .row.g-4
      .col-lg-7
        .card.border-0.shadow-sm
          .card-body
            %h5.card-title.fw-semibold.mb-1 DNS Setup
            %p.text-muted.small.mb-3
              Add the following DNS records to
              %strong= @root_domain
              to enable authenticated sending via Postmark.

            - dkim_host    = @postmark_domain.api_response["dkim_pending_host"].presence || @postmark_domain.api_response["dkim_host"]
            - dkim_value   = @postmark_domain.api_response["dkim_pending_text_value"].presence || @postmark_domain.api_response["dkim_text_value"]
            - return_path  = @postmark_domain.api_response["return_path_domain"]

            - if dkim_host.present?
              %p.fw-semibold.mb-2 DKIM Record
              .table-responsive.mb-4
                %table.table.table-sm.table-bordered.mb-0
                  %thead.table-light
                    %tr
                      %th Type
                      %th Name
                      %th Value
                  %tbody
                    %tr
                      %td TXT
                      %td
                        %code= dkim_host
                      %td
                        %code.text-break= dkim_value

            - if return_path.present?
              %p.fw-semibold.mb-2 Return Path Record
              .table-responsive
                %table.table.table-sm.table-bordered.mb-0
                  %thead.table-light
                    %tr
                      %th Type
                      %th Name
                      %th Value
                  %tbody
                    %tr
                      %td CNAME
                      %td
                        %code= return_path
                      %td
                        %code pm.mtasv.net

      .col-lg-5
        %p.text-muted.small.mb-2
          Domain:
          %strong= Current.tenant.custom_domain
          - if @root_domain != Current.tenant.custom_domain
            %span.text-muted.ms-1
              (registered as
              %strong= @root_domain
              )
        = render "domain_status", domain: @postmark_domain, checking: false
