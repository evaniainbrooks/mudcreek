.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-envelope-check.me-2
    Sender Signatures

= turbo_stream_from "sender_signatures_#{Current.tenant.id}"

.page-container.p-4
  .row.g-4.mb-4
    .col-lg-7
      .card.border-0.shadow-sm.mb-4
        .card-body
          %h5.card-title.fw-semibold.mb-1 Add Sender Signature
          %p.text-muted.small.mb-3
            Add an email address you want to send from. Postmark will send a confirmation email to that address.
            Once confirmed, add the DKIM and SPF records shown by Postmark to enable authenticated sending.

          = form_with url: admin_sender_signatures_path, method: :post do |f|
            .row.g-2.align-items-end
              .col-sm
                = f.label "sender_signature[name]", "From Name", class: "form-label"
                = f.text_field "sender_signature[name]", class: "form-control", placeholder: "Example Co.", required: true, autocomplete: "off"
              .col-sm
                = f.label "sender_signature[email_address]", "Email Address", class: "form-label"
                = f.email_field "sender_signature[email_address]", class: "form-control", placeholder: "hello@example.com", required: true, autocomplete: "off"
              .col-auto.align-self-end
                = f.submit "Add", class: "btn btn-primary"

    .col-lg-5
      .card.border-0.shadow-sm
        .card-body
          %h5.card-title.fw-semibold.mb-1 About Sender Signatures
          %p.text-muted.small.mb-0
            Sender signatures verify that you own the email addresses you send from.
            Each signature must be confirmed by clicking the link in the confirmation email.
            For best deliverability, also configure the DKIM and SPF records provided by Postmark.

  %h5.fw-semibold.mb-3 Signatures
  .table-responsive
    %table.table.table-hover.align-middle
      %thead.table-light
        %tr
          %th From
          %th Name
          %th.text-center Confirmed
          %th.text-center DKIM
          %th.text-center SPF
          %th
      %tbody#sender-signatures-list
        = render partial: "admin/sender_signatures/signature_row", collection: @signatures, as: :sender_signature
  - if @signatures.empty?
    %p.text-muted.small.mt-2 No sender signatures yet.
