%tr{id: "sender_signature_#{sender_signature.id}"}
  %td= sender_signature.email_address
  %td= sender_signature.name
  %td.text-center
    - if sender_signature.confirmed?
      %i.bi.bi-check-circle-fill.text-success
    - else
      %i.bi.bi-clock.text-muted
  %td.text-center
    - if sender_signature.dkim_verified?
      %i.bi.bi-check-circle-fill.text-success
    - else
      %i.bi.bi-x-circle.text-danger
  %td.text-center
    - if sender_signature.spf_verified?
      %i.bi.bi-check-circle-fill.text-success
    - else
      %i.bi.bi-x-circle.text-danger
  %td.text-end
    = button_to admin_sender_signature_path(sender_signature),
        method: :delete,
        class: "btn btn-outline-danger btn-sm",
        data: { turbo_confirm: "Delete sender signature #{sender_signature.email_address}? This cannot be undone." } do
      %i.bi.bi-trash
