.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-card-checklist.me-2
    = @subscription_plan.name
  = link_to admin_subscription_plans_path, class: "btn btn-outline-secondary btn-sm" do
    %i.bi.bi-arrow-left.me-1
    All Plans

.page-container.p-4
  .row.g-4
    .col-lg-4
      .card.shadow-sm.border-0.mb-4
        .card-header.fw-semibold Plan Details
        .card-body
          %dl.mb-0
            %dt.text-muted.small Subscription Type
            %dd= @subscription_plan.subscription_type.humanize
            %dt.text-muted.small Amount
            %dd= humanized_money_with_symbol(@subscription_plan.amount)
            - if @subscription_plan.description.present?
              %dt.text-muted.small Description
              %dd= @subscription_plan.description

      .card.shadow-sm.border-0
        .card-header.fw-semibold Add Subscription
        .card-body
          - if @subscription.errors.any?
            .alert.alert-danger.mb-3
              = @subscription.errors.full_messages.to_sentence
          = form_with model: [:admin, @subscription] do |f|
            = f.hidden_field :subscription_plan_id, value: @subscription_plan.id
            .mb-3
              = f.label :primary_user_id, "Primary Contact", class: "form-label required"
              = select_tag "subscription[primary_user_id]", options_from_collection_for_select(@users, :id, :email_address),
                  prompt: "Select a user...",
                  class: "form-select",
                  required: true
            .mb-3
              = f.label :renews_at, "First Renewal Date", class: "form-label required"
              = f.date_field :renews_at,
                  class: "form-control #{'is-invalid' if @subscription.errors[:renews_at].any?}",
                  required: true
            = f.submit "Add Subscription", class: "btn btn-primary btn-sm"

    .col-lg-8
      .card.shadow-sm.border-0
        .card-header.fw-semibold Subscriptions
        .card-body.p-0
          - if @subscriptions.empty?
            .p-4.text-muted No subscriptions yet.
          - else
            = render_subscriptions_table(@subscriptions)
