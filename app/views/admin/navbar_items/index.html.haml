- set_meta_tags title: "Navbar Items"

.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-list-ul.me-2
    Navbar Items
  = link_to new_admin_navbar_item_path, class: "btn btn-primary" do
    %i.bi.bi-plus-lg.me-1
    New Item

.page-container.p-4
  - if @navbar_items.empty?
    = render EmptyStateComponent.new(icon: "list-ul", message: "No navbar items yet.")
  - else
    .table-responsive
      %table.table.table-hover.align-middle.mb-0
        %thead.table-light
          %tr
            %th Pos
            %th Icon
            %th Title
            %th Path
            %th
        %tbody
          - @navbar_items.each do |item|
            %tr
              %td.text-muted.small= item.position
              %td
                - if item.icon.present?
                  %i{ class: "bi #{item.icon} fs-5" }
              %td.fw-semibold= item.title
              %td.text-muted.small.font-monospace= item.path
              %td.text-end
                = link_to edit_admin_navbar_item_path(item), class: "btn btn-sm btn-outline-secondary me-1" do
                  %i.bi.bi-pencil
                = link_to admin_navbar_item_path(item), class: "btn btn-sm btn-outline-danger",
                    data: { turbo_method: :delete, turbo_confirm: "Delete '#{item.title}'?" } do
                  %i.bi.bi-trash
