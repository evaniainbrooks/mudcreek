.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-journal-text.me-2
    Ledgers
  = link_to new_admin_ledger_path, class: "btn btn-primary btn-sm" do
    %i.bi.bi-plus-lg.me-1
    New Ledger

.page-container.p-4
  - if @ledgers.any?
    = render_ledgers_table(ledgers: @ledgers)
  - else
    .text-center.text-muted.py-5
      %i.bi.bi-journal-text.d-block.mb-2{ style: "font-size: 2.5rem" }
      No ledgers yet.
      = link_to "Create one", new_admin_ledger_path
