.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-journal-text.me-2
    = @ledger.name
  .d-flex.gap-2
    - if @ledger.shared?
      = link_to ledger_path(@ledger), class: "btn btn-outline-secondary btn-sm", target: "_blank" do
        %i.bi.bi-box-arrow-up-right.me-1
        Public View
    = link_to edit_admin_ledger_path(@ledger), class: "btn btn-outline-secondary btn-sm" do
      %i.bi.bi-pencil.me-1
      Edit
    = button_to admin_ledger_path(@ledger), method: :delete,
        class: "btn btn-outline-danger btn-sm",
        form: { class: "d-inline", data: { turbo_confirm: "Delete \"#{@ledger.name}\" and all its entries?" } } do
      %i.bi.bi-trash.me-1
      Delete

- if @ledger.description.present?
  .text-muted.mb-2= @ledger.description
.text-muted.small.mb-4
  - if @ledger.location
    %i.bi.bi-geo-alt.me-1
    = @ledger.location.name
    &mdash;
  Tax rate:
  = number_to_percentage(@ledger.tax_rate * 100, precision: 4, strip_insignificant_zeros: true)

.page-container.p-4
  = render "entries_section",
      ledger: @ledger,
      entries: @entries,
      total_credits: @total_credits,
      total_debits: @total_debits,
      balance: @balance,
      total_subtotal: @total_subtotal,
      total_tax_credits: @total_tax_credits,
      total_tax_debits: @total_tax_debits,
      tax_balance: @tax_balance,
      entry: @entry

.mt-3
  = link_to admin_ledgers_path, class: "btn btn-outline-secondary" do
    %i.bi.bi-arrow-left.me-1
    Back to Ledgers
