= form_with model: [:admin, ledger], class: "needs-validation" do |f|
  - if ledger.errors.any?
    .alert.alert-danger.mb-4
      = ledger.errors.full_messages.to_sentence

  %fieldset.card.shadow-sm.border-0
    %legend.card-header.fw-semibold
      %i.bi.bi-journal-text.me-1
      Ledger
    .card-body.p-4
      .mb-3
        = f.label :name, class: "form-label required"
        = f.text_field :name, class: "form-control #{'is-invalid' if ledger.errors[:name].any?}", required: true
        - if ledger.errors[:name].any?
          .invalid-feedback= ledger.errors[:name].to_sentence

      .mb-3
        = f.label :description, class: "form-label"
        = f.text_area :description, class: "form-control", rows: 3

      .mb-3
        = f.label :location_id, "Location", class: "form-label"
        = f.select :location_id,
            locations.map { |l| [l.name, l.id] },
            { include_blank: "— None —" },
            class: "form-select"
        .form-text Tax rate will be taken from the selected location, otherwise the default #{(SALES_TAX_RATE * 100).to_f}% applies.

      .mb-0
        .form-check
          = f.check_box :shared, class: "form-check-input"
          = f.label :shared, class: "form-check-label"
          .form-text Allow public access to this ledger's entry form.

  .d-flex.gap-2.mt-4
    = f.submit class: "btn btn-primary"
    = link_to "Cancel", ledger.persisted? ? admin_ledger_path(ledger) : admin_ledgers_path, class: "btn btn-outline-secondary"
