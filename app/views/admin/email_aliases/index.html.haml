.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-envelope-at.me-2
    Email Aliases

= turbo_stream_from "improvmx_check_#{Current.tenant.id}"

.page-container.p-4
  - if Current.tenant.custom_domain.blank?
    .alert.alert-warning
      %i.bi.bi-exclamation-triangle.me-1
      No custom domain configured. Set one under
      = link_to "Tenant Settings", admin_tenant_path
      first.
  - else
    .mb-3
      %span.text-muted Domain:
      %strong.ms-1= Current.tenant.custom_domain

    = render "status", result: @result, tenant: Current.tenant
