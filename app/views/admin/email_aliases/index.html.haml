.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-envelope-at.me-2
    Email Aliases

= turbo_stream_from "improvmx_check_#{Current.tenant.id}"
= turbo_stream_from "email_aliases_#{Current.tenant.id}"

.page-container.p-4
  - if Current.tenant.custom_domain.blank?
    .alert.alert-warning
      %i.bi.bi-exclamation-triangle.me-1
      No custom domain configured. Set one under
      = link_to "Tenant Settings", admin_tenant_path
      first.
  - elsif @improvmx_domain.nil?
    .alert.alert-info.d-flex.align-items-center.gap-3
      .flex-grow-1
        %i.bi.bi-cloud-slash.me-1
        This domain has not been registered with ImprovMX yet.
      = button_to "Register Domain", admin_improvmx_domains_path, method: :post, class: "btn btn-sm btn-primary flex-shrink-0"
  - else
    .row.g-4.mb-4
      .col-lg-7
        .card.border-0.shadow-sm.mb-4
          .card-body
            %h5.card-title.fw-semibold.mb-1 Setup Instructions
            %p.text-muted.small.mb-3
              Add the following DNS records to
              %strong= @root_domain
              at your DNS provider, then click Verify below. These records allow ImprovMX to receive email on your behalf.

            %p.fw-semibold.mb-2 MX Records
            .table-responsive.mb-4
              %table.table.table-sm.table-bordered.mb-0
                %thead.table-light
                  %tr
                    %th Type
                    %th Name
                    %th Value
                    %th Priority
                %tbody
                  %tr
                    %td MX
                    %td
                      %code @
                    %td
                      %code mx1.improvmx.com
                    %td 10
                  %tr
                    %td MX
                    %td
                      %code @
                    %td
                      %code mx2.improvmx.com
                    %td 20

            %p.fw-semibold.mb-2 SPF Record
            .table-responsive
              %table.table.table-sm.table-bordered.mb-0
                %thead.table-light
                  %tr
                    %th Type
                    %th Name
                    %th Value
                %tbody
                  %tr
                    %td TXT
                    %td
                      %code @
                    %td
                      %code v=spf1 include:spf.improvmx.com ~all

            .alert.alert-info.small.mb-0.mt-3
              %i.bi.bi-info-circle.me-1
              If you already have an SPF record, add
              %code include:spf.improvmx.com
              to it rather than creating a second TXT record.

        - if @improvmx_domain&.verified?
          .card.border-0.shadow-sm
            .card-body
              %h5.card-title.fw-semibold.mb-3 New Alias
              = form_with url: admin_email_aliases_path, method: :post do |f|
                .row.g-2.align-items-end
                  .col-sm
                    = f.label "email_alias[alias]", "Alias", class: "form-label"
                    .input-group
                      = f.text_field "email_alias[alias]", class: "form-control", placeholder: "hello", required: true, autocomplete: "off"
                      %span.input-group-text @#{@root_domain}
                  .col-sm
                    = f.label "email_alias[forward]", "Forward to", class: "form-label"
                    = f.email_field "email_alias[forward]", class: "form-control", placeholder: "you@example.com", required: true, autocomplete: "off"
                  .col-auto.align-self-end
                    = f.submit "Create", class: "btn btn-primary"

      .col-lg-5
        %p.text-muted.small.mb-2
          Domain:
          %strong= Current.tenant.custom_domain
          - if @root_domain != Current.tenant.custom_domain
            %span.text-muted.ms-1
              (checking as
              %strong= @root_domain
              )
        = render "status", domain: @improvmx_domain, checking: false

    %h5.fw-semibold.mb-3 Aliases
    .table-responsive
      %table.table.table-hover.align-middle
        %thead.table-light
          %tr
            %th Alias
            %th Forward to
            %th
        %tbody#email-aliases-list
          = render partial: "admin/email_aliases/alias_row", collection: @aliases, as: :email_alias
    - if @aliases.empty?
      %p.text-muted.small.mt-2 No aliases yet.
