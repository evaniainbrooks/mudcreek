%fieldset.card.shadow-sm.border-0.mb-4
  %legend.card-header.fw-semibold
    %i.bi.bi-toggles.me-2
    Features
  .card-body.p-4
    = form.fields_for :features do |ff|
      - Tenant::Features::DESCRIPTIONS.each_with_index do |(key, description), i|
        .form-check{ class: i < Tenant::Features::DESCRIPTIONS.size - 1 ? "mb-3" : "mb-0" }
          = ff.check_box key, class: "form-check-input"
          = ff.label key, key.to_s.humanize, class: "form-check-label"
          .form-text= description
