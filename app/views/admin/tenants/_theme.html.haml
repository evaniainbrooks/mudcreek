%fieldset.card.shadow-sm.border-0.mb-4
  %legend.card-header.fw-semibold
    %i.bi.bi-palette.me-2
    Theme Colors
  .card-body.p-4
    %p.text-muted.small.mb-4
      Customize your brand colors. Leave fields blank to use the platform defaults.
      Changes take effect immediately on save.

    .row.g-3
      .col-sm-6.col-lg-4
        = form.label :primary_color, "Primary Color", class: "form-label"
        .form-text.mb-1 Buttons, badges, and highlights.
        .input-group
          %span.input-group-text.p-1
            %input{type: "color", id: "primary_color_picker",
              value: tenant.primary_color.presence || "#355E3B",
              style: "width: 2rem; height: 2rem; border: none; padding: 0; cursor: pointer; background: none",
              oninput: "document.getElementById('tenant_primary_color').value = this.value"}
          = form.text_field :primary_color,
            class: "form-control font-monospace #{'is-invalid' if tenant.errors[:primary_color].any?}",
            placeholder: "#355E3B",
            pattern: "#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?",
            oninput: "document.getElementById('primary_color_picker').value = this.value"
          - if tenant.errors[:primary_color].any?
            .invalid-feedback= tenant.errors[:primary_color].to_sentence

      .col-sm-6.col-lg-4
        = form.label :secondary_color, "Secondary Color", class: "form-label"
        .form-text.mb-1 Navbar background and secondary elements.
        .input-group
          %span.input-group-text.p-1
