%fieldset.card.shadow-sm.border-0.mb-4
  %legend.card-header.fw-semibold
    %i.bi.bi-palette.me-2
    Theme Colors
  .card-body.p-4
    %p.text-muted.small.mb-4
      Customize your brand colors. Leave fields blank to use the platform defaults.
      Changes take effect immediately on save.

    .row.g-3
      - admin_tenant_color_fields.each do |cf|
        = render "admin/tenants/color_field",
            form: form,
            tenant: tenant,
            field: cf[:field],
            label: cf[:label],
            description: cf[:description],
            default: cf[:default]

    .mt-4.pt-3.border-top
      %p.text-muted.small.mb-2 Preview (uses your saved colors):
      .d-flex.flex-wrap.gap-2.align-items-center
        %button.btn.btn-primary{type: "button"} Primary button
        %button.btn.btn-secondary{type: "button"} Secondary button
        %button.btn.btn-outline-primary{type: "button"} Outline primary
        %span.badge.bg-primary Badge
        %a{href: "#"} Link color
