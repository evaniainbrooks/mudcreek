            pattern: "#[0-9a-fA-F]{3}([0-9a-fA-F]{3})?",
            oninput: "document.getElementById('secondary_color_picker').value = this.value"
          - if tenant.errors[:secondary_color].any?
            .invalid-feedback= tenant.errors[:secondary_color].to_sentence

