    .mt-4.pt-3.border-top
      %p.text-muted.small.mb-2 Preview (uses your saved colors):
      .d-flex.flex-wrap.gap-2.align-items-center
        %button.btn.btn-primary{type: "button"} Primary button
        %button.btn.btn-secondary{type: "button"} Secondary button
        %button.btn.btn-outline-primary{type: "button"} Outline primary
        %span.badge.bg-primary Badge
        %a{href: "#"} Link color
