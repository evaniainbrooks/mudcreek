%fieldset.card.shadow-sm.border-0.mb-4
  %legend.card-header.fw-semibold
    %i.bi.bi-person-badge.me-2
    Identity
  .card-body.p-4
    .mb-3
      = form.label :name, "Name", class: "form-label required"
      = form.text_field :name, required: true, class: "form-control"
    .mb-3
      = form.label :tagline, "Tagline", class: "form-label"
      = form.text_field :tagline, class: "form-control", placeholder: "Short phrase shown in the navigation bar"
    .mb-3
      = form.label :email_address, "Email Address", class: "form-label"
      = form.email_field :email_address,
        class: "form-control #{'is-invalid' if tenant.errors[:email_address].any?}"
      - if tenant.errors[:email_address].any?
        .invalid-feedback= tenant.errors[:email_address].to_sentence
    .mb-3
      = form.label :phone_number, "Phone Number", class: "form-label"
      = form.telephone_field :phone_number, class: "form-control"
    .mb-3
      = form.label :custom_domain, "Custom Domain", class: "form-label"
      = form.text_field :custom_domain,
        class: "form-control #{'is-invalid' if tenant.errors[:custom_domain].any?}",
        placeholder: "example.com"
      .form-text Used for generating absolute URLs in emails and broadcasts.
      - if tenant.errors[:custom_domain].any?
        .invalid-feedback= tenant.errors[:custom_domain].to_sentence
    .mb-0
      = form.label :description, class: "form-label"
      = form.rich_text_area :description,
        class: "form-control #{'is-invalid' if tenant.errors[:description].any?}"
      - if tenant.errors[:description].any?
        .invalid-feedback.d-block= tenant.errors[:description].to_sentence
%fieldset.card.shadow-sm.border-0
  %legend.card-header.fw-semibold
    %i.bi.bi-geo-alt.me-2
    Location
  .card-body.p-4
    = form.fields_for :address, form.object.address || form.object.build_address do |af|
      = render "shared/address_fields", af: af, col: "col-md-6"
    .mt-3.mb-0
      = form.label :timezone, class: "form-label"
      = form.time_zone_select :timezone, ActiveSupport::TimeZone.all, { include_blank: "— Inherit system default —" },
        class: "form-select"
