- set_meta_tags title: "Tenant Settings"

.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-globe.me-2
    Tenant Settings

= form_with model: @tenant, url: admin_tenant_path, method: :patch do |f|
  - if @tenant.errors.any?
    .alert.alert-danger.mb-4
      %ul.mb-0
        - @tenant.errors.full_messages.each do |msg|
          %li= msg

  .row.g-4
    .col-lg-6
      %fieldset.card.shadow-sm.border-0.mb-4
        %legend.card-header.fw-semibold
          %i.bi.bi-person-badge.me-2
          Identity
        .card-body.p-4
          .mb-3
            = f.label :name, "Name", class: "form-label"
            = f.text_field :name, required: true, class: "form-control"
          .mb-3
            = f.label :tagline, "Tagline", class: "form-label"
            = f.text_field :tagline, class: "form-control", placeholder: "Short phrase shown in the navigation bar"
          .mb-3
            = f.label :email_address, "Email Address", class: "form-label"
            = f.email_field :email_address,
              class: "form-control #{'is-invalid' if @tenant.errors[:email_address].any?}"
            - if @tenant.errors[:email_address].any?
              .invalid-feedback= @tenant.errors[:email_address].to_sentence
          .mb-3
            = f.label :phone_number, "Phone Number", class: "form-label"
            = f.telephone_field :phone_number, class: "form-control"
          .mb-3
            = f.label :custom_domain, "Custom Domain", class: "form-label"
            = f.text_field :custom_domain,
              class: "form-control #{'is-invalid' if @tenant.errors[:custom_domain].any?}",
              placeholder: "example.com"
            .form-text Used for generating absolute URLs in emails and broadcasts.
            - if @tenant.errors[:custom_domain].any?
              .invalid-feedback= @tenant.errors[:custom_domain].to_sentence
          .mb-0
            = f.label :description, class: "form-label"
            = f.rich_text_area :description,
              class: "form-control #{'is-invalid' if @tenant.errors[:description].any?}"
            - if @tenant.errors[:description].any?
              .invalid-feedback.d-block= @tenant.errors[:description].to_sentence

      %fieldset.card.shadow-sm.border-0
        %legend.card-header.fw-semibold
          %i.bi.bi-geo-alt.me-2
          Location
        .card-body.p-4
          = f.fields_for :address, f.object.address || f.object.build_address do |addr|
            .mb-3
              = addr.label :street_address, "Street Address", class: "form-label"
              = addr.text_field :street_address, class: "form-control"
            .row.g-3.mb-3
              .col-md-6
                = addr.label :city, "City", class: "form-label"
                = addr.text_field :city, class: "form-control"
              .col-md-6
                = addr.label :province, "Province / State", class: "form-label"
                = addr.text_field :province, class: "form-control"
            .row.g-3.mb-3
              .col-md-6
                = addr.label :postal_code, "Postal Code", class: "form-label"
                = addr.text_field :postal_code, class: "form-control"
              .col-md-6
                = addr.label :country, "Country", class: "form-label"
                = addr.text_field :country, class: "form-control"
          .mb-0
            = f.label :timezone, class: "form-label"
            = f.time_zone_select :timezone, ActiveSupport::TimeZone.all, { include_blank: "— Inherit system default —" },
              class: "form-select"

    .col-lg-6
      %fieldset.card.shadow-sm.border-0.mb-4
        %legend.card-header.fw-semibold
          %i.bi.bi-image.me-2
          Branding &amp; Media
        .card-body.p-4
          .mb-3
            = f.label :logo, class: "form-label"
            = f.file_field :logo,
              class: "form-control #{'is-invalid' if @tenant.errors[:logo].any?}",
              accept: "image/*"
            - if @tenant.errors[:logo].any?
              .invalid-feedback= @tenant.errors[:logo].to_sentence
            - if @tenant.logo.attached?
              .mt-2.d-flex.align-items-center.gap-2
                = image_tag @tenant.logo.variant(resize_to_fill: [120, 80]), class: "rounded", style: "object-fit: cover"
                = link_to admin_tenant_path(remove_logo: "1"),
                    class: "btn btn-sm btn-outline-danger",
                    data: { turbo_method: :patch, turbo_confirm: "Remove logo?" } do
                  %i.bi.bi-x-lg.me-1
                  Remove
          .mb-3
            = f.label :listing_placeholder, "Listing Placeholder Image", class: "form-label"
            .form-text.mb-1 Shown on listing cards when a listing has no images and no lot placeholder.
            = f.file_field :listing_placeholder,
              class: "form-control #{'is-invalid' if @tenant.errors[:listing_placeholder].any?}",
              accept: "image/*"
            - if @tenant.errors[:listing_placeholder].any?
              .invalid-feedback= @tenant.errors[:listing_placeholder].to_sentence
            - if @tenant.listing_placeholder.attached?
              .mt-2.d-flex.align-items-center.gap-2
                = image_tag @tenant.listing_placeholder.variant(resize_to_fill: [120, 80]), class: "rounded", style: "object-fit: cover"
                = link_to admin_tenant_path(remove_listing_placeholder: "1"),
                    class: "btn btn-sm btn-outline-danger",
                    data: { turbo_method: :patch, turbo_confirm: "Remove listing placeholder?" } do
                  %i.bi.bi-x-lg.me-1
                  Remove
          .mb-3
            = f.label :auction_placeholder, "Auction Placeholder Image", class: "form-label"
            .form-text.mb-1 Shown on auction cards when an auction has no poster.
            = f.file_field :auction_placeholder,
              class: "form-control #{'is-invalid' if @tenant.errors[:auction_placeholder].any?}",
              accept: "image/*"
            - if @tenant.errors[:auction_placeholder].any?
              .invalid-feedback= @tenant.errors[:auction_placeholder].to_sentence
            - if @tenant.auction_placeholder.attached?
              .mt-2.d-flex.align-items-center.gap-2
                = image_tag @tenant.auction_placeholder.variant(resize_to_fill: [120, 80]), class: "rounded", style: "object-fit: cover"
                = link_to admin_tenant_path(remove_auction_placeholder: "1"),
                    class: "btn btn-sm btn-outline-danger",
                    data: { turbo_method: :patch, turbo_confirm: "Remove auction placeholder?" } do
                  %i.bi.bi-x-lg.me-1
                  Remove
          .mb-0
            = f.label :default_terms_and_conditions, "Default Terms & Conditions", class: "form-label"
            = f.file_field :default_terms_and_conditions,
              class: "form-control #{'is-invalid' if @tenant.errors[:default_terms_and_conditions].any?}",
              accept: ".pdf,.doc,.docx"
            - if @tenant.errors[:default_terms_and_conditions].any?
              .invalid-feedback= @tenant.errors[:default_terms_and_conditions].to_sentence
            - if @tenant.default_terms_and_conditions.attached?
              .mt-2.d-flex.align-items-center.gap-2
                %i.bi.bi-file-earmark-text.text-muted
                = link_to @tenant.default_terms_and_conditions.filename.to_s,
                  rails_blob_path(@tenant.default_terms_and_conditions, disposition: "attachment"),
                  class: "text-decoration-none"
                = link_to admin_tenant_path(remove_default_terms_and_conditions: "1"),
                    class: "btn btn-sm btn-outline-danger",
                    data: { turbo_method: :patch, turbo_confirm: "Remove default terms & conditions?" } do
                  %i.bi.bi-x-lg.me-1
                  Remove

      %fieldset.card.shadow-sm.border-0{ data: { controller: "bid-increment-schedule" } }
        %legend.card-header.fw-semibold
          %i.bi.bi-ladder.me-2
          Default Bid Increment Schedule
        .card-body.p-4
          = f.fields_for :default_bid_increment_schedule do |s|
            .mb-2
              %small.text-muted
                Set price bands and required bid increments. Individual auctions can override this with their own schedule.
            .tier-container{ data: { bid_increment_schedule_target: "tiersContainer" } }
              .d-flex.gap-2.mb-1
                %small.text-muted.w-50 Min Amount (cents)
                %small.text-muted.w-50 Increment (cents)
              = s.fields_for :tiers do |t|
                = render "admin/shared/bid_increment_tier_fields", tier_form: t
            .mt-2
              %button.btn.btn-sm.btn-outline-secondary{ type: "button",
                data: { action: "bid-increment-schedule#addTier" } }
                %i.bi.bi-plus-lg.me-1
                Add Tier
            %template{ data: { bid_increment_schedule_target: "tierTemplate" } }
              - schedule = @tenant.default_bid_increment_schedule
              = s.fields_for :tiers, schedule.tiers.build, child_index: "new_tier" do |t|
                = render "admin/shared/bid_increment_tier_fields", tier_form: t

    .col-12
      %fieldset.card.shadow-sm.border-0{ data: { controller: "social-media-account" } }
        %legend.card-header.fw-semibold
          %i.bi.bi-share.me-2
          Social Media
        .card-body.p-4
          .d-flex.gap-2.mb-1
            %small.text-muted{ style: "width: 160px; flex-shrink: 0" } Platform
            %small.text-muted.flex-grow-1 Username / Slug
            %small.text-muted{ style: "width: 180px; flex-shrink: 0" } Icon class
          .account-container{ data: { social_media_account_target: "accountsContainer" } }
            = f.fields_for :social_media_accounts do |a|
              = render "admin/shared/social_media_account_fields", account_form: a
          .mt-2
            %button.btn.btn-sm.btn-outline-secondary{ type: "button",
              data: { action: "social-media-account#addAccount" } }
              %i.bi.bi-plus-lg.me-1
              Add Account
          %template{ data: { social_media_account_target: "accountTemplate" } }
            = f.fields_for :social_media_accounts, SocialMediaAccount.new, child_index: "new_account" do |a|
              = render "admin/shared/social_media_account_fields", account_form: a

    .col-12.d-flex.justify-content-end.gap-2
      = link_to "Cancel", admin_auctions_path, class: "btn btn-outline-secondary"
      = f.submit "Save changes", class: "btn btn-primary px-4"
