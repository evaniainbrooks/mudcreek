- today = Date.current
.card.shadow-sm.border-0.mb-4
  .table-responsive
    %table.table.table-hover.mb-0
      %thead.table-light
        %tr
          %th Type
          %th Name
          %th Parent
          %th Birthdate
          %th Turns
          %th Days Until
      %tbody
        - entries.each do |entry|
          :ruby
            record = entry[:record]
            next_bday = entry[:next_birthday]
            days_until = (next_bday - today).to_i
            birthdate = record.birthdate
            age = next_bday.year - birthdate.year
          %tr
            %td
              - if entry[:type] == :user
                %span.badge.text-bg-primary User
              - else
                %span.badge.text-bg-secondary Kid
            %td
              - if entry[:type] == :user
                = link_to record.name, admin_user_path(record), class: "text-decoration-none fw-medium"
              - else
                = link_to record.name, admin_user_path(record.user), class: "text-decoration-none fw-medium"
            %td
              - if entry[:type] == :kid
                = link_to record.user.name, admin_user_path(record.user), class: "text-decoration-none text-muted"
              - else
                %span.text-muted —
            %td= birthdate.strftime("%b %-d, %Y")
            %td= age
            %td
              - if days_until == 0
                %span.badge.text-bg-success Today!
              - else
                = pluralize(days_until, "day")
