.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-person-fill.me-2
    = @user.name

.page-container
  %ul.nav.nav-tabs.px-4.pt-3{ role: "tablist" }
    %li.nav-item{ role: "presentation" }
      %button.nav-link{id: "details-tab", type: "button", role: "tab",
          class: @active_tab == "details" ? "active" : "",
          data: { bs_toggle: "tab", bs_target: "#details-pane" },
          aria: { controls: "details-pane", selected: @active_tab == "details" }}
        %i.bi.bi-info-circle.me-1
        Details
    %li.nav-item{ role: "presentation" }
      %button.nav-link{id: "edit-tab", type: "button", role: "tab",
          class: @active_tab == "edit" ? "active" : "",
          data: { bs_toggle: "tab", bs_target: "#edit-pane" },
          aria: { controls: "edit-pane", selected: @active_tab == "edit" }}
        %i.bi.bi-pencil.me-1
        Edit
    %li.nav-item{ role: "presentation" }
      = link_to admin_user_path(@user, tab: "checkins"), class: "nav-link #{"active" if @active_tab == "checkins"}",
          id: "checkins-tab", role: "tab",
          aria: { controls: "checkins-pane", selected: @active_tab == "checkins" } do
        %i.bi.bi-clock-history.me-1
        Check-ins
    - if Current.tenant.features.ranks?
      %li.nav-item{ role: "presentation" }
        = link_to admin_user_path(@user, tab: "ranks"), class: "nav-link #{"active" if @active_tab == "ranks"}",
            id: "ranks-tab", role: "tab",
            aria: { controls: "ranks-pane", selected: @active_tab == "ranks" } do
          %i.bi.bi-award.me-1
          Ranks

  .p-4
    .tab-content
      #details-pane.tab-pane.fade{role: "tabpanel", aria: { labelledby: "details-tab" },
          class: @active_tab == "details" ? "show active" : ""}
        .card.shadow-sm.border-0
          .card-body
            %dl.row.mb-0
              %dt.col-sm-3 Name
              %dd.col-sm-9= @user.name

              %dt.col-sm-3 Email
              %dd.col-sm-9= mail_to @user.email_address

              %dt.col-sm-3 Role
              %dd.col-sm-9
                - if @user.role
                  = link_to @user.role.name, admin_role_permissions_path(@user.role)
                - else
                  %span.text-muted —

              %dt.col-sm-3 Status
              %dd.col-sm-9
                - if @user.activated?
                  %span.badge.text-bg-success Activated
                - else
                  %span.badge.text-bg-secondary Pending activation

              %dt.col-sm-3 Listings
              %dd.col-sm-9= link_to pluralize(@user.listings.count, "listing"), admin_listings_path(q: { owner_id_eq: @user.id })

              %dt.col-sm-3 Lots
              %dd.col-sm-9= link_to pluralize(@user.lots.count, "lot"), admin_lots_path(q: { owner_id_eq: @user.id })

              %dt.col-sm-3 Joined
              %dd.col-sm-9= @user.created_at.to_fs(:long)

              %dt.col-sm-3 Activated At
              %dd.col-sm-9
                - if @user.activated?
                  = @user.activated_at.to_fs(:long)
                - else
                  %span.text-muted —

              %dt.col-sm-3 Verification
              %dd.col-sm-9
                - if @user.verification
                  - if @user.verification.validated?
                    %span.badge.text-bg-success Validated
                    - if @user.verification.validated_by
                      %span.text-muted.ms-2.small by #{@user.verification.validated_by.name}
                  - else
                    %span.badge.text-bg-warning Not Validated
                - else
                  %span.text-muted —

              %dt.col-sm-3 Verification Document
              %dd.col-sm-9
                - if @user.verification&.verification_document&.attached?
                  = link_to @user.verification.verification_document.filename,
                      rails_blob_url(@user.verification.verification_document, disposition: "inline"),
                      target: "_blank", rel: "noopener noreferrer"
                - else
                  %span.text-muted —

      #edit-pane.tab-pane.fade{role: "tabpanel", aria: { labelledby: "edit-tab" },
          class: @active_tab == "edit" ? "show active" : ""}
        = render "edit_pane", user: @user, roles: @roles

      #checkins-pane.tab-pane.fade{role: "tabpanel", aria: { labelledby: "checkins-tab" },
          class: @active_tab == "checkins" ? "show active" : ""}
        - if @check_ins.any?
          .card.shadow-sm.border-0
            .card-body.p-0
              %table.table.table-hover.mb-0
                %thead
                  %tr
                    %th Date
                    %th Location
                    %th Event
                %tbody
                  - @check_ins.each do |ci|
                    %tr
                      %td
                        %time{ datetime: ci.created_at.iso8601 }
                          = ci.created_at.in_time_zone(Current.tenant.timezone).strftime("%b %-d, %Y %H:%M")
                      %td= ci.location.name
                      %td= ci.schedule_event&.summary || content_tag(:span, "—", class: "text-muted")
          - if @pagy_checkins.pages > 1
            .d-flex.gap-2.mt-3
              - if @pagy_checkins.previous
                = link_to admin_user_path(@user, tab: "checkins", page: @pagy_checkins.previous), class: "btn btn-sm btn-outline-secondary" do
                  %i.bi.bi-chevron-left.me-1
                  Previous
              - if @pagy_checkins.next
                = link_to admin_user_path(@user, tab: "checkins", page: @pagy_checkins.next), class: "btn btn-sm btn-outline-secondary" do
                  Next
                  %i.bi.bi-chevron-right.ms-1
        - else
          .text-muted.text-center.py-4 No check-ins yet.

      - if Current.tenant.features.ranks?
        #ranks-pane.tab-pane.fade{role: "tabpanel", aria: { labelledby: "ranks-tab" },
            class: @active_tab == "ranks" ? "show active" : ""}
          = render "ranks_pane", user: @user, disciplines: @disciplines, user_rank_awards: @user_rank_awards, kid_rank_awards: @kid_rank_awards

    .mt-3
      = link_to admin_users_path, class: "btn btn-outline-secondary" do
        %i.bi.bi-arrow-left.me-1
        Back to Users
