- set_meta_tags title: "Turnstile"

.d-flex.justify-content-between.align-items-center.mb-4
  %h1.h3.mb-0
    %i.bi.bi-shield-check.me-2
    Turnstile

= turbo_stream_from "cloudflare_turnstile_#{Current.tenant.id}"

.page-container.p-4
  - if Rails.application.credentials.dig(:cloudflare, :api_token).blank? || Rails.application.credentials.dig(:cloudflare, :account_id).blank?
    .alert.alert-danger
      %i.bi.bi-exclamation-triangle-fill.me-1
      Cloudflare credentials are not configured. Add
      %code cloudflare.api_token
      and
      %code cloudflare.account_id
      to your Rails credentials.
  - elsif Current.tenant.custom_domain.blank?
    .alert.alert-warning
      %i.bi.bi-exclamation-triangle.me-1
      No custom domain configured. Set one under
      = link_to "Tenant Settings", admin_tenant_path
      first.
  - elsif @widget.nil?
    .alert.alert-info.d-flex.align-items-center.gap-3
      .flex-grow-1
        %i.bi.bi-cloud-slash.me-1
        No Turnstile widget is attached to this tenant yet.
      = button_to "Provision Widget", admin_cloudflare_turnstile_widgets_path, method: :post, class: "btn btn-sm btn-primary flex-shrink-0"
  - else
    .row.g-4
      .col-lg-7
        .card.border-0.shadow-sm
          .card-body
            %h5.card-title.fw-semibold.mb-3 Widget Details
            %dl.mb-0
              %dt.text-muted.small Mode
              %dd.mb-3= @widget.mode&.humanize || "—"

              %dt.text-muted.small Registered Domains
              %dd.mb-3
                - if @widget.domains.any?
                  %ul.list-unstyled.mb-0
                    - @widget.domains.each do |domain|
                      %li
                        %code= domain
                - else
                  %span.text-muted —

              %dt.text-muted.small Site Key
              %dd.mb-3.font-monospace.text-break= @widget.sitekey

              %dt.text-muted.small Secret Key
              %dd.mb-0
                .input-group
                  %input.form-control.font-monospace{ type: "password", value: @widget.secret, readonly: true, id: "turnstile-secret" }
                  %button.btn.btn-outline-secondary{ type: "button",
                      data: { action: "click->clipboard#toggle", clipboard_target: "turnstile-secret" },
                      onclick: "const f=document.getElementById('turnstile-secret');f.type=f.type==='password'?'text':'password';" } Show

      .col-lg-5
        %p.text-muted.small.mb-2
          Domain:
          %strong= Current.tenant.custom_domain
        = render "widget_status", widget: @widget
