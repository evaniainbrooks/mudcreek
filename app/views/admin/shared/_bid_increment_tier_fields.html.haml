.d-flex.align-items-center.gap-2.mb-2
  .input-group.input-group-sm
    .input-group-text $
    = tier_form.number_field :min_amount_cents,
        class: "form-control form-control-sm",
        placeholder: "Min amount (cents)",
        min: 0,
        step: 1,
        title: "Minimum bid amount in cents (e.g. 10000 = $100)"
  .input-group.input-group-sm
    .input-group-text $
    = tier_form.number_field :increment_cents,
        class: "form-control form-control-sm",
        placeholder: "Increment (cents)",
        min: 1,
        step: 1,
        title: "Bid increment in cents (e.g. 500 = $5)"
  .form-check.ms-1
    = tier_form.check_box :_destroy, class: "form-check-input"
    = tier_form.label :_destroy, "Remove", class: "form-check-label small text-danger"
