.d-flex.align-items-center.gap-2.mb-2
  = account_form.select :platform,
      SocialMediaAccount.platforms.keys.map { |p| [p.humanize, p] },
      { include_blank: "— Platform —" },
      class: "form-select form-select-sm",
      style: "width: 160px; flex-shrink: 0",
      data: { action: "change->social-media-account#fillIcon" }
  .input-group.input-group-sm
    %span.input-group-text @
    = account_form.text_field :slug,
        class: "form-control form-control-sm",
        placeholder: "username"
  .input-group.input-group-sm{ style: "width: 180px; flex-shrink: 0" }
    %span.input-group-text
      %i{ class: account_form.object.icon.presence || "bi-share" }
    = account_form.text_field :icon,
        class: "form-control form-control-sm",
        placeholder: "bi-facebook",
        data: { "social-media-account-target": "iconField" }
  .form-check.ms-1
    = account_form.check_box :_destroy, class: "form-check-input"
    = account_form.label :_destroy, "Remove", class: "form-check-label small text-danger"
