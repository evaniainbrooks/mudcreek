- content_for :body_class, "ledger-body"

.ledger-shell
  .ledger-name= "Ledger"
  %h1.ledger-title= @ledger.name

  - if @entry.errors.any?
    .alert-entry= @entry.errors.full_messages.to_sentence

  = form_with url: ledger_entries_path(@ledger), scope: :ledger_entry, multipart: true,
      data: { controller: "ledger-entry" } do |f|
    - is_credit = @entry.entry_type != "debit"

    .type-toggle
      %input.btn-check{type: "radio", name: "ledger_entry[entry_type]", id: "type_credit",
          value: "credit", autocomplete: "off", checked: is_credit,
          data: { action: "change->ledger-entry#syncSubmit" }}
      %label.toggle-btn.toggle-btn-credit{ for: "type_credit" }
        ↑ Credit

      %input.btn-check{type: "radio", name: "ledger_entry[entry_type]", id: "type_debit",
          value: "debit", autocomplete: "off", checked: !is_credit,
          data: { action: "change->ledger-entry#syncSubmit" }}
      %label.toggle-btn.toggle-btn-debit{ for: "type_debit" }
        ↓ Debit

    .field-group
      %label.field-label{ for: "ledger_entry_description" } Description
      %input.field-input{type: "text", name: "ledger_entry[description]", id: "ledger_entry_description",
          value: @entry.description, placeholder: "What was this for?",
          autocomplete: "off", class: @entry.errors[:description].any? ? "is-invalid" : "",
          required: true}
      - if @entry.errors[:description].any?
        .error-msg= @entry.errors[:description].to_sentence

    .field-group
      %label.field-label{ for: "ledger_entry_amount" } Amount
      .amount-wrap
        %span.amount-symbol $
        %input.field-input.amount-input{type: "number", name: "ledger_entry[amount]", id: "ledger_entry_amount",
            value: @entry.amount, placeholder: "0.00", step: "0.01", min: "0.01",
            class: @entry.errors[:amount].any? ? "is-invalid" : "",
            inputmode: "decimal"}
      - if @entry.errors[:amount].any?
        .error-msg= @entry.errors[:amount].to_sentence

    %label.tax-row{ for: "ledger_entry_taxed" }
      %input.tax-check{type: "checkbox", name: "ledger_entry[taxed]", id: "ledger_entry_taxed",
          value: "1", checked: @entry.taxed?}
      .tax-label-wrap
        %span.tax-label-main Amount includes tax
        %span.tax-label-hint
          = number_to_percentage(@ledger.tax_rate * 100, precision: 4, strip_insignificant_zeros: true)
          tax will be backed out

    %input#ledger-entry-receipt{type: "file", name: "ledger_entry[receipt]",
        accept: "image/*", capture: "environment", style: "display:none",
        data: { action: "change->ledger-entry#receiptChanged" }}
    %label.receipt-btn{for: "ledger-entry-receipt",
        data: { ledger_entry_target: "receiptBtn" }}
      %i.bi.bi-camera
      %span{ data: { ledger_entry_target: "receiptLabel" }} Add Receipt Photo

    %button.submit-btn{type: "submit",
        class: is_credit ? "submit-credit" : "submit-debit",
        data: { ledger_entry_target: "submitBtn" }}
      Add Entry
