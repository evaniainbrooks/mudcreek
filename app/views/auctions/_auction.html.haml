- registration = local_assigns[:registrations_by_auction_id]&.fetch(auction.id, nil)
.col
  .card.h-100.shadow-sm.border.border-secondary-subtle
    .position-relative
      = link_to auction_path(auction) do
        - if auction.poster.attached?
          .card-img-top.bg-secondary-subtle{ style: "height: 200px; background-image: url('#{optimized_image_url(auction.poster, preset: :card)}'); background-size: contain; background-position: center; background-repeat: no-repeat" }
        - elsif Current.tenant.auction_placeholder.attached?
          .card-img-top.bg-secondary-subtle{ style: "height: 200px; background-image: url('#{optimized_image_url(Current.tenant.auction_placeholder, preset: :card)}'); background-size: contain; background-position: center; background-repeat: no-repeat" }
        - else
          .card-img-top.d-flex.align-items-center.justify-content-center.bg-secondary-subtle{ style: "height: 200px" }
            %i.bi.bi-hammer.text-secondary{ style: "font-size: 3rem" }
      - if auction.ended?
        .position-absolute.top-0.start-0.p-2
          %span.badge.text-bg-secondary Ended
      - elsif auction.started?
        .position-absolute.top-0.start-0.p-2
          %span.badge.text-bg-success Live
      - elsif auction.starts_at
        .position-absolute.top-0.start-0.p-2
          %span.badge.text-bg-info Upcoming
    .card-body.d-flex.flex-column
      %h5.card-title.fw-semibold.mb-2
        = link_to auction.name, auction_path(auction), class: "text-decoration-none text-body"
      - if auction.starts_at
        - if auction.started? && !auction.ended?
          .d-flex.align-items-center.gap-2.text-success.small.mb-1
            %i.bi.bi-check-circle-fill.flex-shrink-0
            %strong Auction has started!
        .d-flex.align-items-center.gap-2.text-muted.small.mb-1
          %i.bi.bi-calendar-event.flex-shrink-0
          %span= auction.starts_at_in_time_zone.to_fs(:long)
      - if auction.ends_at
        .d-flex.align-items-center.gap-2.text-muted.small.mb-1
          %i.bi.bi-calendar-check.flex-shrink-0
          %span= auction.ends_at_in_time_zone.to_fs(:long)
      - if auction.address&.any?
        .d-flex.align-items-center.gap-2.text-muted.small.mb-1
          %i.bi.bi-geo-alt.flex-shrink-0
          %span= auction.address.to_fs(:short)
      .mt-auto.pt-3
        - if registration&.pending?
          .d-flex.align-items-center.gap-2
            %span.badge.text-bg-warning.py-2.px-3 Registration Pending
        - elsif registration&.approved?
          .d-flex.align-items-center.gap-2
            %span.badge.text-bg-success.py-2.px-3 Registered
        - elsif registration&.rejected?
          .d-flex.align-items-center.gap-2
            %span.badge.text-bg-danger.py-2.px-3 Registration Declined
        - elsif !auction.reconciled? && !auction.ended?
          - if Current.user
            %button.btn.btn-primary.w-100{ type: "button", data: { bs_toggle: "modal", bs_target: "#auction-register-modal-#{auction.hashid}" } }
              %i.bi.bi-person-plus.me-2
              Register Now
            = render "auctions/register_modal", auction: auction, modal_id: "auction-register-modal-#{auction.hashid}"
          - else
            = link_to new_session_path(return_to: auction_path(auction)), class: "btn btn-primary w-100" do
              %i.bi.bi-person-plus.me-2
              Sign In to Register
