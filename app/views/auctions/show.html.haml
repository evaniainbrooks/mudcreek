:ruby
  description = @auction.description.to_plain_text.truncate(200)
  og_image = @auction.poster.attached? ? url_for(@auction.poster) : nil
  set_meta_tags title: @auction.name,
    description: description,
    og: { title: @auction.name, description: description, image: og_image },
    twitter: { card: (og_image ? "summary_large_image" : "summary"), title: @auction.name, description: description, image: og_image }

.d-flex.align-items-center.justify-content-between.mb-4
  = link_to auctions_path, class: "btn btn-outline-secondary btn-sm" do
    %i.bi.bi-arrow-left.me-1
    Back to all auctions
  .d-flex.gap-2
    - if Current.user&.role&.permissions&.any?
      = link_to admin_auction_path(@auction), class: "btn btn-outline-secondary btn-sm" do
        %i.bi.bi-gear.me-1
        Admin View
    %button.btn.btn-outline-secondary.btn-sm{ type: "button", data: { "bs-toggle": "modal", "bs-target": "#share-modal" } }
      %i.bi.bi-share.me-1
      Share

.page-container.overflow-hidden
  .row.g-0.align-items-stretch{ style: "min-height: 70vh" }
    = render "left_column", auction: @auction, registration: @registration, auction_listing_count: @auction_listing_count, filter: @filter
    .col-lg-8.bg-body.p-4.p-lg-5{ data: { registration_status: registration_status(@registration), current_user_token: user_bid_token(Current.user) } }
      - unless @filter
        = form_with url: auction_path(@auction), method: :get, html: { class: "d-flex flex-nowrap gap-2 align-items-center mb-1" } do |f|
          .input-group.input-group-sm.flex-shrink-1{ style: "min-width: 0" }
            = f.search_field :search, value: @search, placeholder: "Search listings…", class: "form-control form-control-sm"
            - if @search
              = link_to(auction_path(@auction, state: @listing_state, category_id: @category_hashid),
                class: "btn btn-outline-secondary btn-sm",
                aria: { label: "Clear search" }) do
                %i.bi.bi-x-lg
          = f.select :category_id, @categories.map { [it.name, it.hashid] },
            { include_blank: "All Categories", selected: @category_hashid },
            class: "form-select form-select-sm w-auto flex-shrink-0",
            onchange: "this.form.requestSubmit()"
          = f.select :state, [["On Sale", "on_sale"], ["Sold", "sold"], ["Cancelled", "cancelled"]],
            { include_blank: "All", selected: @listing_state },
            class: "form-select form-select-sm w-auto flex-shrink-0",
            onchange: "this.form.requestSubmit()"
      = turbo_stream_from @auction
      = render FilterInfoComponent.new(count: @filter_count, total: @auction_listing_count, label: "listings", clear_url: auction_path(@auction))
      - if @auction_listings.any?
        .row.row-cols-1.row-cols-sm-2.row-cols-xl-3.g-4
          = render(partial: "auctions/listing_card",
            collection: @auction_listings,
            as: :auction_listing,
            locals: { auction: @auction, registration: @registration, proxy_bids_by_listing_id: @proxy_bids_by_listing_id })
      - else
        .py-5.text-center.text-muted
          %i.bi.bi-tag.mb-3.d-block{ style: "font-size: 3rem" }
          %p.mb-0 No listings found.

- if Current.user && !@registration
  = render "register_modal", auction: @auction
- if @auction.address&.any?
  = render "shared/map_modal", address: @auction.address
= render "shared/share_modal", url: auction_url(@auction), title: @auction.name
