- listing = auction_listing.listing
.col{ id: dom_id(auction_listing) }
  .card.h-100.shadow-sm.border.border-secondary-subtle
    .position-relative
      = link_to auction_auction_listing_path(auction, auction_listing) do
        - if listing.show_video_as_poster && listing.videos.attached?
          %video.card-img-top.w-100.bg-secondary-subtle{ style: "height: 200px; object-fit: contain", muted: true, playsinline: true, preload: "metadata" }
            %source{ src: url_for(listing.videos.first) }
        - elsif listing.images.attached?
          .card-img-top.bg-secondary-subtle{ style: "height: 200px; background-image: url('#{optimized_image_url(listing.images.first, preset: :card)}'); background-size: contain; background-position: center; background-repeat: no-repeat" }
        - elsif listing.videos.attached?
          %video.card-img-top.w-100.bg-secondary-subtle{ style: "height: 200px; object-fit: contain", muted: true, playsinline: true, preload: "metadata" }
            %source{ src: url_for(listing.videos.first) }
        - elsif listing.lot&.listing_placeholder&.attached?
          .card-img-top.bg-secondary-subtle{ style: "height: 200px; background-image: url('#{optimized_image_url(listing.lot.listing_placeholder, preset: :card)}'); background-size: contain; background-position: center; background-repeat: no-repeat" }
        - elsif Current.tenant.listing_placeholder.attached?
          .card-img-top.bg-secondary-subtle{ style: "height: 200px; background-image: url('#{optimized_image_url(Current.tenant.listing_placeholder, preset: :card)}'); background-size: contain; background-position: center; background-repeat: no-repeat" }
        - else
          .card-img-top.d-flex.align-items-center.justify-content-center.bg-secondary-subtle{ style: "height: 200px" }
            %i.bi.bi-image.text-secondary{ style: "font-size: 3rem" }
      - if listing.sold? || listing.cancelled?
        .position-absolute.top-0.start-0.p-2
          = listing_state_badge(listing)
      - elsif auction_listing.ends_at && auction_listing.ends_at > Time.current && auction_listing.ends_at < 10.minutes.from_now
        .position-absolute.top-0.start-0.p-2
          %span.badge.text-bg-warning{data: { controller: "countdown",
            "countdown-ends-at-value": auction_listing.ends_at.iso8601,
            "countdown-badge-value": true }}
            %span{ data: { "countdown-target": "display" } } Ending Soon!
      - unless auction_listing.reserve_price_cents.present? || listing.sold? || listing.cancelled?
        .position-absolute.top-0.end-0.p-2
          %span.badge.text-bg-success No Reserve
      - if listing.lot&.show_attribution?
        .position-absolute.bottom-0.start-0.p-2
          = lot_number_badge(listing.lot)
    .card-body
      %h5.card-title.fw-semibold.mb-1
        = link_to listing.name,
          auction_auction_listing_path(auction, auction_listing),
          class: "text-decoration-none text-body"
      - if auction_listing.ends_at.present?
        .d-flex.align-items-center.gap-2.mb-0.text-muted.small
          %i.bi.bi-calendar-check.flex-shrink-0
          %span= auction_listing.ends_at_in_time_zone.to_fs(:long)
      .mt-3
        .d-flex.align-items-center.justify-content-between.mb-2
          = render("auction_listings/current_bid", auction_listing:)
          = render("auction_listings/bid_count", auction_listing:)
        = render BidButtonComponent.new(auction_listing: auction_listing,
          auction: auction,
          registration: registration,
          bidder_token: user_bid_token(auction_listing.highest_bidder_id),
          button_class: "btn btn-primary btn-sm w-100")
      %p.card-text.text-muted.small.mt-3
        = listing.description.to_plain_text.truncate(120)
        - if listing.categories.any?
          %br
          = listing_categories_badges(listing, css: "text-bg-dark")
