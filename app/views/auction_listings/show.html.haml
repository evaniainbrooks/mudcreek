:ruby
  description = @listing.description.to_plain_text.truncate(200)
  og_image = @listing.images.attached? ? url_for(@listing.images.first) : nil
  set_meta_tags title: @listing.name,
    description: description,
    og: { title: @listing.name, description: description, image: og_image },
    twitter: { card: (og_image ? "summary_large_image" : "summary"), title: @listing.name, description: description, image: og_image }

  has_images = @listing.images.attached?
  has_videos = @listing.videos.attached?
  media_count = @listing.images.size + @listing.videos.size

= turbo_stream_from @auction_listing
.d-flex.justify-content-between.align-items-center.mb-4
  = link_to auction_path(@auction), class: "btn btn-outline-secondary btn-sm" do
    %i.bi.bi-arrow-left.me-1
    Back to auction
  - if @next_auction_listing
    = link_to auction_auction_listing_path(@auction, @next_auction_listing), class: "btn btn-outline-secondary btn-sm" do
      Next listing
      %i.bi.bi-arrow-right.ms-1

.row.g-4.g-lg-5.align-items-start
  .col-lg-7
    .position-relative
      - if has_images || has_videos
        = render "listings/carousel", listing: @listing, media_count:
      - elsif @listing.lot&.listing_placeholder&.attached?
        = image_tag @listing.lot.listing_placeholder, class: "d-block w-100 rounded-3 object-fit-cover", style: "height: 480px"
      - else
        .rounded-3.bg-light.d-flex.align-items-center.justify-content-center{ style: "height: 480px" }
          %i.bi.bi-image.text-muted{ style: "font-size: 5rem" }
      - unless @auction_listing.reserve_price_cents.present? || @listing.sold?
        .position-absolute.top-0.end-0.p-2
          %span.badge.text-bg-success No Reserve
  .col-lg-5{ data: { registration_status: @registration&.state || "none", current_user_token: user_bid_token(Current.user) } }
    .position-sticky{ style: "top: 1.5rem" }
      %h1.fw-bold.mb-1= @listing.name

      .mb-3
        %p.text-muted.small.mb-0 Auction
        = link_to @auction.name, auction_path(@auction), class: "fw-semibold text-decoration-none"

      - if @auction.starts_at&.future?
        .mb-3{ data: { controller: "countdown", "countdown-ends-at-value": @auction.starts_at.iso8601, "countdown-reload-value": true } }
          %p.text-muted.small.mb-0 Auction starts in
          %strong{ data: { "countdown-target": "display" } }

      %hr.mb-4
      = render "auction_listings/bid_panel",
        auction_listing: @auction_listing,
        auction: @auction,
        registration: @registration,
        bidder_token: @highest_bidder_token
      %hr.mb-4
      .listing-description
        = @listing.description
      - if @listing.categories.any?
        .mt-3= listing_categories_badges(@listing, css: "text-bg-dark")

= render("listings/properties", listing: @listing)
= render("listings/documents", listing: @listing)
