- set_listing_meta_tags(@listing)
- has_images  = @listing.images.attached?
- has_videos  = @listing.videos.attached?
- media_count = @listing.images.size + @listing.videos.size

= turbo_stream_from @auction_listing
.d-flex.justify-content-between.align-items-center.mb-4
  = link_to auction_path(@auction), class: "btn btn-outline-secondary btn-sm" do
    %i.bi.bi-arrow-left.me-1
    Back to auction
  .d-flex.gap-2
    - if @next_auction_listing
      = link_to auction_auction_listing_path(@auction, @next_auction_listing),
          class: "btn btn-outline-secondary btn-sm" do
        Next listing
        %i.bi.bi-arrow-right.ms-1
    - if Current.user && Current.tenant.features.watchlist?
      = render "shared/watchlist_button", listing: @listing, watchlist_item: @watchlist_item
    %button.btn.btn-outline-secondary.btn-sm{type: "button",
        data: { "bs-toggle": "modal", "bs-target": "#share-modal" }}
      %i.bi.bi-share.me-1
      Share

.page-container.p-4
  .row.g-4.g-lg-5.align-items-start
    .col-lg-7
      .position-relative
        - if has_images || has_videos
          = render "listings/carousel", listing: @listing, media_count:
        - elsif @listing.lot&.listing_placeholder&.attached?
          = image_tag @listing.lot.listing_placeholder,
            class: "d-block w-100 rounded-3 object-fit-cover",
            style: "height: 480px"
        - else
          .rounded-3.bg-light.d-flex.align-items-center.justify-content-center{ style: "height: 480px" }
            %i.bi.bi-image.text-muted{ style: "font-size: 5rem" }
        - unless @auction_listing.reserve_price_cents.present? || @listing.sold?
          .position-absolute.top-0.end-0.p-2
            %span.badge.text-bg-success No Reserve
        - if @listing.lot&.show_attribution?
          .position-absolute.bottom-0.start-0.p-2
            = lot_number_badge(@listing.lot)
    .col-lg-5{data: { registration_status: registration_status(@registration),
        current_user_token: user_bid_token(Current.user) }}
      .position-sticky{ style: "top: 1.5rem" }
        %h1.fw-bold.mb-1= @listing.name

        .mb-3
          %p.text-muted.small.mb-0 Auction
          = link_to @auction.name, auction_path(@auction), class: "fw-semibold text-decoration-none"

        - if @auction.starts_at&.future?
          .mb-3{data: { controller: "countdown",
              "countdown-ends-at-value": @auction.starts_at.iso8601,
              "countdown-reload-value": true }}
            %p.text-muted.small.mb-0 Auction starts in
            %strong{ data: { "countdown-target": "display" } }

        %hr.mb-4
        = render "auction_listings/bid_panel",
          auction_listing: @auction_listing,
          auction: @auction,
          registration: @registration,
          bidder_token: @highest_bidder_token,
          proxy_bid: @proxy_bid
        %hr.mb-4
        %p.text-muted.small.mb-0 Description
        .listing-description.mb-3
          = @listing.description
        - if @listing.categories.any?
          %p.text-muted.small.mb-0 Categories
          = listing_categories_badges(@listing, css: "text-bg-dark")
        - if (addr = @listing.effective_address)&.any?
          .mt-3
            %button.btn.btn-link.p-0.text-muted.text-decoration-underline{ type: "button", data: { "bs-toggle": "modal", "bs-target": "#map-modal" } }
              %i.bi.bi-geo-alt.me-1
              = addr.to_fs(:short)
        - if (lot = @listing.lot)&.show_attribution?
          - other_count = lot.listings.where(published: true).where.not(id: @listing.id).count
          %hr.mt-4.mb-3
          = link_to auction_path(@auction, lot_id: lot.hashid),
              class: "d-flex align-items-center gap-3 text-decoration-none text-body p-2 rounded-3 lot-attribution-btn" do
            .rounded-circle.bg-secondary-subtle.d-flex.align-items-center.justify-content-center.flex-shrink-0{ style: "width: 48px; height: 48px" }
              %i.bi.bi-person-fill.text-secondary{ style: "font-size: 1.5rem" }
            .flex-grow-1
              .fw-semibold= lot.name
              .text-muted.small= lot.owner.name
            .d-flex.align-items-center.gap-1.flex-shrink-0
              - if other_count > 0
                %span.small.text-muted See #{other_count} other #{"item".pluralize(other_count)} from this seller
              %i.bi.bi-chevron-right.text-muted

  = render("listings/properties", listing: @listing)
  = render("listings/documents", listing: @listing)

- if (addr = @listing.effective_address)&.any?
  = render "shared/map_modal", address: addr
= render "shared/share_modal", url: auction_auction_listing_url(@auction, @auction_listing), title: @listing.name
