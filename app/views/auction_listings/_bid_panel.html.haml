%div{ id: dom_id(auction_listing, :bid_panel) }
  - bid_count = auction_listing.bids_count || 0
  .d-flex.align-items-center.gap-2.mb-3
    - if bid_count == 0
      %p.text-muted.fw-bold.mb-0 No bids
    - else
      %p.text-muted.fw-bold.mb-0
        = "#{bid_count} #{bid_count == 1 ? 'bid' : 'bids'}"
  = render BidButtonComponent.new(auction_listing: auction_listing, auction: auction, registration: registration, bidder_token: bidder_token, button_class: "btn btn-primary w-100 mb-4")
