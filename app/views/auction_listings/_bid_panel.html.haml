%div{ id: dom_id(auction_listing, :bid_panel) }
  .d-flex.flex-row.align-items-center.gap-2.mt-3
    = render("auction_listings/current_bid", auction_listing:)
    = render("auction_listings/bid_count", auction_listing:)
  = render BidButtonComponent.new(auction_listing: auction_listing,
    auction: auction,
    registration: registration,
    bidder_token: bidder_token,
    button_class: "btn btn-primary w-100 mb-4")
