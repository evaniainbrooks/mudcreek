- set_page_meta_tags(@page)

- if @page.hero_image.attached?
  = optimized_image_tag @page.hero_image, preset: :hero,
      class: "img-fluid w-100 rounded-3 mb-4",
      style: "object-fit: cover; max-height: 400px"

.page-container.p-4
  %h1.fw-bold.mb-4
    - if @page.icon.present?
      %i{ class: "bi #{@page.icon} me-2" }
    = @page.title

  - left  = @page.left_column_image.attached?
  - right = @page.right_column_image.attached?

  - if left || right
    .row.g-4
      - if left
        .col-4
          = optimized_image_tag @page.left_column_image, preset: :column, class: "img-fluid rounded w-100"
      %div{ class: page_body_col_class(@page) }
        .page-body= @page.body
      - if right
        .col-4
          = optimized_image_tag @page.right_column_image, preset: :column, class: "img-fluid rounded w-100"
  - else
    .page-body= @page.body

  - @widgets.each do |widget|
    %hr.mt-5.mb-4
    = render "widgets/#{widget.class.name.underscore}", widget: widget

  - if @children.any?
    %nav.mt-5
      .nav.nav-tabs{ role: "tablist" }
        - @children.each do |child|
          - active = child == @active_child
          %a.nav-link{href: page_path(@page.slug, tab: child.slug),
                       class: ("active" if active),
                       "aria-current": ("page" if active)}
            - if child.icon.present?
              %i{ class: "bi #{child.icon} me-1" }
            = child.title

    .tab-content.border.border-top-0.rounded-bottom.p-4.mb-4
      - if @active_child
        - if @active_child.left_column_image.attached? || @active_child.right_column_image.attached?
          .row.g-4
            - if @active_child.left_column_image.attached?
              .col-4
                = optimized_image_tag @active_child.left_column_image, preset: :column, class: "img-fluid rounded w-100"
            %div{ class: page_body_col_class(@active_child) }
              .page-body= @active_child.body
            - if @active_child.right_column_image.attached?
              .col-4
                = optimized_image_tag @active_child.right_column_image, preset: :column, class: "img-fluid rounded w-100"
        - else
          .page-body= @active_child.body
        - @child_widgets.each do |widget|
          %hr.mt-5.mb-4
          = render "widgets/#{widget.class.name.underscore}", widget: widget
