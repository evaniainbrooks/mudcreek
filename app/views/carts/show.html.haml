- set_meta_tags title: "My Cart"

%h1.fw-bold.mb-4 My Cart

.page-container.px-0.py-2.p-lg-4
  - if @cart_items.empty?
    = render EmptyStateComponent.new(icon: "cart-x",
        message: "Your cart is empty.",
        link_text: "Browse Listings",
        link_url: listings_path)
  - else
    .row.gx-0.gy-2.g-lg-4.align-items-start
      .col-12.col-lg-7.order-2.order-lg-2
        = render "carts/items",
            cart_items: @cart_items,
            cart_summary: @cart_summary,
            discount_code: @discount_code,
            delivery_method: @delivery_method,
            has_physical_items: @has_physical_items,
            cart_address_saved: @cart_address_saved,
            guest_info_saved: @guest_info_saved
      .col-12.col-lg-5.order-1.order-lg-1
        - unless Current.user
          = render "carts/guest_info",
              guest_info_saved: @guest_info_saved,
              guest_name: @guest_name,
              guest_email: @guest_email
        = render "carts/discount_code",
            discount_code: @discount_code
        = render "carts/delivery_method",
            has_physical_items: @has_physical_items,
            delivery_method: @delivery_method
        - if @delivery_method&.address_required?
          = render "carts/delivery_address",
              cart_address: @cart_address,
              cart_address_saved: @cart_address_saved
